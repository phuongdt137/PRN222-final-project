@model HighSchoolManagementSystem.MVC.Models.ViewModels.Principal.PrincipalDashboardViewModel
@{
    ViewData["Title"] = "Bảng Điều Hành - Hiệu Trưởng";
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Thầy/Cô Hiệu Trưởng";
}

<!-- Greeting Banner -->
<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> TRANG CHỦ HIỆU TRƯỞNG
        </span>
        <h1 class="greeting-title">Xin chào, @displayName</h1>
        <p class="greeting-subtitle">
            Hệ thống giám sát tổng quan tình hình đào tạo, chuyên cần, nề nếp kỷ luật và đội ngũ nhân sự toàn trường.
            @if (!string.IsNullOrEmpty(Model.CurrentSemesterName))
            {
                <span class="badge bg-white text-primary border ms-2">@Model.CurrentSemesterName - Năm học @Model.CurrentYearCode</span>
            }
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-action="AcademicReview" class="btn btn-primary btn-sm shadow-sm">
            <i class="bi bi-patch-check-fill me-1"></i>Rà soát & Chốt sổ
        </a>
        <a asp-action="AcademicReports" class="btn btn-secondary btn-sm shadow-sm">
            <i class="bi bi-bar-chart-line-fill me-1"></i>Báo cáo học tập
        </a>
        <div class="live-clock-card d-none d-md-flex">
            <div class="clock-info text-end">
                <div class="clock-date" id="liveClockDate">Đang đồng bộ...</div>
                <div class="clock-time" id="liveClockTime">--:--:--</div>
            </div>
            <div class="clock-icon-box">
                <i class="bi bi-clock"></i>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

<!-- Section 1: KPI & Chỉ số hoạt động -->
<div class="dashboard-section-header">
    <div class="section-title-wrap">
        <h2>Chỉ số hoạt động & Thống kê toàn trường</h2>
        <p>Dữ liệu thời gian thực được đồng bộ trực tiếp từ hệ thống quản lý học sinh, đào tạo và nhân sự.</p>
    </div>
    <div class="section-right-meta">
        <i class="bi bi-arrow-repeat me-1"></i>Dữ liệu trực tiếp từ cơ sở dữ liệu
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Card 1: Tổng học sinh -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-blue">
                <i class="bi bi-people-fill"></i>
            </span>
            <div class="stat-kicker">QUY MÔ NHÀ TRƯỜNG</div>
            <div class="stat-title">Tổng số học sinh</div>
            <div class="stat-main">
                <div class="stat-number">@Model.TotalStudents.ToString("N0")</div>
                <div class="stat-label">Học sinh đang theo học chính quy</div>
            </div>
            <div class="stat-breakdown-bar">
                @if (Model.StudentsByGrade.Any())
                {
                    @foreach (var item in Model.StudentsByGrade)
                    {
                        <div class="breakdown-pill pill-blue">@item.Key: @item.Value</div>
                    }
                }
                else
                {
                    <div class="breakdown-pill pill-blue">Đang cập nhật lớp học</div>
                }
            </div>
        </div>
    </div>

    <!-- Card 2: Chuyên cần hôm nay -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-green">
                <i class="bi bi-calendar2-check-fill"></i>
            </span>
            <div class="stat-kicker">CHUYÊN CẦN HÔM NAY</div>
            <div class="stat-title">Tỷ lệ hiện diện toàn trường</div>
            <div class="stat-main">
                <div class="stat-number">@Model.TodayAttendanceRate.ToString("0.0")%</div>
                <div class="stat-label">@Model.TodayPresentCount / @Model.TodayTotalAttendanceRecords học sinh có mặt</div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-green">Có mặt: @Model.TodayPresentCount</div>
                <div class="breakdown-pill pill-yellow">Có phép: @Model.TodayExcusedCount</div>
                <div class="breakdown-pill pill-red">K.phép: @Model.TodayUnexcusedCount</div>
            </div>
        </div>
    </div>

    <!-- Card 3: Đội ngũ cán bộ -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-orange">
                <i class="bi bi-person-workspace"></i>
            </span>
            <div class="stat-kicker">ĐỘI NGŨ SƯ PHẠM</div>
            <div class="stat-title">Cán bộ & Giáo viên</div>
            <div class="stat-main">
                <div class="stat-number">@Model.TotalTeachers</div>
                <div class="stat-label">Giáo viên thuộc biên chế nhà trường</div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-green">Đang công tác: @Model.ActiveTeachers</div>
                <div class="breakdown-pill pill-blue">Tài khoản: @Model.TotalTeachers</div>
            </div>
        </div>
    </div>

    <!-- Card 4: Lớp học vận hành -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-purple">
                <i class="bi bi-building-check"></i>
            </span>
            <div class="stat-kicker">LỚP HỌC & CƠ SỞ VẬT CHẤT</div>
            <div class="stat-title">Lớp học đang vận hành</div>
            <div class="stat-main">
                <div class="stat-number">@Model.TotalClasses lớp</div>
                <div class="stat-label">@Model.TotalRooms phòng học đang hoạt động</div>
            </div>
            <div class="stat-breakdown-bar">
                @if (Model.ClassesByGrade.Any())
                {
                    @foreach (var item in Model.ClassesByGrade)
                    {
                        <div class="breakdown-pill pill-blue">@item.Key: @item.Value lớp</div>
                    }
                }
                else
                {
                    <div class="breakdown-pill pill-blue">Chưa có lớp học</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Section 2: Bảng dữ liệu tác vụ -->
<!-- Table 1: Tình hình chuyên cần theo khối -->
<div class="card-table-wrap mb-4">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Tình hình chuyên cần theo khối học hôm nay</h2>
            <p class="table-card-subtitle">Thống kê tự động từ dữ liệu điểm danh và danh sách lớp học của các khối.</p>
        </div>
        <a asp-action="AttendanceReports" class="btn btn-secondary btn-sm">
            <i class="bi bi-calendar-range me-1"></i>Xem báo cáo chi tiết
        </a>
    </div>
    <div class="table-responsive">
        <table class="table-edu mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;" class="text-center">STT</th>
                    <th>Khối Lớp</th>
                    <th class="text-center">Tổng Sĩ Số</th>
                    <th class="text-center">Hiện Diện</th>
                    <th class="text-center">Vắng Có Phép</th>
                    <th class="text-center">Vắng Không Phép</th>
                    <th class="text-center">Tỷ Lệ Chuyên Cần</th>
                    <th class="text-center">Đánh Giá</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AttendanceByGrade.Any())
                {
                    int idx = 1;
                    @foreach (var g in Model.AttendanceByGrade)
                    {
                        string statusLabel = g.AttendanceRate >= 98m ? "Đạt chuẩn xuất sắc" : g.AttendanceRate >= 95m ? "Đạt chuẩn tốt" : "Cần lưu ý";
                        string statusCss = g.AttendanceRate >= 98m ? "badge-status-success" : g.AttendanceRate >= 95m ? "badge-status-info" : "badge-status-warning";
                        <tr>
                            <td class="text-center">@idx</td>
                            <td><strong>@g.GradeName</strong></td>
                            <td class="text-center">@g.TotalStudents</td>
                            <td class="text-center fw-bold text-success">@g.PresentCount</td>
                            <td class="text-center text-warning fw-semibold">@g.ExcusedCount</td>
                            <td class="text-center text-danger fw-semibold">@g.UnexcusedCount</td>
                            <td class="text-center"><span class="fw-bold">@g.AttendanceRate.ToString("0.0")%</span></td>
                            <td class="text-center">
                                <span class="badge-status @statusCss">@statusLabel</span>
                            </td>
                        </tr>
                        idx++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Chưa có dữ liệu chuyên cần cho ngày hôm nay.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Table 2: Báo cáo nề nếp & Kỷ luật mới nhất -->
<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Báo cáo nề nếp & Đánh giá hạnh kiểm mới nhất</h2>
            <p class="table-card-subtitle">Các ghi nhận và đánh giá từ giáo viên chủ nhiệm toàn trường.</p>
        </div>
        <a asp-controller="ConductEvaluation" asp-action="PrincipalSummary" class="btn btn-secondary btn-sm">
            <i class="bi bi-shield-check me-1"></i>Tổng quan nề nếp toàn trường
        </a>
    </div>
    <div class="table-responsive">
        <table class="table-edu mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;" class="text-center">STT</th>
                    <th>Thời Gian</th>
                    <th>Học Sinh</th>
                    <th>Lớp</th>
                    <th class="text-center">Xếp Loại</th>
                    <th>Nhận Xét / Lời Phê</th>
                    <th>GVCN Đánh Giá</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentConductEvents.Any())
                {
                    int idx = 1;
                    @foreach (var ev in Model.RecentConductEvents)
                    {
                        string badgeClass = ev.ConductGrade switch
                        {
                            "Tốt" => "badge-status-success",
                            "Khá" => "badge-status-info",
                            "Đạt" => "badge-status-warning",
                            _ => "badge-status-danger"
                        };
                        <tr>
                            <td class="text-center">@idx</td>
                            <td>@ev.EvaluatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@ev.StudentName</strong> <span class="text-muted">(@ev.StudentCode)</span></td>
                            <td>@ev.ClassName</td>
                            <td class="text-center">
                                <span class="badge-status @badgeClass">@ev.ConductGrade</span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(ev.TeacherComment) ? "Không có ghi chú thêm" : ev.TeacherComment)</td>
                            <td>@ev.TeacherName</td>
                        </tr>
                        idx++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Chưa có đánh giá hạnh kiểm nào gần đây.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Bảng Nhật ký điều chỉnh điểm số sau khóa (Giám sát của Hiệu trưởng) -->
<div class="table-card mb-4">
    <div class="table-card-header">
        <div>
            <h3 class="table-card-title d-flex align-items-center gap-2">
                <i class="bi bi-shield-exclamation text-danger"></i>
                Nhật Ký Điều Chỉnh Điểm Số Sau Khóa (Audit Log)
            </h3>
            <p class="table-card-subtitle">Giám sát các lần can thiệp, phúc khảo hoặc điều chỉnh điểm số của Giáo vụ sau khi bài kiểm tra đã tự động khóa.</p>
        </div>
        <a asp-controller="Principal" asp-action="AcademicReview" class="btn btn-secondary btn-sm">
            <i class="bi bi-patch-check me-1"></i>Rà soát điểm toàn trường
        </a>
    </div>
    <div class="table-responsive">
        <table class="table-edu mb-0">
            <thead>
                <tr>
                    <th style="width: 60px;" class="text-center">STT</th>
                    <th>Thời Gian</th>
                    <th>Học Sinh</th>
                    <th>Lớp</th>
                    <th>Môn & Bài Thi</th>
                    <th class="text-center">Biến Động Điểm</th>
                    <th>Người Thực Hiện</th>
                    <th>Lý Do Điều Chỉnh</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentScoreModifications.Any())
                {
                    int sIdx = 1;
                    @foreach (var sc in Model.RecentScoreModifications)
                    {
                        decimal diff = (sc.NewScore ?? 0) - (sc.OldScore ?? 0);
                        bool isSignificant = Math.Abs(diff) >= 2.0m;
                        <tr>
                            <td class="text-center">@sIdx</td>
                            <td>@sc.ModifiedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@sc.StudentName</strong> <span class="text-muted small">(@sc.StudentCode)</span></td>
                            <td><span class="badge bg-light text-dark border">@sc.ClassName</span></td>
                            <td>
                                <div><strong>@sc.SubjectName</strong></div>
                                <div class="text-muted small">@sc.AssessmentName</div>
                            </td>
                            <td class="text-center font-monospace">
                                <span class="text-muted">@(sc.OldScore?.ToString("0.0") ?? "--")</span>
                                <i class="bi bi-arrow-right text-secondary mx-1"></i>
                                <span class="fw-bold @(isSignificant ? "text-danger" : "text-primary")">@(sc.NewScore?.ToString("0.0") ?? "--")</span>
                                @if (isSignificant)
                                {
                                    <span class="badge bg-danger-subtle text-danger ms-1" title="Biến động lớn (>= 2 điểm)">
                                        @(diff > 0 ? $"+{diff:0.0}" : $"{diff:0.0}")
                                    </span>
                                }
                            </td>
                            <td><span class="badge bg-light text-primary border">@sc.ModifiedByName</span></td>
                            <td class="small">
                                <i class="bi bi-chat-quote text-secondary me-1"></i>
                                @(string.IsNullOrWhiteSpace(sc.Reason) ? "Không ghi rõ lý do" : sc.Reason)
                            </td>
                        </tr>
                        sIdx++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bi bi-shield-check text-success fs-3 d-block mb-1"></i>
                            Không có trường hợp nào điều chỉnh điểm số sau khóa gần đây. Hệ thống bảo mật toàn vẹn số liệu.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Thông báo điều hành gửi đến Hiệu trưởng -->
@if (Model.RecentNotifications.Any())
{
    <div class="table-card mb-4">
        <div class="table-card-header">
            <div>
                <h3 class="table-card-title d-flex align-items-center gap-2">
                    <i class="bi bi-bell-fill text-warning"></i>
                    Thông Báo Cảnh Báo Điều Hành Gần Đây
                </h3>
                <p class="table-card-subtitle">Thông báo tự động từ hệ thống và giáo vụ khi có biến động điểm số hoặc quy chế.</p>
            </div>
        </div>
        <div class="p-3">
            <div class="list-group list-group-flush">
                @foreach (var notif in Model.RecentNotifications)
                {
                    <div class="list-group-item d-flex align-items-start gap-3 py-3 border-bottom">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-2 text-warning flex-shrink-0">
                            <i class="bi bi-bell fs-5"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <h6 class="fw-bold mb-0 text-dark">@notif.Title</h6>
                                <span class="text-muted small">@notif.SentAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <p class="mb-0 text-secondary small">@notif.Content</p>
                            <span class="text-muted" style="font-size: 0.75rem;">Gửi bởi: @notif.SenderName</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function updateLiveClock() {
            const now = new Date();
            const dateStr = now.toLocaleDateString('vi-VN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            const timeStr = now.toLocaleTimeString('vi-VN');
            const dElem = document.getElementById('liveClockDate');
            const tElem = document.getElementById('liveClockTime');
            if (dElem) dElem.textContent = dateStr;
            if (tElem) tElem.textContent = timeStr;
        }
        setInterval(updateLiveClock, 1000);
        updateLiveClock();
    </script>
}
