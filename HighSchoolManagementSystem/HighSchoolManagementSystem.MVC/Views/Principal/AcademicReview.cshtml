@model HighSchoolManagementSystem.MVC.Models.ViewModels.Principal.AcademicReviewViewModel
@{
    ViewData["Title"] = "Rà Soát & Phê Duyệt Kết Quả Học Tập";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN TRỊ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Rà Soát & Chốt Sổ Học Kỳ</h1>
        <p class="greeting-subtitle">
            Học kỳ: <strong>@Model.SemesterName</strong> · Năm học: <strong>@Model.AcademicYearCode</strong>
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        @if (Model.IsSemesterFinalized)
        {
            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6">
                <i class="bi bi-lock-fill me-1"></i>Đã chốt sổ & Khóa điểm
            </span>
            <form asp-action="UnlockSemester" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn mở khóa học kỳ này? Giáo viên sẽ có thể tiếp tục chỉnh sửa điểm số.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="semesterId" value="@Model.SemesterId" />
                <button type="submit" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-unlock-fill me-1"></i>Mở khóa học kỳ
                </button>
            </form>
        }
        else
        {
            <span class="badge bg-warning-subtle text-warning border border-warning px-3 py-2 fs-6">
                <i class="bi bi-pencil-fill me-1"></i>Chưa chốt sổ (Đang mở điểm)
            </span>
            <form asp-action="FinalizeSemester" method="post" class="d-inline" onsubmit="return confirm('XÁC NHẬN CHỐT SỔ HỌC KỲ:\n- Toàn bộ điểm trung bình môn, GPA và thứ hạng lớp sẽ được snapshot lưu chính thức.\n- Toàn bộ điểm số sẽ được KHÓA CỨNG, giáo viên sẽ không thể tự ý sửa đổi.\n\nBạn có chắc chắn muốn phê duyệt và chốt sổ không?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="semesterId" value="@Model.SemesterId" />
                <button type="submit" class="btn btn-primary btn-sm shadow-sm">
                    <i class="bi bi-patch-check-fill me-1"></i>Phê Duyệt & Chốt Sổ Học Kỳ
                </button>
            </form>
        }
        <a asp-action="AcademicReports" asp-route-semesterId="@Model.SemesterId" class="btn btn-secondary btn-sm">
            <i class="bi bi-bar-chart-line me-1"></i>Báo cáo tổng kết
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

<!-- Bộ lọc tìm kiếm -->
<div class="card-table-wrap mb-4 p-3 bg-light">
    <form method="get" asp-action="AcademicReview" class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <label class="form-label small text-muted mb-1">Học kỳ đánh giá</label>
            <select name="semesterId" asp-items="Model.SemesterOptions" class="form-select form-select-sm" onchange="this.form.submit()"></select>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small text-muted mb-1">Khối lớp</label>
            <select name="gradeLevelId" asp-items="Model.GradeLevelOptions" class="form-select form-select-sm" onchange="this.form.submit()"></select>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small text-muted mb-1">Lớp học</label>
            <select name="classId" asp-items="Model.ClassOptions" class="form-select form-select-sm" onchange="this.form.submit()"></select>
        </div>
        <div class="col-12 col-md-2 d-flex align-items-end">
            <a asp-action="AcademicReview" asp-route-semesterId="@Model.SemesterId" class="btn btn-secondary btn-sm w-100">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Đặt lại
            </a>
        </div>
    </form>
</div>

<!-- Tổng quan thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded shadow-sm">
            <div class="text-muted small">Tổng số lớp học</div>
            <div class="fs-4 fw-bold text-primary">@Model.TotalClasses</div>
            <div class="small text-muted">@Model.TotalStudents học sinh theo học</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded shadow-sm">
            <div class="text-muted small">Tiến độ nhập điểm</div>
            <div class="fs-4 fw-bold @(Model.EvaluatedStudentsCount == Model.TotalStudents ? "text-success" : "text-warning")">
                @Model.EvaluatedStudentsCount / @Model.TotalStudents
            </div>
            <div class="small text-muted">
                @(Model.TotalStudents > 0 ? Math.Round((decimal)Model.EvaluatedStudentsCount / Model.TotalStudents * 100m, 1) : 0)% đã có điểm
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded shadow-sm">
            <div class="text-muted small">ĐTB GPA Toàn Trường</div>
            <div class="fs-4 fw-bold text-success">@Model.SchoolAverageGpa.ToString("0.00")</div>
            <div class="small text-muted">Thang điểm 10</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded shadow-sm">
            <div class="text-muted small">Tỷ lệ Học Lực Giỏi / Khá</div>
            <div class="fs-4 fw-bold text-info">
                @{
                    int totalRanked = Model.AcademicRankCounts.Values.Sum();
                    int goodAndExc = Model.AcademicRankCounts.GetValueOrDefault("Giỏi", 0) + Model.AcademicRankCounts.GetValueOrDefault("Khá", 0);
                    decimal percentGood = totalRanked > 0 ? Math.Round((decimal)goodAndExc / totalRanked * 100m, 1) : 0m;
                }
                @percentGood%
            </div>
            <div class="small text-muted">@goodAndExc / @totalRanked học sinh</div>
        </div>
    </div>
</div>

<!-- Danh sách lớp học và tình trạng hoàn thành -->
<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Danh sách các lớp & Tiến độ hoàn thành</h2>
            <p class="table-card-subtitle">Hiệu trưởng có thể kiểm tra trực tiếp bảng điểm từng lớp trước khi phê duyệt chốt sổ.</p>
        </div>
        <span class="table-counter-badge">@Model.ClassReviews.Count lớp</span>
    </div>
    <div class="table-responsive">
        <table class="table-edu mb-0">
            <thead>
                <tr>
                    <th style="width: 60px;" class="text-center">STT</th>
                    <th>Lớp Học</th>
                    <th>Khối</th>
                    <th>Giáo Viên Chủ Nhiệm</th>
                    <th class="text-center">Sĩ Số</th>
                    <th class="text-center">Đã Có Điểm</th>
                    <th class="text-center">ĐTB Lớp</th>
                    <th class="text-center">Giỏi / Khá / Đạt / Chưa đạt</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-center" style="width: 140px;">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ClassReviews.Any())
                {
                    int idx = 1;
                    @foreach (var c in Model.ClassReviews)
                    {
                        <tr>
                            <td class="text-center">@idx</td>
                            <td><strong>@c.ClassName</strong></td>
                            <td>@c.GradeLevelName</td>
                            <td>@(c.HomeroomTeacherName ?? "Chưa phân công")</td>
                            <td class="text-center">@c.StudentCount</td>
                            <td class="text-center fw-semibold @(c.IsFullyGraded ? "text-success" : "text-warning")">
                                @c.GradedStudentCount / @c.StudentCount
                            </td>
                            <td class="text-center fw-bold">
                                @(c.AverageGpa?.ToString("0.00") ?? "—")
                            </td>
                            <td class="text-center small">
                                <span class="badge bg-success-subtle text-success">@c.ExcellentCount</span> /
                                <span class="badge bg-info-subtle text-info">@c.GoodCount</span> /
                                <span class="badge bg-warning-subtle text-warning">@c.PassCount</span> /
                                <span class="badge bg-danger-subtle text-danger">@c.FailCount</span>
                            </td>
                            <td class="text-center">
                                @if (c.IsFullyGraded)
                                {
                                    <span class="badge-status badge-status-success">Đã hoàn thành</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status-warning">Chưa hoàn tất</span>
                                }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Score" asp-action="HomeroomScores" asp-route-classId="@c.ClassId" asp-route-semesterId="@Model.SemesterId" class="btn btn-secondary btn-sm px-2 py-1" style="font-size: 12px;" target="_blank">
                                    <i class="bi bi-eye me-1"></i>Xem bảng điểm
                                </a>
                            </td>
                        </tr>
                        idx++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted py-4">Không tìm thấy lớp học nào phù hợp với bộ lọc.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
