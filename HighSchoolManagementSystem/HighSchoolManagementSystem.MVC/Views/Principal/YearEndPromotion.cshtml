@model HighSchoolManagementSystem.MVC.Models.ViewModels.Principal.YearEndPromotionViewModel
@{
    ViewData["Title"] = "Xét Lên Lớp, Lưu Ban & Tốt Nghiệp";
    var unprocessedStudents = Model.Students.Where(s => !s.IsAlreadyProcessed).ToList();
    bool canExecute = Model.AllSemestersFinalized && unprocessedStudents.Any();
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN TRỊ CUỐI NĂM HỌC
        </span>
        <h1 class="greeting-title">Xét Lên Lớp, Lưu Ban & Tốt Nghiệp</h1>
        <p class="greeting-subtitle">
            Năm học nguồn: <strong>@Model.SourceAcademicYearCode</strong>
            @if (!string.IsNullOrEmpty(Model.SourceClassName))
            {
                <span> · Lớp: <strong>@Model.SourceClassName</strong> (@Model.SourceGradeLevelName)</span>
            }
            @if (!string.IsNullOrEmpty(Model.TargetAcademicYearCode))
            {
                <span> <i class="bi bi-arrow-right mx-1"></i> Năm học đích: <strong>@Model.TargetAcademicYearCode</strong></span>
            }
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-action="AcademicReview" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-patch-check me-1"></i>Rà soát & Chốt sổ học kỳ
        </a>
        <a asp-action="Dashboard" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Về trang chủ
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

<!-- Kiểm tra điều kiện tiên quyết: Chốt sổ điểm các học kỳ -->
<div class="card-table-wrap mb-4 p-3 @(Model.AllSemestersFinalized ? "bg-success-subtle border-success" : "bg-warning-subtle border-warning") border rounded">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div class="fw-bold @(Model.AllSemestersFinalized ? "text-success" : "text-dark")">
                @if (Model.AllSemestersFinalized)
                {
                    <i class="bi bi-shield-fill-check me-1"></i>
                    <span>Điều kiện tiên quyết: Tất cả các học kỳ của năm học @Model.SourceAcademicYearCode đã được chốt sổ điểm.</span>
                }
                else
                {
                    <i class="bi bi-exclamation-octagon-fill text-danger me-1"></i>
                    <span>Chưa đủ điều kiện xét duyệt: Phải chốt sổ điểm tất cả học kỳ của năm học @Model.SourceAcademicYearCode trước khi xét lên lớp / tốt nghiệp.</span>
                }
            </div>
            <div class="small text-muted mt-1">
                Công thức tính GPA cả năm: <code>(ĐTB HK1 + ĐTB HK2 × 2) / 3</code> · Điều kiện gợi ý đạt: <code>GPA Cả năm &ge; 5.0</code> và Hạnh kiểm không bị loại <code>Yếu</code>.
            </div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (!Model.SourceSemesters.Any())
            {
                <span class="badge bg-secondary">Năm học chưa có học kỳ</span>
            }
            @foreach (var sem in Model.SourceSemesters)
            {
                if (sem.IsFinalized)
                {
                    <span class="badge bg-success px-3 py-2">
                        <i class="bi bi-lock-fill me-1"></i>@sem.SemesterName: Đã chốt sổ
                    </span>
                }
                else
                {
                    <a asp-action="AcademicReview" asp-route-semesterId="@sem.SemesterId" class="badge bg-danger text-decoration-none px-3 py-2" title="Nhấn để chuyển tới trang Chốt sổ học kỳ">
                        <i class="bi bi-unlock-fill me-1"></i>@sem.SemesterName: Chưa chốt sổ (Nhấn để chốt)
                    </a>
                }
            }
        </div>
    </div>
</div>

<!-- Bộ lọc chọn Năm học nguồn, Lớp nguồn và Năm học đích -->
<div class="card-table-wrap mb-4 p-3 bg-light">
    <form method="get" asp-action="YearEndPromotion" class="row g-3 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small fw-semibold text-muted mb-1">1. Năm học nguồn (Năm kết thúc)</label>
            <select name="sourceAcademicYearId" asp-items="Model.SourceAcademicYearOptions" class="form-select form-select-sm" onchange="this.form.submit()"></select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small fw-semibold text-muted mb-1">2. Lớp nguồn cần xét duyệt</label>
            <select name="sourceClassId" asp-items="Model.SourceClassOptions" class="form-select form-select-sm" onchange="this.form.submit()"></select>
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small fw-semibold text-muted mb-1">3. Năm học đích (Năm học mới)</label>
            <select name="targetAcademicYearId" asp-items="Model.TargetAcademicYearOptions" class="form-select form-select-sm" onchange="this.form.submit()"></select>
        </div>
    </form>
</div>

<!-- KPI Thống kê của lớp -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded shadow-sm">
            <div class="text-muted small">Tổng sĩ số lớp @(Model.SourceClassName ?? "")</div>
            <div class="fs-4 fw-bold text-primary">@Model.TotalStudents</div>
            <div class="small text-muted">Khối: @(Model.SourceGradeLevelName ?? "N/A")</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded shadow-sm">
            <div class="text-muted small">Đủ ĐK @(Model.IsFinalGrade ? "Tốt nghiệp" : "Lên lớp") (Chờ duyệt)</div>
            <div class="fs-4 fw-bold text-success">@Model.SuggestedPromoteOrGraduateCount</div>
            <div class="small text-muted">GPA &ge; 5.0 & Hạnh kiểm đạt</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded shadow-sm">
            <div class="text-muted small">Gợi ý Lưu ban (Chờ duyệt)</div>
            <div class="fs-4 fw-bold text-danger">@Model.SuggestedRepeatCount</div>
            <div class="small text-muted">Học lại @Model.SourceGradeLevelName</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="p-3 bg-white border rounded shadow-sm">
            <div class="text-muted small">Đã hoàn tất xét duyệt</div>
            <div class="fs-4 fw-bold text-info">@Model.AlreadyProcessedCount / @Model.TotalStudents</div>
            <div class="small text-muted">Học sinh đã chốt trạng thái</div>
        </div>
    </div>
</div>

@if (Model.SourceClassId.HasValue)
{
    <form asp-action="ExecuteYearEndPromotion" method="post" id="promotionForm" onsubmit="return validateAndConfirmPromotion();">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SourceAcademicYearId" value="@Model.SourceAcademicYearId" />
        <input type="hidden" name="SourceClassId" value="@Model.SourceClassId" />
        <input type="hidden" name="TargetAcademicYearId" value="@Model.TargetAcademicYearId" />

        <!-- Cấu hình Lớp đích cho học sinh Lên lớp & Lưu ban ngay trên cùng màn hình -->
        <div class="card-table-wrap mb-4 p-3 bg-white border shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-diagram-3-fill text-primary me-2"></i>Cấu Hình Phân Lớp Đích Năm Học Mới (@(Model.TargetAcademicYearCode ?? "Chưa có năm học mới"))
                </h5>
                @if (Model.IsFinalGrade)
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-1">
                        Khối cuối cấp (@Model.SourceGradeLevelName) — Xét Tốt Nghiệp THPT
                    </span>
                }
                else
                {
                    <span class="badge bg-info-subtle text-info border border-info px-3 py-1">
                        Chuyển khối: @Model.SourceGradeLevelName <i class="bi bi-arrow-right mx-1"></i> @Model.NextGradeLevelName
                    </span>
                }
            </div>

            <div class="row g-3 align-items-center">
                @if (!Model.IsFinalGrade)
                {
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-success mb-1">
                            <i class="bi bi-arrow-up-circle-fill me-1"></i>Lớp đích cho học sinh LÊN LỚP (@Model.NextGradeLevelName):
                        </label>
                        <select name="PromoteTargetClassId" id="promoteTargetClassSelect" asp-items="Model.PromoteTargetClassOptions" class="form-select"></select>
                        <div class="form-text">Toàn bộ học sinh được chọn <strong>"Lên lớp"</strong> bên dưới sẽ được chuyển thẳng vào lớp này.</div>
                    </div>
                }
                else
                {
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded bg-success-subtle border border-success-subtle">
                            <div class="fw-bold text-success mb-1">
                                <i class="bi bi-mortarboard-fill me-1"></i>Học sinh đủ điều kiện Tốt nghiệp (@Model.SourceGradeLevelName)
                            </div>
                            <div class="small text-dark">
                                Học sinh được chọn <strong>"Tốt nghiệp"</strong> sẽ được đóng trạng thái lớp 12 (<code>Graduated</code>) và cập nhật hồ sơ sang <strong>Đã tốt nghiệp THPT</strong>.
                            </div>
                        </div>
                    </div>
                }

                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold text-danger mb-1">
                        <i class="bi bi-arrow-repeat me-1"></i>Lớp học lại cho học sinh LƯU BAN / Ở LẠI LỚP (@Model.SourceGradeLevelName):
                    </label>
                    <select name="RepeatTargetClassId" id="repeatTargetClassSelect" asp-items="Model.RepeatTargetClassOptions" class="form-select"></select>
                    <div class="form-text">Bắt buộc chọn nếu trong danh sách bên dưới có học sinh nhận quyết định <strong>"Ở lại lớp (Lưu ban)"</strong>.</div>
                </div>
            </div>
        </div>

        <!-- Danh sách học sinh và quyết định xét duyệt -->
        <div class="card-table-wrap">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="mb-0 fw-bold">Danh Sách Học Sinh Lớp @Model.SourceClassName</h5>
                    <span class="small text-muted">Hiệu trưởng có thể điều chỉnh quyết định trên từng học sinh trước khi bấm xác nhận chốt.</span>
                </div>
                @if (canExecute)
                {
                    <button type="submit" class="btn btn-primary shadow-sm">
                        <i class="bi bi-check2-all me-1"></i>Xác Nhận Hoàn Tất @(Model.IsFinalGrade ? "Xét Tốt Nghiệp & Lưu Ban" : "Xét Lên Lớp & Lưu Ban")
                    </button>
                }
                else if (!Model.AllSemestersFinalized)
                {
                    <button type="button" class="btn btn-secondary" disabled>
                        <i class="bi bi-lock-fill me-1"></i>Vui lòng chốt sổ các học kỳ trước
                    </button>
                }
            </div>

            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="text-center">#</th>
                            <th>Mã HS</th>
                            <th>Họ và tên</th>
                            <th class="text-center">ĐTB HK1</th>
                            <th class="text-center">ĐTB HK2</th>
                            <th class="text-center">GPA Cả năm</th>
                            <th class="text-center">Học lực</th>
                            <th class="text-center">Hạnh kiểm</th>
                            <th class="text-center">Gợi ý hệ thống</th>
                            <th style="min-width: 230px;">Quyết định của Hiệu trưởng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Students.Any())
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    Lớp học này hiện chưa có học sinh nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rowIdx = 1;
                            int decisionIndex = 0;
                            foreach (var st in Model.Students)
                            {
                                <tr>
                                    <td class="text-center text-muted">@(rowIdx++)</td>
                                    <td class="fw-semibold text-primary">@st.StudentCode</td>
                                    <td class="fw-bold">@st.FullName</td>
                                    <td class="text-center">@(st.Semester1Gpa?.ToString("0.00") ?? "—")</td>
                                    <td class="text-center">@(st.Semester2Gpa?.ToString("0.00") ?? "—")</td>
                                    <td class="text-center">
                                        @if (st.YearGpa.HasValue)
                                        {
                                            <span class="fw-bold @(st.YearGpa.Value >= 5.0m ? "text-primary" : "text-danger")">
                                                @st.YearGpa.Value.ToString("0.00")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var rankBadge = st.YearAcademicRank switch
                                            {
                                                "Giỏi" => "bg-success-subtle text-success",
                                                "Khá" => "bg-info-subtle text-info",
                                                "Đạt" => "bg-warning-subtle text-dark",
                                                "Chưa đạt" => "bg-danger-subtle text-danger",
                                                _ => "bg-secondary-subtle text-secondary"
                                            };
                                        }
                                        <span class="badge @rankBadge">@st.YearAcademicRank</span>
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var conductBadge = st.YearConductGrade switch
                                            {
                                                "Tốt" => "bg-success-subtle text-success",
                                                "Khá" => "bg-primary-subtle text-primary",
                                                "Trung bình" or "Đạt" => "bg-warning-subtle text-dark",
                                                _ => "bg-danger-subtle text-danger"
                                            };
                                        }
                                        <span class="badge @conductBadge">@st.YearConductGrade</span>
                                    </td>
                                    <td class="text-center">
                                        @if (st.IsEligible)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">
                                                <i class="bi bi-check-circle me-1"></i>@(Model.IsFinalGrade ? "Đủ ĐK Tốt nghiệp" : "Đủ ĐK Lên lớp")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">
                                                <i class="bi bi-exclamation-circle me-1"></i>Ở lại lớp (Lưu ban)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (st.IsAlreadyProcessed)
                                        {
                                            <div class="d-flex flex-column">
                                                @if (st.CurrentSourceStatus == "Promoted")
                                                {
                                                    <span class="badge bg-success mb-1"><i class="bi bi-check2-circle me-1"></i>Đã lên lớp</span>
                                                }
                                                else if (st.CurrentSourceStatus == "Repeated")
                                                {
                                                    <span class="badge bg-warning text-dark mb-1"><i class="bi bi-arrow-repeat me-1"></i>Đã lưu ban</span>
                                                }
                                                else if (st.CurrentSourceStatus == "Graduated")
                                                {
                                                    <span class="badge bg-primary mb-1"><i class="bi bi-mortarboard-fill me-1"></i>Đã tốt nghiệp</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary mb-1">Đã xếp lớp mới</span>
                                                }

                                                @if (!string.IsNullOrEmpty(st.TargetAssignedClassName))
                                                {
                                                    <small class="text-muted"><i class="bi bi-arrow-return-right me-1"></i>@st.TargetAssignedClassName</small>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="Decisions[@decisionIndex].StudentId" value="@st.StudentId" />
                                            <input type="hidden" name="Decisions[@decisionIndex].SourceMembershipId" value="@st.SourceMembershipId" />
                                            <select name="Decisions[@decisionIndex].Outcome"
                                                    class="form-select form-select-sm student-outcome-select"
                                                    @(Model.AllSemestersFinalized ? "" : "disabled")>
                                                @if (Model.IsFinalGrade)
                                                {
                                                    if (st.SuggestedOutcome == "Graduate")
                                                    {
                                                        <option value="Graduate" selected>Tốt nghiệp THPT</option>
                                                        <option value="Repeat">Ở lại lớp (Lưu ban)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Graduate">Tốt nghiệp THPT</option>
                                                        <option value="Repeat" selected>Ở lại lớp (Lưu ban)</option>
                                                    }
                                                }
                                                else
                                                {
                                                    if (st.SuggestedOutcome == "Promote")
                                                    {
                                                        <option value="Promote" selected>Lên lớp (@Model.NextGradeLevelName)</option>
                                                        <option value="Repeat">Ở lại lớp (@Model.SourceGradeLevelName)</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="Promote">Lên lớp (@Model.NextGradeLevelName)</option>
                                                        <option value="Repeat" selected>Ở lại lớp (@Model.SourceGradeLevelName)</option>
                                                    }
                                                }
                                            </select>
                                            decisionIndex++;
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script>
        function validateAndConfirmPromotion() {
            const selects = document.querySelectorAll('.student-outcome-select');
            if (!selects || selects.length === 0) {
                alert('Không có học sinh nào cần xử lý.');
                return false;
            }

            let promoteCount = 0;
            let repeatCount = 0;
            let graduateCount = 0;

            selects.forEach(s => {
                if (s.value === 'Promote') promoteCount++;
                else if (s.value === 'Repeat') repeatCount++;
                else if (s.value === 'Graduate') graduateCount++;
            });

            const promoteSelect = document.getElementById('promoteTargetClassSelect');
            const repeatSelect = document.getElementById('repeatTargetClassSelect');

            if (promoteCount > 0 && (!promoteSelect || !promoteSelect.value)) {
                alert('Vui lòng chọn "Lớp đích cho học sinh LÊN LỚP" ở năm học mới trước khi xác nhận!');
                if (promoteSelect) promoteSelect.focus();
                return false;
            }

            if (repeatCount > 0 && (!repeatSelect || !repeatSelect.value)) {
                alert('Trong danh sách có ' + repeatCount + ' học sinh "Ở lại lớp (Lưu ban)". Vui lòng chọn "Lớp học lại" ngay trên màn hình trước khi xác nhận!');
                if (repeatSelect) repeatSelect.focus();
                return false;
            }

            const summaryLines = [
                'XÁC NHẬN QUYẾT ĐỊNH CUỐI NĂM HỌC:',
                '- Lớp nguồn: @(Model.SourceClassName ?? "") (@Model.SourceAcademicYearCode)'
            ];
            if (promoteCount > 0) {
                const promoteClassName = promoteSelect.options[promoteSelect.selectedIndex].text;
                summaryLines.push('- Số học sinh Lên lớp: ' + promoteCount + ' -> ' + promoteClassName);
            }
            if (graduateCount > 0) {
                summaryLines.push('- Số học sinh Tốt nghiệp THPT: ' + graduateCount);
            }
            if (repeatCount > 0) {
                const repeatClassName = repeatSelect.options[repeatSelect.selectedIndex].text;
                summaryLines.push('- Số học sinh Ở lại lớp (Lưu ban): ' + repeatCount + ' -> ' + repeatClassName);
            }
            summaryLines.push('\nBạn có chắc chắn muốn phê duyệt quyết định này không?');

            return confirm(summaryLines.join('\n'));
        }
    </script>
}
