@model HighSchoolManagementSystem.MVC.Models.ViewModels.Assessment.AssessmentListViewModel
@{
    ViewData["Title"] = "Quản Lý Bài Kiểm Tra & Đầu Điểm";
}

<!-- Greeting Banner EIMS Standard -->
<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-journal-check me-1"></i> BỘ MÔN GIẢNG DẠY • BÀI KIỂM TRA & ĐẦU ĐIỂM
        </span>
        <h1 class="greeting-title">Danh Sách Bài Kiểm Tra</h1>
        <p class="greeting-subtitle">
            Quản lý các cột điểm kiểm tra thường xuyên, giữa kỳ và cuối kỳ cho các lớp bộ môn được phân công giảng dạy.
        </p>
    </div>
    @if (Model.SelectedAssignment != null)
    {
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Create" asp-route-assignmentId="@Model.SelectedAssignment.Id" class="btn btn-primary px-3 py-2 shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i>
                <span>Tạo Bài Kiểm Tra Mới</span>
            </a>
        </div>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Assignments.Any())
{
    <div class="edu-card text-center py-5">
        <i class="bi bi-folder-x fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold text-dark">Chưa Có Phân Công Giảng Dạy</h5>
        <p class="text-muted small mb-0">Tài khoản của bạn hiện chưa được phân công phụ trách giảng dạy lớp học nào trong học kỳ này.</p>
    </div>
}
else
{
    <!-- KPI Counters -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="edu-card p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted d-block small fw-semibold">TỔNG ĐẦU ĐIỂM</span>
                    <span class="fs-4 fw-bold text-dark">@Model.TotalAssessments</span>
                </div>
                <div class="p-2 rounded-3 bg-light text-primary fs-3">
                    <i class="bi bi-journal-text"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="edu-card p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted d-block small fw-semibold">ĐÁNH GIÁ THƯỜNG XUYÊN (TX)</span>
                    <span class="fs-4 fw-bold text-info">@Model.RegularAssessmentsCount</span>
                </div>
                <div class="p-2 rounded-3 bg-light text-info fs-3">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="edu-card p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted d-block small fw-semibold">ĐÁNH GIÁ GIỮA KỲ (GK)</span>
                    <span class="fs-4 fw-bold text-warning">@Model.MidtermAssessmentsCount</span>
                </div>
                <div class="p-2 rounded-3 bg-light text-warning fs-3">
                    <i class="bi bi-award"></i>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="edu-card p-3 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted d-block small fw-semibold">ĐÁNH GIÁ CUỐI KỲ (CK)</span>
                    <span class="fs-4 fw-bold text-danger">@Model.FinalAssessmentsCount</span>
                </div>
                <div class="p-2 rounded-3 bg-light text-danger fs-3">
                    <i class="bi bi-trophy"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="edu-card mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label">Chọn lớp & môn giảng dạy</label>
                <div class="input-group">
                    <span class="input-group-text bg-white text-muted">
                        <i class="bi bi-collection"></i>
                    </span>
                    <select name="assignmentId" class="form-select" onchange="this.form.submit()">
                        @foreach (var assign in Model.Assignments)
                        {
                            <option value="@assign.Id" selected="@(assign.Id == Model.AssignmentId)">
                                Lớp @assign.ClassName - Môn @assign.SubjectName (@assign.SemesterName)
                            </option>
                        }
                    </select>
                </div>
            </div>

            <div class="col-12 col-md-5">
                <label class="form-label">Tìm kiếm bài kiểm tra</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                           placeholder="Nhập tên bài kiểm tra, loại điểm..." />
                </div>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <a asp-action="Index" asp-route-assignmentId="@Model.AssignmentId" class="btn btn-secondary" title="Đặt lại tìm kiếm">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Assessment List Table -->
    <div class="edu-card p-0 overflow-hidden shadow-sm">
        <div class="edu-card-header px-4 pt-3 pb-3 mb-0 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h2 class="edu-card-title mb-0">
                    <i class="bi bi-list-check text-primary me-1"></i>
                    Danh Sách Bài Kiểm Tra: 
                    @if (Model.SelectedAssignment != null)
                    {
                        <span class="text-primary fw-bold">Lớp @Model.SelectedAssignment.ClassName (@Model.SelectedAssignment.SubjectName)</span>
                    }
                </h2>
            </div>
            @if (Model.SelectedAssignment != null)
            {
                <span class="badge bg-light text-dark border">
                    Sĩ số: @Model.SelectedAssignment.TotalStudents học sinh
                </span>
            }
        </div>

        @if (!Model.Assessments.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
                <h5 class="fw-bold text-dark">Chưa có bài kiểm tra nào</h5>
                <p class="text-muted small mb-3">Lớp môn học này hiện chưa được khởi tạo bài kiểm tra nào.</p>
                @if (Model.SelectedAssignment != null)
                {
                    <a asp-action="Create" asp-route-assignmentId="@Model.SelectedAssignment.Id" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Tạo bài kiểm tra đầu tiên
                    </a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table-edu mb-0">
                    <thead>
                        <tr>
                            <th class="text-center" style="width: 60px;">STT</th>
                            <th>Tên Bài Kiểm Tra</th>
                            <th>Phân Loại</th>
                            <th class="text-center" style="width: 90px;">Hệ Số</th>
                            <th>Ngày Kiểm Tra</th>
                            <th>Tiến Độ Nhập Điểm</th>
                            <th class="text-center" style="width: 130px;">Trạng Thái</th>
                            <th class="text-center" style="width: 140px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int index = 1; }
                        @foreach (var item in Model.Assessments)
                        {
                            <tr>
                                <td class="text-center fw-semibold text-muted">@index</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.AssessmentName</div>
                                    <div class="small text-muted">@item.SubjectCode - Lớp @item.ClassName</div>
                                </td>
                                <td>
                                    @if (item.AssessmentTypeCode == "TX")
                                    {
                                        <span class="badge-status badge-status-info">
                                            <i class="bi bi-clock-history"></i> @item.AssessmentTypeName
                                        </span>
                                    }
                                    else if (item.AssessmentTypeCode == "GK")
                                    {
                                        <span class="badge-status badge-status-warning">
                                            <i class="bi bi-award"></i> @item.AssessmentTypeName
                                        </span>
                                    }
                                    else if (item.AssessmentTypeCode == "CK")
                                    {
                                        <span class="badge-status badge-status-danger">
                                            <i class="bi bi-trophy"></i> @item.AssessmentTypeName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status bg-light text-dark border">
                                            @item.AssessmentTypeName
                                        </span>
                                    }
                                </td>
                                <td class="text-center fw-bold text-primary">
                                    x@(item.Weight.ToString("G29"))
                                </td>
                                <td>
                                    @if (item.ConductedAt.HasValue)
                                    {
                                        <span><i class="bi bi-calendar-event me-1 text-muted"></i>@item.ConductedAt.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa xác định</span>
                                    }
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="fw-semibold">@item.GradedStudentsCount / @item.TotalStudents</span> học sinh
                                    </div>
                                    @{
                                        int progressPercent = item.TotalStudents > 0 
                                            ? (int)Math.Round((double)item.GradedStudentsCount * 100 / item.TotalStudents) 
                                            : 0;
                                    }
                                    <div class="progress mt-1" style="height: 5px; width: 120px;">
                                        <div class="progress-bar @(progressPercent == 100 ? "bg-success" : "bg-primary")" 
                                             role="progressbar" 
                                             style="width: @(progressPercent)%;" 
                                             aria-valuenow="@progressPercent" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100"></div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (item.HasLockedScores)
                                    {
                                        <span class="badge-status badge-status-warning" title="Đã có điểm số bị khóa">
                                            <i class="bi bi-lock-fill"></i> Đã khóa điểm
                                        </span>
                                    }
                                    else if (item.HasScores)
                                    {
                                        <span class="badge-status badge-status-success">
                                            <i class="bi bi-check-circle-fill"></i> Đang mở
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status bg-light text-muted border">
                                            <i class="bi bi-dash-circle"></i> Chưa vào điểm
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-controller="Score" asp-action="Entry" asp-route-assessmentId="@item.Id" class="btn btn-primary btn-sm px-2 py-1 shadow-sm" title="Vào bảng nhập điểm">
                                            <i class="bi bi-pencil-fill me-1"></i>Nhập điểm
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm px-2 py-1 shadow-sm" title="Chỉnh sửa bài kiểm tra">
                                            <i class="bi bi-gear"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
