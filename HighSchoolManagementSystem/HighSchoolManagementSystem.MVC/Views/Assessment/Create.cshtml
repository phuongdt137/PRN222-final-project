@model HighSchoolManagementSystem.MVC.Models.ViewModels.Assessment.CreateAssessmentViewModel
@{
    ViewData["Title"] = "Tạo Bài Kiểm Tra Mới";
}

<!-- Greeting Banner EIMS Standard -->
<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-plus-circle-fill me-1"></i> BỘ MÔN GIẢNG DẠY • TẠO ĐẦU ĐIỂM
        </span>
        <h1 class="greeting-title">Tạo Bài Kiểm Tra Mới</h1>
        <p class="greeting-subtitle">
            Thiết lập đầu điểm kiểm tra thường xuyên, giữa kỳ hoặc cuối kỳ cho lớp học được phân công.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" asp-route-assignmentId="@Model.TeachingAssignmentId" class="btn btn-secondary px-3 py-2 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i>
            <span>Quay Lại Danh Sách</span>
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="edu-card shadow-sm">
            <div class="edu-card-header">
                <h2 class="edu-card-title">
                    <i class="bi bi-pencil-fill text-primary me-2"></i>Biểu Mẫu Thông Tin Bài Kiểm Tra
                </h2>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-3">
                    <!-- Chọn Lớp & Môn Giảng Dạy -->
                    <div class="col-12">
                        <label asp-for="TeachingAssignmentId" class="form-label required">Lớp & Môn học phân công <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">
                                <i class="bi bi-mortarboard-fill"></i>
                            </span>
                            <select asp-for="TeachingAssignmentId" class="form-select fw-semibold">
                                @foreach (var assign in Model.AvailableAssignments)
                                {
                                    <option value="@assign.Id" selected="@(assign.Id == Model.TeachingAssignmentId)">
                                        Lớp @assign.ClassName — Môn @assign.SubjectName (@assign.SemesterName - @assign.AcademicYearCode)
                                    </option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="TeachingAssignmentId" class="text-danger small"></span>
                    </div>

                    <!-- Chọn Loại Kiểm Tra / Đánh Giá -->
                    <div class="col-12">
                        <label asp-for="AssessmentTypeId" class="form-label required">Loại bài kiểm tra / Hình thức đánh giá <span class="text-danger">*</span></label>
                        <div class="row g-3">
                            @foreach (var type in Model.AvailableTypes)
                            {
                                <div class="col-12 col-md-4">
                                    <div class="border rounded-3 p-3 h-100 bg-white shadow-sm position-relative">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="AssessmentTypeId" value="@type.Id" id="type_@type.Id" />
                                            <label class="form-check-label fw-bold text-dark" for="type_@type.Id">
                                                @type.TypeName
                                            </label>
                                        </div>
                                        <div class="mt-2 ps-4 small text-muted">
                                            <div><i class="bi bi-check2-circle text-primary me-1"></i>Hệ số: <strong>x@(type.Weight.ToString("G29"))</strong></div>
                                            <div><i class="bi bi-hash text-muted me-1"></i>Tối đa: <strong>@type.MaxEntries bài</strong></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <span asp-validation-for="AssessmentTypeId" class="text-danger small"></span>
                    </div>

                    <!-- Tên Bài Kiểm Tra -->
                    <div class="col-12 col-md-8">
                        <label asp-for="AssessmentName" class="form-label required">Tên bài kiểm tra <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">
                                <i class="bi bi-file-earmark-text-fill"></i>
                            </span>
                            <input asp-for="AssessmentName" class="form-control" 
                                   placeholder="VD: Kiểm tra 15 phút số 1, Bài kiểm tra giữa kỳ..." autofocus />
                        </div>
                        <span asp-validation-for="AssessmentName" class="text-danger small"></span>
                        <div class="form-text small text-muted">
                            Đặt tên rõ ràng để học sinh và phụ huynh dễ dàng tra cứu trên sổ điểm điện tử.
                        </div>
                    </div>

                    <!-- Ngày Tổ Chức Kiểm Tra -->
                    <div class="col-12 col-md-4">
                        <label asp-for="ConductedAt" class="form-label">Ngày tổ chức kiểm tra</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">
                                <i class="bi bi-calendar3"></i>
                            </span>
                            <input asp-for="ConductedAt" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="ConductedAt" class="text-danger small"></span>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-12 mt-4 pt-3 border-top d-flex align-items-center justify-content-end gap-2">
                        <a asp-action="Index" asp-route-assignmentId="@Model.TeachingAssignmentId" class="btn btn-secondary px-4 py-2">
                            <i class="bi bi-x-circle me-1"></i>Hủy Bỏ
                        </a>
                        <button type="submit" class="btn btn-primary px-4 py-2 shadow-sm">
                            <i class="bi bi-check-circle-fill me-1"></i>Tạo Bài Kiểm Tra
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
