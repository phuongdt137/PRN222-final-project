@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<aside class="app-sidebar">
    <div class="sidebar-brand">
        <img src="~/images/logo.png" alt="Logo THPT" class="sidebar-brand-logo" />
        <div class="sidebar-brand-text">
            <span class="sidebar-brand-title">TRƯỜNG THPT</span>
            <span class="sidebar-brand-sub">HỆ THỐNG QUẢN LÝ</span>
        </div>
    </div>

    <nav class="sidebar-nav">
        @if (User.IsInRole("Principal"))
        {
            <div class="sidebar-section-title">TỔNG QUAN</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a asp-controller="Principal" asp-action="Dashboard" 
                       class="sidebar-link @(currentController == "Principal" && currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Trang chủ</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-title">GIÁM SÁT TOÀN TRƯỜNG</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-calendar-check"></i>
                        <span>Báo cáo chuyên cần</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-bar-chart-line"></i>
                        <span>Báo cáo học tập</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-shield-check"></i>
                        <span>Kỷ luật & Nề nếp</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="TeacherManagement" asp-action="Index" 
                       class="sidebar-link @(currentController == "TeacherManagement" ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>Hồ sơ giáo viên</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-title">QUẢN TRỊ HỆ THỐNG</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-calendar-event"></i>
                        <span>Cấu hình năm học</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-person-gear"></i>
                        <span>Danh sách tài khoản</span>
                    </a>
                </li>
            </ul>
        }
        else if (User.IsInRole("Staff"))
        {
            <div class="sidebar-section-title">KHÔNG GIAN CỦA TÔI</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a asp-controller="Staff" asp-action="Dashboard" 
                       class="sidebar-link @(currentController == "Staff" && currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Trang chủ</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-calendar3"></i>
                        <span>Lịch công tác</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-title">QUẢN LÝ ĐÀO TẠO</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a asp-controller="TeacherManagement" asp-action="Index" 
                       class="sidebar-link @(currentController == "TeacherManagement" ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Hồ sơ giáo viên</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="Subject" asp-action="Index" 
                       class="sidebar-link @(currentController == "Subject" ? "active" : "")">
                        <i class="bi bi-journal-bookmark-fill"></i>
                        <span>Danh mục môn học</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-person-vcard"></i>
                        <span>Hồ sơ học sinh</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-collection"></i>
                        <span>Danh sách lớp học</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-diagram-3"></i>
                        <span>Phân công giảng dạy</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-door-open"></i>
                        <span>Quản lý phòng học</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-title">HÀNH CHÍNH & TIẾP NHẬN</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-file-earmark-check"></i>
                        <span>Duyệt đơn nghỉ phép</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-inbox"></i>
                        <span>Tiếp nhận yêu cầu</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-printer"></i>
                        <span>Cấp bảng điểm & Giấy tờ</span>
                    </a>
                </li>
            </ul>
        }
        else if (User.IsInRole("Teacher"))
        {
            <div class="sidebar-section-title">KHÔNG GIAN CỦA TÔI</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a asp-controller="Teacher" asp-action="Dashboard" 
                       class="sidebar-link @(currentController == "Teacher" && currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Trang chủ</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-calendar-week"></i>
                        <span>Lịch dạy (TKB)</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-title">LỚP CHỦ NHIỆM</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-people"></i>
                        <span>Danh sách học sinh</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-check2-square"></i>
                        <span>Điểm danh hàng ngày</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-award"></i>
                        <span>Hạnh kiểm & Rèn luyện</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-title">BỘ MÔN GIẢNG DẠY</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-journal-check"></i>
                        <span>Sổ điểm bộ môn</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-clock-history"></i>
                        <span>Lịch kiểm tra</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-folder2-open"></i>
                        <span>Tài liệu giảng dạy</span>
                    </a>
                </li>
            </ul>
        }
        else if (User.IsInRole("Student"))
        {
            <div class="sidebar-section-title">HỌC TẬP CỦA TÔI</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a asp-controller="Student" asp-action="Dashboard" 
                       class="sidebar-link @(currentController == "Student" && currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Trang chủ</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-calendar-week"></i>
                        <span>Thời khóa biểu tuần</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Tra cứu bảng điểm</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-check-circle"></i>
                        <span>Chuyên cần & Điểm danh</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-title">RÈN LUYỆN & THỦ TỤC</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-patch-check"></i>
                        <span>Điểm rèn luyện</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-pencil-square"></i>
                        <span>Gửi đơn xin nghỉ</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-stars"></i>
                        <span>Hoạt động ngoại khóa</span>
                    </a>
                </li>
            </ul>
        }
        else if (User.IsInRole("Parent"))
        {
            <div class="sidebar-section-title">THEO DÕI CON EM</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a asp-controller="Parent" asp-action="Dashboard" 
                       class="sidebar-link @(currentController == "Parent" && currentAction == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Trang chủ</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-calendar-week"></i>
                        <span>Thời khóa biểu của con</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-mortarboard"></i>
                        <span>Kết quả học tập</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-calendar-check"></i>
                        <span>Chuyên cần & Điểm danh</span>
                    </a>
                </li>
            </ul>

            <div class="sidebar-section-title">TƯƠNG TÁC NHÀ TRƯỜNG</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-send"></i>
                        <span>Đơn xin nghỉ cho con</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-chat-dots"></i>
                        <span>Liên hệ GVCN</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a href="javascript:void(0)" class="sidebar-link">
                        <i class="bi bi-book"></i>
                        <span>Sổ liên lạc điện tử</span>
                    </a>
                </li>
            </ul>
        }
        else
        {
            <div class="sidebar-section-title">HỆ THỐNG</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a asp-controller="Home" asp-action="Index" class="sidebar-link active">
                        <i class="bi bi-house"></i>
                        <span>Trang chủ cổng</span>
                    </a>
                </li>
            </ul>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-section-title">TÀI KHOẢN</div>
            <ul class="sidebar-menu-list">
                <li class="sidebar-menu-item">
                    <a asp-controller="Profile" asp-action="Index" 
                       class="sidebar-link @(currentController == "Profile" && currentAction == "Index" ? "active" : "")">
                        <i class="bi bi-person-circle"></i>
                        <span>Hồ sơ cá nhân</span>
                    </a>
                </li>
                <li class="sidebar-menu-item">
                    <a asp-controller="Profile" asp-action="ChangePassword" 
                       class="sidebar-link @(currentController == "Profile" && currentAction == "ChangePassword" ? "active" : "")">
                        <i class="bi bi-key-fill"></i>
                        <span>Đổi mật khẩu</span>
                    </a>
                </li>
            </ul>
        }
    </nav>
</aside>
