<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "High School Management System") - Hệ Thống Quản Lý Trường THPT</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HighSchoolManagementSystem.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    @if (ViewData["HideNav"] as bool? == true)
    {
        <main role="main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="app-layout">
            <partial name="_Sidebar" />
            <div class="app-main-wrapper">
                <partial name="_TopHeader" />
                <main role="main" class="app-content">
                    @RenderBody()
                </main>
                <footer class="app-footer">
                    <span>&copy; @DateTime.Now.Year - Hệ thống Quản lý Trường THPT. Chuẩn hóa quy trình đào tạo và nề nếp.</span>
                    <span>Hỗ trợ kỹ thuật: hotro@thpt.edu.vn</span>
                </footer>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
