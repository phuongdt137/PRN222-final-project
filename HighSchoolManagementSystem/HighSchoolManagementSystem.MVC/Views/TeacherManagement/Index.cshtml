@model HighSchoolManagementSystem.MVC.Models.ViewModels.Teacher.TeacherListViewModel
@{
    ViewData["Title"] = "Quản Lý Giáo Viên";
}

<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-people-fill me-1"></i> NHÂN SỰ SƯ PHẠM • DANH BẠ GIÁO VIÊN
        </span>
        <h1 class="greeting-title">Hồ Sơ Giáo Viên</h1>
        <p class="greeting-subtitle">
            Quản lý đội ngũ cán bộ giáo viên, theo dõi chuyên môn tổ bộ môn, định mức tiết dạy và phân công giảng dạy.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm">
            <i class="bi bi-person-plus-fill"></i>
            <span>Thêm Mới Giáo Viên</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-semibold">TỔNG SỐ GIÁO VIÊN</span>
                <span class="fs-4 fw-bold text-dark">@Model.TotalCount</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-primary fs-3">
                <i class="bi bi-person-badge"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-semibold">ĐANG CÔNG TÁC</span>
                <span class="fs-4 fw-bold text-success">@Model.ActiveCount</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-success fs-3">
                <i class="bi bi-person-check-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-semibold">TẠM DỪNG / NGHỈ PHÉP</span>
                <span class="fs-4 fw-bold text-secondary">@Model.InactiveCount</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-secondary fs-3">
                <i class="bi bi-person-x-fill"></i>
            </div>
        </div>
    </div>
</div>

<div class="edu-card mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label">Tìm kiếm giáo viên</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                       placeholder="Nhập mã GV, họ tên, email, số điện thoại..." />
            </div>
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label">Tổ chuyên môn</label>
            <select name="specialization" class="form-select">
                <option value="">-- Tất cả tổ bộ môn --</option>
                @foreach (var spec in Model.SpecializationList)
                {
                    <option value="@spec" selected="@(Model.SpecializationFilter == spec)">@spec</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label">Trạng thái</label>
            <select name="status" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang công tác</option>
                <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Tạm dừng</option>
            </select>
        </div>

        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-funnel-fill"></i> Lọc
            </button>
            <a asp-action="Index" class="btn btn-secondary" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<div class="edu-card p-0 overflow-hidden">
    <div class="edu-card-header px-4 pt-3 pb-2 border-bottom d-flex align-items-center justify-content-between mb-0">
        <h2 class="edu-card-title">
            <i class="bi bi-table me-2 text-primary"></i>Danh Sách Cán Bộ Giáo Viên (@Model.Teachers.Count kết quả)
        </h2>
    </div>

    @if (Model.Teachers.Count == 0)
    {
        <div class="p-5 text-center">
            <div class="text-muted mb-3" style="font-size: 3rem;">
                <i class="bi bi-inbox"></i>
            </div>
            <h5 class="fw-bold text-secondary">Không tìm thấy giáo viên nào</h5>
            <p class="text-muted small">Hãy thử điều chỉnh từ khóa tìm kiếm hoặc điều kiện lọc.</p>
            <a asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Xem tất cả giáo viên</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-edu m-0">
                <thead>
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th style="width: 120px;">Mã GV</th>
                        <th>Họ và Tên</th>
                        <th>Tổ chuyên môn</th>
                        <th>Liên hệ</th>
                        <th style="width: 130px;" class="text-center">Chủ nhiệm</th>
                        <th style="width: 120px;" class="text-center">Phân công</th>
                        <th style="width: 130px;" class="text-center">Trạng thái</th>
                        <th style="width: 180px;" class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var item in Model.Teachers)
                    {
                        <tr>
                            <td class="text-center text-muted small">@stt</td>
                            <td>
                                <span class="badge bg-light text-primary border px-2 py-1 font-monospace fw-bold">
                                    @item.TeacherCode
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.FullName</div>
                                @if (!string.IsNullOrEmpty(item.Qualification))
                                {
                                    <div class="text-muted small">
                                        <i class="bi bi-mortarboard-fill me-1"></i>@item.Qualification
                                    </div>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.Specialization))
                                {
                                    <span class="badge bg-light text-dark border">
                                        @item.Specialization
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa xếp tổ</span>
                                }
                            </td>
                            <td>
                                <div class="small text-truncate" style="max-width: 200px;">
                                    <i class="bi bi-envelope me-1 text-muted"></i>@item.Email
                                </div>
                                @if (!string.IsNullOrEmpty(item.PhoneNumber))
                                {
                                    <div class="small text-muted font-monospace">
                                        <i class="bi bi-telephone me-1 text-muted"></i>@item.PhoneNumber
                                    </div>
                                }
                            </td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.HomeroomClassName))
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                        @item.HomeroomClassName
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.TotalAssignments > 0)
                                {
                                    <a asp-action="Assignments" asp-route-id="@item.Id" 
                                       class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 text-decoration-none">
                                        <i class="bi bi-journal-check me-1"></i>@item.TotalAssignments lớp
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">0 lớp</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.Status == "Active")
                                {
                                    <span class="badge-status badge-status-success">
                                        <i class="bi bi-check-circle-fill"></i> Công tác
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status-danger">
                                        <i class="bi bi-dash-circle-fill"></i> Tạm dừng
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" 
                                       class="btn btn-secondary px-2" title="Xem chi tiết hồ sơ">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <a asp-action="Assignments" asp-route-id="@item.Id" 
                                       class="btn btn-secondary px-2" title="Xem phân công giảng dạy">
                                        <i class="bi bi-calendar3"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id" 
                                       class="btn btn-secondary px-2" title="Chỉnh sửa giáo viên">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <button type="button" 
                                            class="btn @(item.Status == "Active" ? "btn-outline-danger" : "btn-outline-success") px-2"
                                            title="@(item.Status == "Active" ? "Tạm dừng hoạt động" : "Kích hoạt hoạt động")"
                                            data-bs-toggle="modal" 
                                            data-bs-target="#toggleTeacherStatusModal"
                                            data-teacher-id="@item.Id"
                                            data-teacher-name="@item.FullName"
                                            data-teacher-code="@item.TeacherCode"
                                            data-status="@item.Status">
                                        <i class="bi @(item.Status == "Active" ? "bi-person-slash" : "bi-person-check")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        stt++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="toggleTeacherStatusModal" tabindex="-1" aria-labelledby="toggleTeacherStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="toggleTeacherStatusModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Thay đổi trạng thái công tác
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3" id="toggleTeacherPrompt">
                    Bạn có chắc chắn muốn thay đổi trạng thái hoạt động của giáo viên này?
                </p>
                <div class="p-3 bg-light rounded-3 border">
                    <div class="fw-bold text-dark" id="modalTeacherName">Tên giáo viên</div>
                    <div class="text-muted small font-monospace" id="modalTeacherCode">Mã GV</div>
                </div>
            </div>
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <form id="toggleTeacherStatusForm" method="post" asp-action="ToggleStatus">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalTeacherIdInput" value="" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-primary" id="modalTeacherSubmitBtn">
                        Xác nhận
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleModal = document.getElementById('toggleTeacherStatusModal');
            if (toggleModal) {
                toggleModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-teacher-id');
                    const name = button.getAttribute('data-teacher-name');
                    const code = button.getAttribute('data-teacher-code');
                    const status = button.getAttribute('data-status');

                    document.getElementById('modalTeacherIdInput').value = id;
                    document.getElementById('modalTeacherName').textContent = name;
                    document.getElementById('modalTeacherCode').textContent = 'Mã GV: ' + code;

                    const promptEl = document.getElementById('toggleTeacherPrompt');
                    const submitBtn = document.getElementById('modalTeacherSubmitBtn');

                    if (status === 'Active') {
                        promptEl.innerHTML = `Bạn có chắc chắn muốn <strong>TẠM DỪNG</strong> trạng thái công tác của giáo viên này? Tài khoản sẽ không thể đăng nhập.`;
                        submitBtn.className = 'btn btn-danger';
                        submitBtn.textContent = 'Tạm Dừng Hoạt Động';
                    } else {
                        promptEl.innerHTML = `Bạn có chắc chắn muốn <strong>KÍCH HOẠT</strong> lại trạng thái công tác cho giáo viên này?`;
                        submitBtn.className = 'btn btn-success';
                        submitBtn.textContent = 'Kích Hoạt Công Tác';
                    }
                });
            }
        });
    </script>
}
