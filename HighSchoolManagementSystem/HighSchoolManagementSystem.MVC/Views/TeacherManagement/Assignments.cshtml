@model HighSchoolManagementSystem.MVC.Models.ViewModels.Teacher.TeacherAssignmentsViewModel
@{
    ViewData["Title"] = "Phân Công Giảng Dạy: " + Model.FullName;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
        <span>@TempData["SuccessMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
        <span>@TempData["ErrorMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-calendar3 me-1"></i> KẾ HOẠCH ĐÀO TẠO • QUẢN LÝ PHÂN CÔNG GIẢNG DẠY
        </span>
        <h1 class="greeting-title">Lịch Phân Công: @Model.FullName</h1>
        <p class="greeting-subtitle">
            Mã giáo viên: <strong class="font-monospace text-primary">@Model.TeacherCode</strong> • 
            Tổ bộ môn: <strong>@(Model.Specialization ?? "Chưa phân tổ")</strong> • 
            Trình độ: <strong>@(Model.Qualification ?? "Cử nhân")</strong> • 
            Định mức: <strong>@(Model.MaxPeriodsPerWeek ?? 20) tiết/tuần</strong>
        </p>
    </div>
    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (Model.Status == "Active")
        {
            <button type="button" class="btn btn-primary px-3 py-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#assignTeacherModal">
                <i class="bi bi-plus-circle-fill me-1"></i>
                <span>Phân Công Mới</span>
            </button>
        }
        <a asp-controller="Timetable" asp-action="Index" asp-route-teacherId="@Model.TeacherId" asp-route-semesterId="@Model.SemesterFilter" asp-route-editMode="true" class="btn btn-outline-primary px-3 py-2 shadow-sm bg-white" title="Xem & Xếp thời khóa biểu tuần">
            <i class="bi bi-calendar-week me-1"></i>
            <span>TKB Tuần (Xếp lịch)</span>
        </a>
        <a asp-action="Details" asp-route-id="@Model.TeacherId" class="btn btn-secondary px-3 py-2 shadow-sm">
            <i class="bi bi-person-lines-fill me-1"></i>
            <span>Hồ Sơ GV</span>
        </a>
        <a asp-action="Index" class="btn btn-secondary px-3 py-2 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i>
            <span>Danh Sách</span>
        </a>
    </div>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between h-100">
            <div>
                <span class="text-muted d-block small fw-semibold">TỔNG SỐ LỚP DẠY</span>
                <span class="fs-4 fw-bold text-dark">@Model.TotalClassesCount</span>
                <span class="text-muted small"> lớp học</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-primary fs-3">
                <i class="bi bi-mortarboard"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between h-100">
            <div>
                <span class="text-muted d-block small fw-semibold">SỐ MÔN HỌC</span>
                <span class="fs-4 fw-bold text-dark">@Model.TotalDistinctSubjectsCount</span>
                <span class="text-muted small"> môn học</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-info fs-3">
                <i class="bi bi-journal-bookmark"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="edu-card p-3 h-100 d-flex flex-column justify-content-between">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted d-block small fw-semibold">SỐ TIẾT TKB / ĐỊNH MỨC</span>
                    <span class="fs-4 fw-bold @(Model.IsOverloaded ? "text-danger" : "text-primary")">
                        @Model.TotalScheduledPeriods
                    </span>
                    <span class="text-muted small">/ @(Model.MaxPeriodsPerWeek ?? 20) tiết</span>
                </div>
                <div class="p-2 rounded-3 bg-light @(Model.IsOverloaded ? "text-danger" : "text-primary") fs-3">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="mt-2">
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar @(Model.IsOverloaded ? "bg-danger" : (Model.WorkloadPercentage > 80 ? "bg-success" : "bg-primary"))" 
                         role="progressbar" 
                         style="width: @Math.Min(100, (int)Model.WorkloadPercentage)%;" 
                         aria-valuenow="@Model.WorkloadPercentage" aria-valuemin="0" aria-valuemax="100">
                    </div>
                </div>
                <div class="d-flex justify-content-between small text-muted mt-1" style="font-size: 0.75rem;">
                    <span>Tải công việc: @Model.WorkloadPercentage%</span>
                    @if (Model.IsOverloaded)
                    {
                        <span class="text-danger fw-bold"><i class="bi bi-exclamation-triangle"></i> Vượt định mức</span>
                    }
                    else
                    {
                        <span class="text-success fw-semibold">Trong mức cho phép</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between h-100">
            <div>
                <span class="text-muted d-block small fw-semibold">LỚP CHỦ NHIỆM</span>
                @if (Model.HomeroomClasses.Any())
                {
                    <span class="fs-5 fw-bold text-success d-block text-truncate" style="max-width: 170px;" title="@string.Join(", ", Model.HomeroomClasses.Select(c => c.ClassName))">
                        @string.Join(", ", Model.HomeroomClasses.Select(c => c.ClassName))
                    </span>
                    <span class="badge bg-success-subtle text-success small mt-1">GV Chủ nhiệm</span>
                }
                else
                {
                    <span class="fs-5 fw-bold text-muted">Không có</span>
                    <span class="text-muted small d-block">Giáo viên bộ môn</span>
                }
            </div>
            <div class="p-2 rounded-3 bg-light text-success fs-3">
                <i class="bi bi-award"></i>
            </div>
        </div>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="edu-card p-3 mb-4">
    <form method="get" asp-action="Assignments" asp-route-id="@Model.TeacherId" class="row g-2 align-items-center">
        <input type="hidden" name="id" value="@Model.TeacherId" />
        
        <div class="col-12 col-md-3">
            <label class="form-label small text-muted fw-bold mb-1">Học Kỳ & Năm Học</label>
            <select name="semesterId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Tất cả các học kỳ --</option>
                @foreach (var sem in Model.AvailableSemesters)
                {
                    <!option value="@sem.Id" @(Model.SemesterFilter == sem.Id ? "selected" : "")>
                        @sem.SemesterName - Năm học @sem.AcademicYear @(sem.IsActive ? " [Hiện tại]" : "")
                    </!option>
                }
            </select>
        </div>

        <div class="col-12 col-md-3">
            <label class="form-label small text-muted fw-bold mb-1">Môn Học</label>
            <select name="subjectId" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">-- Tất cả môn học --</option>
                @foreach (var sub in Model.AvailableSubjects)
                {
                    <!option value="@sub.Id" @(Model.SubjectFilter == sub.Id ? "selected" : "")>
                        @sub.SubjectCode - @sub.SubjectName @(sub.IsSpecialized ? " (Tổ môn)" : "")
                    </!option>
                }
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label small text-muted fw-bold mb-1">Trạng Thái</label>
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="All">-- Tất cả --</option>
                <!option value="Active" @(Model.StatusFilter == "Active" ? "selected" : "")>Đang công tác / Active</!option>
                <!option value="Assigned" @(Model.StatusFilter == "Assigned" ? "selected" : "")>Đã phân công</!option>
                <!option value="Inactive" @(Model.StatusFilter == "Inactive" ? "selected" : "")>Tạm dừng / Inactive</!option>
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label small text-muted fw-bold mb-1">Từ Khóa</label>
            <div class="input-group input-group-sm">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Tên lớp, môn học..." />
            </div>
        </div>

        <div class="col-12 col-md-2 d-flex gap-2 align-self-end">
            <button type="submit" class="btn btn-primary btn-sm flex-grow-1">
                <i class="bi bi-funnel-fill me-1"></i> Lọc
            </button>
            <a asp-action="Assignments" asp-route-id="@Model.TeacherId" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Assigned Classes & Subjects Table -->
<div class="edu-card p-0 overflow-hidden shadow-sm">
    <div class="edu-card-header px-4 pt-3 pb-2 border-bottom mb-0 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="edu-card-title mb-0">
                <i class="bi bi-table me-2 text-primary"></i>Danh Sách Lớp & Môn Học Phụ Trách
            </h2>
            <span class="text-muted small">Hiển thị @Model.Assignments.Count kết quả phân công</span>
        </div>
        @if (Model.Status == "Active")
        {
            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#assignTeacherModal">
                <i class="bi bi-person-plus-fill me-1"></i> Thêm phân công mới
            </button>
        }
    </div>

    @if (Model.Assignments.Count == 0)
    {
        <div class="p-5 text-center">
            <div class="text-muted mb-3" style="font-size: 3rem;">
                <i class="bi bi-calendar-x"></i>
            </div>
            <h5 class="fw-bold text-secondary">Không tìm thấy phân công giảng dạy</h5>
            <p class="text-muted small">Hiện tại không có lớp học hay môn học nào khớp với điều kiện lọc đã chọn.</p>
            @if (Model.Status == "Active")
            {
                <button type="button" class="btn btn-primary btn-sm mt-2" data-bs-toggle="modal" data-bs-target="#assignTeacherModal">
                    <i class="bi bi-plus-circle me-1"></i> Phân công lớp & môn cho giáo viên này
                </button>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-edu m-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 45px;" class="text-center">#</th>
                        <th style="width: 170px;">Lớp học & Sĩ số</th>
                        <th>Môn học phụ trách</th>
                        <th style="width: 200px;">Học kỳ & Năm học</th>
                        <th>Thời khóa biểu (Lịch dạy)</th>
                        <th style="width: 120px;" class="text-center">Trạng thái</th>
                        <th style="width: 120px;" class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var assign in Model.Assignments)
                    {
                        <tr>
                            <td class="text-center text-muted small fw-semibold">@stt</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 fs-6 fw-bold font-monospace">
                                        @assign.ClassName
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2 text-muted small mt-1">
                                    @if (!string.IsNullOrEmpty(assign.GradeLevelName))
                                    {
                                        <span>@(assign.GradeLevelName.StartsWith("Khối", StringComparison.OrdinalIgnoreCase) ? assign.GradeLevelName : $"Khối {assign.GradeLevelName}")</span>
                                        <span>•</span>
                                    }
                                    <span><i class="bi bi-people-fill me-1"></i>@assign.StudentCount HS</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-controller="Subject" asp-action="Details" asp-route-id="@assign.SubjectId" 
                                       class="fw-bold text-primary text-decoration-none">
                                        @assign.SubjectName
                                    </a>
                                </div>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <span class="badge bg-light text-secondary border font-monospace small">
                                        @assign.SubjectCode
                                    </span>
                                    @if (assign.EvaluationType == "Score")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info border-opacity-25 small" style="font-size: 0.72rem;">
                                            Tính điểm số
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-25 small" style="font-size: 0.72rem;">
                                            Đánh giá nhận xét
                                        </span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">
                                    @assign.SemesterName
                                    @if (assign.IsActiveSemester)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success border-opacity-25 ms-1" style="font-size: 0.7rem;">
                                            Đang mở
                                        </span>
                                    }
                                </div>
                                <div class="text-muted small">Năm học @assign.AcademicYearName</div>
                            </td>
                            <td>
                                @if (assign.ScheduleDetails.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var entry in assign.ScheduleDetails)
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1 small fw-normal">
                                                <i class="bi bi-clock me-1 text-primary"></i>@entry
                                            </span>
                                        }
                                    </div>
                                    <div class="text-muted small mt-1">
                                        Tổng: <strong>@assign.ScheduledPeriodsCount</strong> tiết/tuần
                                    </div>
                                }
                                else
                                {
                                    <div class="text-warning small fst-italic">
                                        <i class="bi bi-exclamation-circle me-1"></i>Chưa xếp lịch trên thời khóa biểu
                                    </div>
                                    <a asp-controller="Timetable" asp-action="Index" 
                                       asp-route-teacherId="@Model.TeacherId" 
                                       asp-route-semesterId="@assign.SemesterId" 
                                       asp-route-editMode="true"
                                       class="btn btn-link btn-sm p-0 text-decoration-none text-primary small fw-semibold">
                                        + Xếp lịch ngay
                                    </a>
                                }
                            </td>
                            <td class="text-center">
                                @if (assign.Status == "Active" || assign.Status == "Assigned")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success border-opacity-25 px-2 py-1">
                                        Đang giảng dạy
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                        @assign.Status
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <!-- Xem sổ điểm của môn này -->
                                    <a asp-controller="Score" asp-action="SubjectMatrix" asp-route-assignmentId="@assign.AssignmentId" 
                                       class="btn btn-outline-primary px-2" title="Xem sổ điểm môn của lớp này">
                                        <i class="bi bi-journal-check"></i>
                                    </a>

                                    <!-- Xem TKB của giáo viên trong học kỳ -->
                                    <a asp-controller="Timetable" asp-action="Index" 
                                       asp-route-teacherId="@Model.TeacherId" 
                                       asp-route-semesterId="@assign.SemesterId" 
                                       asp-route-editMode="true"
                                       class="btn btn-outline-secondary px-2" title="Xếp & Xem thời khóa biểu tuần">
                                        <i class="bi bi-calendar3"></i>
                                    </a>

                                    <!-- Sửa phân công -->
                                    <button type="button" 
                                            class="btn btn-outline-secondary px-2 btn-edit-assignment"
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editAssignmentModal"
                                            data-id="@assign.AssignmentId"
                                            data-teacher-id="@Model.TeacherId"
                                            data-subject-id="@assign.SubjectId"
                                            data-class-id="@assign.ClassId"
                                            data-semester-id="@assign.SemesterId"
                                            data-status="@assign.Status"
                                            data-has-assessments="@(assign.HasAssessments.ToString().ToLower())"
                                            title="Chỉnh sửa phân công giảng dạy">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- Hủy phân công -->
                                    @if (!assign.HasAssessments)
                                    {
                                        <form asp-action="UnassignSubjectClass" method="post" class="d-inline" 
                                              onsubmit="return confirm('Bạn có chắc chắn muốn hủy phân công giáo viên này khỏi lớp @assign.ClassName môn @assign.SubjectName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="assignmentId" value="@assign.AssignmentId" />
                                            <input type="hidden" name="teacherId" value="@Model.TeacherId" />
                                            <input type="hidden" name="semesterId" value="@Model.SemesterFilter" />
                                            <button type="submit" class="btn btn-outline-danger px-2" title="Hủy phân công">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-outline-secondary px-2 disabled" title="Đã phát sinh dữ liệu bài kiểm tra/điểm số, không thể hủy">
                                            <i class="bi bi-lock-fill"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                        stt++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Phân Công Lớp & Môn Mới cho Giáo Viên -->
<div class="modal fade" id="assignTeacherModal" tabindex="-1" aria-labelledby="assignTeacherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="assignTeacherModalLabel">
                    <i class="bi bi-person-plus-fill text-primary me-2"></i>Phân Công Lớp & Môn Giảng Dạy
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AssignSubjectClass" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TeacherId" value="@Model.TeacherId" />

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">GIÁO VIÊN ĐƯỢC PHÂN CÔNG</label>
                        <div class="p-2 px-3 bg-light rounded-2 border">
                            <div class="fw-bold text-dark">@Model.FullName</div>
                            <div class="small text-muted">
                                Mã GV: <span class="font-monospace text-primary fw-bold">@Model.TeacherCode</span> • 
                                Tổ: <strong>@(Model.Specialization ?? "Chưa phân tổ")</strong>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Học Kỳ & Năm Học <span class="text-danger">*</span></label>
                        <select name="SemesterId" class="form-select" required>
                            <option value="">-- Chọn học kỳ --</option>
                            @foreach (var sem in Model.AvailableSemesters)
                            {
                                <!option value="@sem.Id" @(sem.IsActive ? "selected" : "")>
                                    @sem.SemesterName (Năm học @sem.AcademicYear) @(sem.IsActive ? " [Học kỳ hiện tại]" : "")
                                </!option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Môn Học Giảng Dạy <span class="text-danger">*</span></label>
                        <select name="SubjectId" class="form-select" required>
                            <option value="">-- Chọn môn học --</option>
                            @{
                                var specializedSubjects = Model.AvailableSubjects.Where(s => s.IsSpecialized).ToList();
                                var otherSubjects = Model.AvailableSubjects.Where(s => !s.IsSpecialized).ToList();
                            }
                            @if (specializedSubjects.Any())
                            {
                                <optgroup label="Môn đúng chuyên môn (@Model.Specialization)">
                                    @foreach (var sub in specializedSubjects)
                                    {
                                        <option value="@sub.Id">@sub.SubjectCode - @sub.SubjectName</option>
                                    }
                                </optgroup>
                            }
                            <optgroup label="Tất cả các môn học khác">
                                @foreach (var sub in otherSubjects)
                                {
                                    <option value="@sub.Id">@sub.SubjectCode - @sub.SubjectName</option>
                                }
                            </optgroup>
                        </select>
                        <div class="form-text small">Hệ thống đã nhóm các môn ưu tiên theo Tổ chuyên môn của giáo viên.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Lớp Học Phụ Trách <span class="text-danger">*</span></label>
                        <select name="ClassId" class="form-select" required>
                            <option value="">-- Chọn lớp học --</option>
                            @foreach (var cls in Model.AvailableClasses)
                            {
                                <option value="@cls.Id">Lớp @cls.ClassName (@cls.GradeLevelName - Năm học @cls.AcademicYear)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Trạng Thái Phân Công</label>
                        <select name="Status" class="form-select">
                            <option value="Active" selected>Đang giảng dạy (Active)</option>
                            <option value="Assigned">Đã phân công (Assigned)</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-check-circle-fill me-1"></i> Lưu Phân Công
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Chỉnh Sửa Phân Công -->
<div class="modal fade" id="editAssignmentModal" tabindex="-1" aria-labelledby="editAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark" id="editAssignmentModalLabel">
                    <i class="bi bi-pencil-square text-warning me-2"></i>Cập Nhật Phân Công Giảng Dạy
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateSubjectClass" method="post" id="editAssignmentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssignmentId" id="editAssignmentId" />
                <input type="hidden" name="TeacherId" id="editTeacherId" value="@Model.TeacherId" />
                <input type="hidden" name="SubjectId" id="editHiddenSubjectId" />
                <input type="hidden" name="ClassId" id="editHiddenClassId" />
                <input type="hidden" name="SemesterId" id="editHiddenSemesterId" />

                <div class="modal-body p-4">
                    <div id="editLockedWarning" class="alert alert-warning small d-none mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        <strong>Lưu ý:</strong> Phân công này đã phát sinh điểm số/bài kiểm tra. Môn học, Lớp học và Học kỳ được cố định để bảo toàn dữ liệu. Bạn có thể cập nhật trạng thái giảng dạy.
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Giáo Viên Phụ Trách</label>
                        <input type="text" class="form-control bg-light" value="@Model.FullName (@Model.TeacherCode)" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Học Kỳ & Năm Học <span class="text-danger">*</span></label>
                        <select id="editSemesterId" class="form-select" required>
                            <option value="">-- Chọn học kỳ --</option>
                            @foreach (var sem in Model.AvailableSemesters)
                            {
                                <option value="@sem.Id">
                                    @sem.SemesterName (Năm học @sem.AcademicYear) @(sem.IsActive ? " [Học kỳ hiện tại]" : "")
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Môn Học Giảng Dạy <span class="text-danger">*</span></label>
                        <select id="editSubjectId" class="form-select" required>
                            <option value="">-- Chọn môn học --</option>
                            @foreach (var sub in Model.AvailableSubjects)
                            {
                                <option value="@sub.Id">@sub.SubjectCode - @sub.SubjectName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Lớp Học Phụ Trách <span class="text-danger">*</span></label>
                        <select id="editClassId" class="form-select" required>
                            <option value="">-- Chọn lớp học --</option>
                            @foreach (var cls in Model.AvailableClasses)
                            {
                                <option value="@cls.Id">Lớp @cls.ClassName (@cls.GradeLevelName - Năm học @cls.AcademicYear)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Trạng Thái Phân Công</label>
                        <select name="Status" id="editStatus" class="form-select">
                            <option value="Active">Đang giảng dạy (Active)</option>
                            <option value="Assigned">Đã phân công (Assigned)</option>
                            <option value="Completed">Hoàn thành (Completed)</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark">
                        <i class="bi bi-check-circle-fill me-1"></i> Lưu Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editButtons = document.querySelectorAll('.btn-edit-assignment');
            const editId = document.getElementById('editAssignmentId');
            const editSemester = document.getElementById('editSemesterId');
            const editSubject = document.getElementById('editSubjectId');
            const editClass = document.getElementById('editClassId');
            const editStatus = document.getElementById('editStatus');
            const hiddenSemester = document.getElementById('editHiddenSemesterId');
            const hiddenSubject = document.getElementById('editHiddenSubjectId');
            const hiddenClass = document.getElementById('editHiddenClassId');
            const lockedWarning = document.getElementById('editLockedWarning');

            function syncHiddenInputs() {
                hiddenSemester.value = editSemester.value;
                hiddenSubject.value = editSubject.value;
                hiddenClass.value = editClass.value;
            }

            editSemester.addEventListener('change', syncHiddenInputs);
            editSubject.addEventListener('change', syncHiddenInputs);
            editClass.addEventListener('change', syncHiddenInputs);

            editButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const subjectId = this.getAttribute('data-subject-id');
                    const classId = this.getAttribute('data-class-id');
                    const semesterId = this.getAttribute('data-semester-id');
                    const status = this.getAttribute('data-status');
                    const hasAssessments = this.getAttribute('data-has-assessments') === 'true';

                    editId.value = id;
                    editSemester.value = semesterId;
                    editSubject.value = subjectId;
                    editClass.value = classId;
                    editStatus.value = status || 'Active';

                    syncHiddenInputs();

                    if (hasAssessments) {
                        editSemester.disabled = true;
                        editSubject.disabled = true;
                        editClass.disabled = true;
                        lockedWarning.classList.remove('d-none');
                    } else {
                        editSemester.disabled = false;
                        editSubject.disabled = false;
                        editClass.disabled = false;
                        lockedWarning.classList.add('d-none');
                    }
                });
            });
        });
    </script>
}
