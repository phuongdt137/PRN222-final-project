@model HighSchoolManagementSystem.MVC.Models.ViewModels.Profile.UpdateProfileViewModel
@{
    ViewData["Title"] = "Cập Nhật Hồ Sơ";
    string roleDisplayVi = Model.RoleName switch
    {
        "Principal" => "HIỆU TRƯỞNG",
        "Staff" => "GIÁO VỤ / NHÂN VIÊN",
        "Teacher" => "GIÁO VIÊN",
        "Student" => "HỌC SINH",
        "Parent" => "PHỤ HUYNH",
        _ => Model.RoleName.ToUpper()
    };
}

<!-- Greeting Banner EIMS Standard -->
<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-pencil-square me-1"></i> CẬP NHẬT THÔNG TIN
        </span>
        <h1 class="greeting-title">Chỉnh Sửa Hồ Sơ Cá Nhân</h1>
        <p class="greeting-subtitle">
            Cập nhật các thông tin liên lạc và ảnh đại diện được phép thay đổi trong hệ thống.
        </p>
    </div>
    <div class="live-clock-card">
        <div class="clock-info text-end">
            <div class="clock-date" id="liveClockDate">Đang đồng bộ...</div>
            <div class="clock-time" id="liveClockTime">--:--:--</div>
        </div>
        <div class="clock-icon-box">
            <i class="bi bi-person-gear"></i>
        </div>
    </div>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

    <div class="row g-4">
        <!-- CỘT TRÁI: AVATAR & UPLOAD -->
        <div class="col-12 col-lg-4">
            <div class="edu-card text-center mb-4">
                <div class="edu-card-header justify-content-center">
                    <h2 class="edu-card-title">
                        <i class="bi bi-camera-fill text-primary me-2"></i>Ảnh Đại Diện
                    </h2>
                </div>

                <div class="d-flex justify-content-center my-3">
                    <div class="position-relative" style="width: 140px; height: 140px;">
                        <img id="avatarPreviewImg" 
                             src="@(!string.IsNullOrEmpty(Model.AvatarUrl) ? Model.AvatarUrl : "/images/default-avatar.png")" 
                             alt="Avatar Preview" 
                             class="rounded-circle shadow-sm @(string.IsNullOrEmpty(Model.AvatarUrl) ? "d-none" : "")"
                             style="width: 140px; height: 140px; object-fit: cover; border: 3px solid var(--tufts-blue-300);" />

                        <div id="avatarFallbackBox" 
                             class="user-avatar-large shadow-sm d-flex align-items-center justify-content-center @(!string.IsNullOrEmpty(Model.AvatarUrl) ? "d-none" : "")"
                             style="width: 140px; height: 140px; border-radius: 50%; background-color: var(--tufts-blue-800); color: #fff; font-size: 56px; font-weight: 700; border: 3px solid var(--tufts-blue-300);">
                            @(string.IsNullOrWhiteSpace(Model.FullName) ? "U" : Model.FullName.Trim().Substring(0, 1).ToUpper())
                        </div>
                    </div>
                </div>

                <div class="mb-3 text-start">
                    <label asp-for="AvatarFile" class="form-label">Chọn ảnh từ thiết bị</label>
                    <input asp-for="AvatarFile" type="file" class="form-control" id="avatarFileInput" accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                    <div class="form-text small mt-1">
                        Định dạng: JPG, PNG, WEBP. Kích thước tối đa: 2MB.
                    </div>
                </div>
            </div>

            <!-- Bảng ghi chú quy định -->
            <div class="edu-card bg-light">
                <h3 class="h6 fw-bold mb-2" style="color: var(--tufts-blue-900);">
                    <i class="bi bi-info-circle-fill text-primary me-1"></i> Quy định hồ sơ
                </h3>
                <ul class="text-muted small ps-3 mb-0" style="line-height: 1.6;">
                    <li>Họ tên và Email được cố định theo hồ sơ nhập học / tuyển dụng.</li>
                    <li>Để thay đổi Họ tên hoặc Email, vui lòng liên hệ Ban Giám Hiệu hoặc Phòng Giáo Vụ.</li>
                    <li>Số điện thoại dùng để nhận các thông báo khẩn cấp từ nhà trường.</li>
                </ul>
            </div>
        </div>

        <!-- CỘT PHẢI: FORM CHỈNH SỬA & TRƯỜNG THÔNG TIN -->
        <div class="col-12 col-lg-8">
            <div class="edu-card mb-4">
                <div class="edu-card-header">
                    <h2 class="edu-card-title">
                        <i class="bi bi-sliders text-primary me-2"></i>Thông Tin Được Phép Thay Đổi
                    </h2>
                    <span class="badge-status badge-status-info">Quyền: @roleDisplayVi</span>
                </div>

                <!-- 1. CÁC TRƯỜNG CHO PHÉP SỬA -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6">
                        <label asp-for="PhoneNumber" class="form-label">
                            <i class="bi bi-telephone text-primary me-1"></i>Số điện thoại cá nhân
                        </label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="Gender" class="form-label">
                            <i class="bi bi-gender-ambiguous text-primary me-1"></i>Giới tính
                        </label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">-- Chưa chọn giới tính --</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="DateOfBirth" class="form-label">
                            <i class="bi bi-calendar-date text-primary me-1"></i>Ngày sinh
                        </label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                </div>

                <div class="edu-card-header mt-2 mb-3">
                    <h2 class="edu-card-title text-muted" style="font-size: 14.5px;">
                        <i class="bi bi-lock-fill me-1"></i>Thông Tin Cố Định (Chỉ Xem)
                    </h2>
                </div>

                <!-- 2. CÁC TRƯỜNG READ-ONLY (KHÔNG CHO PHÉP SỬA) -->
                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted">Họ và tên</label>
                        <input type="text" class="form-control bg-light" value="@Model.FullName" readonly disabled />
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted">Tên đăng nhập (Username)</label>
                        <input type="text" class="form-control bg-light" value="@Model.Username" readonly disabled />
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted">Địa chỉ Email</label>
                        <input type="text" class="form-control bg-light" value="@Model.Email" readonly disabled />
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label text-muted">Vai trò trong trường</label>
                        <input type="text" class="form-control bg-light" value="@roleDisplayVi" readonly disabled />
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 pt-3" style="border-top: 1px solid var(--color-border);">
                    <button type="submit" class="btn btn-action-save">
                        <i class="bi bi-check2-circle"></i> Lưu Thay Đổi
                    </button>
                    <a asp-action="Index" class="btn btn-action-cancel">
                        <i class="bi bi-arrow-left"></i> Quay lại hồ sơ
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const avatarInput = document.getElementById('avatarFileInput');
            const previewImg = document.getElementById('avatarPreviewImg');
            const fallbackBox = document.getElementById('avatarFallbackBox');

            if (!avatarInput || !previewImg) return;

            avatarInput.addEventListener('change', function (e) {
                const file = e.target.files && e.target.files[0];
                if (!file) return;

                // Kiểm tra loại file cơ bản tại client
                if (!file.type.match('image.*')) {
                    alert('Vui lòng chỉ chọn tệp hình ảnh (.jpg, .jpeg, .png, .webp).');
                    avatarInput.value = '';
                    return;
                }

                // Kiểm tra dung lượng 2MB
                if (file.size > 2 * 1024 * 1024) {
                    alert('Kích thước ảnh không được vượt quá 2MB.');
                    avatarInput.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (evt) {
                    previewImg.src = evt.target.result;
                    previewImg.classList.remove('d-none');
                    if (fallbackBox) {
                        fallbackBox.classList.add('d-none');
                    }
                };
                reader.readAsDataURL(file);
            });
        });
    </script>
}
