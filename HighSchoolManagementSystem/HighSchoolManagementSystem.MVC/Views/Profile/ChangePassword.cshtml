@model HighSchoolManagementSystem.MVC.Models.ViewModels.Profile.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<!-- Greeting Banner EIMS Standard -->
<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-shield-lock-fill me-1"></i> BẢO MẬT TÀI KHOẢN
        </span>
        <h1 class="greeting-title">Đổi Mật Khẩu</h1>
        <p class="greeting-subtitle">
            Cập nhật mật khẩu định kỳ để nâng cao tính an toàn và bảo mật cho tài khoản của bạn.
        </p>
    </div>
    <div class="live-clock-card">
        <div class="clock-info text-end">
            <div class="clock-date" id="liveClockDate">Đang đồng bộ...</div>
            <div class="clock-time" id="liveClockTime">--:--:--</div>
        </div>
        <div class="clock-icon-box">
            <i class="bi bi-key"></i>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- CỘT TRÁI: QUY ĐỊNH BẢO MẬT & HƯỚNG DẪN -->
    <div class="col-12 col-lg-4">
        <div class="edu-card mb-4">
            <div class="edu-card-header">
                <h2 class="edu-card-title">
                    <i class="bi bi-shield-check text-primary me-2"></i>Quy Định Mật Khẩu
                </h2>
            </div>

            <ul class="text-muted small ps-3 mb-0" style="line-height: 1.8;">
                <li>Mật khẩu mới phải có <strong>tối thiểu 6 ký tự</strong>.</li>
                <li>Mật khẩu mới <strong>không được trùng</strong> với mật khẩu hiện tại.</li>
                <li>Nên kết hợp chữ hoa, chữ thường và chữ số để tăng độ an toàn.</li>
                <li>Không chia sẻ thông tin đăng nhập cho bất kỳ ai khác.</li>
            </ul>
        </div>
    </div>

    <!-- CỘT PHẢI: FORM ĐỔI MẬT KHẨU -->
    <div class="col-12 col-lg-8">
        <div class="edu-card mb-4">
            <div class="edu-card-header">
                <h2 class="edu-card-title">
                    <i class="bi bi-lock-fill text-primary me-2"></i>Thiết Lập Mật Khẩu Mới
                </h2>
                <span class="text-muted small">Cập nhật trực tiếp vào hệ thống</span>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2" 
                     style="font-size: 13.5px; border-radius: 6px; border: 1px solid var(--status-danger-border); background-color: var(--status-danger-bg); color: var(--status-danger-text);" 
                     role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form asp-action="ChangePassword" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">
                        <i class="bi bi-shield-lock text-primary me-1"></i>Mật khẩu hiện tại
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 6px 0 0 6px; border-color: var(--color-border-strong);">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="CurrentPassword" type="password" id="currentPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Nhập mật khẩu bạn đang sử dụng..." autofocus />
                        <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn" data-target="currentPasswordInput" style="border-color: var(--color-border-strong); border-radius: 0 6px 6px 0;" tabindex="-1">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-12 col-sm-6">
                        <label asp-for="NewPassword" class="form-label">
                            <i class="bi bi-key text-primary me-1"></i>Mật khẩu mới
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 6px 0 0 6px; border-color: var(--color-border-strong);">
                                <i class="bi bi-key-fill"></i>
                            </span>
                            <input asp-for="NewPassword" type="password" id="newPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Tối thiểu 6 ký tự..." />
                            <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn" data-target="newPasswordInput" style="border-color: var(--color-border-strong); border-radius: 0 6px 6px 0;" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="bi bi-check-circle text-primary me-1"></i>Xác nhận mật khẩu mới
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 6px 0 0 6px; border-color: var(--color-border-strong);">
                                <i class="bi bi-shield-check"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control border-start-0 border-end-0" placeholder="Nhập lại mật khẩu mới..." />
                            <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password-btn" data-target="confirmPasswordInput" style="border-color: var(--color-border-strong); border-radius: 0 6px 6px 0;" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 pt-3" style="border-top: 1px solid var(--color-border);">
                    <button type="submit" class="btn btn-action-save">
                        <i class="bi bi-check2-circle"></i> Xác Nhận Đổi Mật Khẩu
                    </button>
                    <a asp-action="Index" class="btn btn-action-cancel">
                        <i class="bi bi-arrow-left"></i> Quay lại hồ sơ
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.toggle-password-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const targetId = this.getAttribute('data-target');
                    const input = document.getElementById(targetId);
                    const icon = this.querySelector('i');
                    if (!input || !icon) return;

                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    }
                });
            });
        });
    </script>
}
