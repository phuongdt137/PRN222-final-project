@{
    ViewData["Title"] = "High School Management System";
    ViewData["HideNav"] = true;
}

<div class="portal-landing-wrapper">
    <div class="portal-card">
        <div class="portal-logo-container">
            <img src="~/images/logo.png" alt="Logo Hệ thống Quản lý Trường THPT" class="portal-logo" />
        </div>
        <span class="portal-kicker">HỆ THỐNG QUẢN LÝ TRƯỜNG THPT</span>
        <h1 class="portal-title">High School Management System</h1>
        <p class="portal-description">
            Nền tảng quản lý và kết nối thông tin nhà trường trong một không gian thống nhất.
        </p>
        <div class="portal-action-container">
            <a asp-controller="Auth" asp-action="Login" class="btn btn-primary portal-btn">
                <span>Đăng nhập</span>
                <span class="portal-btn-arrow">&rarr;</span>
            </a>
        </div>
    </div>
</div>

