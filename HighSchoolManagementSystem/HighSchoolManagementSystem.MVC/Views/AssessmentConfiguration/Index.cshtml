@model HighSchoolManagementSystem.MVC.Models.ViewModels.Assessment.AssessmentConfigurationViewModel
@{ ViewData["Title"] = "Cấu hình đánh giá"; }
<div class="greeting-banner mb-4"><div class="greeting-text-wrap"><span class="greeting-kicker">QUẢN LÝ ĐÀO TẠO</span><h1 class="greeting-title">Cấu hình đánh giá</h1></div></div>
@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"] != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }
<div class="card-table-wrap"><div class="card-table-header"><div><h2 class="table-card-title">Loại đánh giá</h2></div><a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Thêm loại đánh giá</a></div><div class="table-responsive"><table class="table-edu mb-0"><thead><tr><th>Mã</th><th>Tên loại</th><th>Trọng số</th><th>Số lần</th><th>Khoảng điểm</th><th>Đang sử dụng</th><th class="text-center">Thao tác</th></tr></thead><tbody>@if(Model.Items.Count==0){<tr><td colspan="7" class="text-center text-muted py-4">Chưa có cấu hình đánh giá.</td></tr>}else{foreach(var item in Model.Items){<tr><td><strong>@item.TypeCode</strong></td><td>@item.TypeName</td><td>@item.Weight.ToString("0.##")%</td><td>@item.MinEntries - @item.MaxEntries</td><td>@item.MinScore.ToString("0.##") - @item.MaxScore.ToString("0.##")</td><td>@item.AssessmentCount</td><td class="text-center"><div class="d-inline-flex gap-2"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm" title="Sửa"><i class="bi bi-pencil-square"></i></a><form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa loại đánh giá này?');"><button class="btn btn-outline-danger btn-sm" title="Xóa"><i class="bi bi-trash"></i></button></form></div></td></tr>}}</tbody></table></div></div>
