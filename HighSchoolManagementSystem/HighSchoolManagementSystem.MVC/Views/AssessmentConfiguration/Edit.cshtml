@model HighSchoolManagementSystem.MVC.Models.ViewModels.Assessment.AssessmentConfigurationEditViewModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Cập nhật loại đánh giá" : "Thêm loại đánh giá"; }
<div class="greeting-banner mb-4"><div class="greeting-text-wrap"><span class="greeting-kicker">QUẢN LÝ ĐÀO TẠO</span><h1 class="greeting-title">@ViewData["Title"]</h1></div></div>
<div class="edu-card p-4"><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
<div class="col-md-4"><label asp-for="TypeCode" class="form-label">Mã loại đánh giá</label><input asp-for="TypeCode" class="form-control" /><span asp-validation-for="TypeCode" class="text-danger"></span></div>
<div class="col-md-8"><label asp-for="TypeName" class="form-label">Tên loại đánh giá</label><input asp-for="TypeName" class="form-control" /><span asp-validation-for="TypeName" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="Weight" class="form-label">Trọng số (%)</label><input asp-for="Weight" class="form-control" min="0.01" max="100" step="0.01" /><span asp-validation-for="Weight" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="MinEntries" class="form-label">Số lần tối thiểu</label><input asp-for="MinEntries" class="form-control" min="0" max="100" /><span asp-validation-for="MinEntries" class="text-danger"></span></div>
<div class="col-md-4"><label asp-for="MaxEntries" class="form-label">Số lần tối đa</label><input asp-for="MaxEntries" class="form-control" min="0" max="100" /><span asp-validation-for="MaxEntries" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="MinScore" class="form-label">Điểm tối thiểu</label><input asp-for="MinScore" class="form-control" min="0" max="10" step="0.01" /><span asp-validation-for="MinScore" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="MaxScore" class="form-label">Điểm tối đa</label><input asp-for="MaxScore" class="form-control" min="0" max="10" step="0.01" /><span asp-validation-for="MaxScore" class="text-danger"></span></div>
</div><div class="mt-4 d-flex gap-3"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu</button><a asp-action="Index" class="btn btn-secondary">Quay lại</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
