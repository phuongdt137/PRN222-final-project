@model HighSchoolManagementSystem.MVC.Models.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["HideNav"] = true;
}

<div class="portal-landing-wrapper">
    <div class="portal-card" style="max-width: 460px; text-align: left;">
        <div class="portal-logo-container text-center mb-3">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="Logo Hệ thống Quản lý Trường THPT" class="portal-logo" style="width: 68px; height: 68px;" />
            </a>
        </div>
        
        <div class="text-center mb-4">
            <span class="portal-kicker">HỆ THỐNG QUẢN LÝ TRƯỜNG THPT</span>
            <h1 class="portal-title" style="font-size: 24px; margin-bottom: 6px;">Quên Mật Khẩu</h1>
            <p class="portal-description" style="margin-bottom: 0; font-size: 13.5px;">
                Nhập địa chỉ email liên kết với tài khoản để nhận liên kết đặt lại mật khẩu.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage as string))
        {
            <div class="alert alert-success py-2 px-3 mb-3 d-flex align-items-start gap-2" 
                 style="font-size: 13.5px; border-radius: 6px; border: 1px solid var(--status-success-border); background-color: var(--status-success-bg); color: var(--status-success-text);" 
                 role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0 mt-1"></i>
                <div>
                    <strong>Thành công!</strong> @ViewBag.SuccessMessage
                    @if (!string.IsNullOrEmpty(ViewBag.WarningMessage as string))
                    {
                        <div class="mt-2 pt-2 border-top border-warning small text-dark">
                            <i class="bi bi-info-circle me-1"></i> @ViewBag.WarningMessage
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4 pt-3 text-center border-top" style="border-color: var(--color-border);">
                <a asp-action="Login" class="btn btn-primary w-100 py-2" style="font-size: 14.5px; font-weight: 600;">
                    <i class="bi bi-box-arrow-in-left me-1"></i> Quay lại Đăng Nhập
                </a>
            </div>
        }
        else
        {
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2" 
                     style="font-size: 13.5px; border-radius: 6px; border: 1px solid var(--status-danger-border); background-color: var(--status-danger-bg); color: var(--status-danger-text);" 
                     role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <form asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email tài khoản</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 6px 0 0 6px; border-color: var(--color-border-strong);">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" class="form-control border-start-0" placeholder="Ví dụ: hoten@highschool.edu.vn" style="border-radius: 0 6px 6px 0;" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 mt-2" style="font-size: 14.5px; font-weight: 600;">
                    <i class="bi bi-send me-1"></i> Gửi Yêu Cầu Khôi Phục
                </button>

                <div class="mt-4 pt-3 text-center border-top" style="border-color: var(--color-border);">
                    <a asp-action="Login" class="text-muted text-decoration-none" style="font-size: 13px;">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại đăng nhập
                    </a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
