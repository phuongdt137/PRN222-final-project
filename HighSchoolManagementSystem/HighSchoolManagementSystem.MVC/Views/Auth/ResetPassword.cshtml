@model HighSchoolManagementSystem.MVC.Models.ViewModels.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["HideNav"] = true;
}

<div class="portal-landing-wrapper">
    <div class="portal-card" style="max-width: 460px; text-align: left;">
        <div class="portal-logo-container text-center mb-3">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="Logo Hệ thống Quản lý Trường THPT" class="portal-logo" style="width: 68px; height: 68px;" />
            </a>
        </div>
        
        <div class="text-center mb-4">
            <span class="portal-kicker">HỆ THỐNG QUẢN LÝ TRƯỜNG THPT</span>
            <h1 class="portal-title" style="font-size: 24px; margin-bottom: 6px;">Đặt Lại Mật Khẩu</h1>
            <p class="portal-description" style="margin-bottom: 0; font-size: 13.5px;">
                Vui lòng nhập mật khẩu mới để hoàn tất việc khôi phục tài khoản.
            </p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2" 
                 style="font-size: 13.5px; border-radius: 6px; border: 1px solid var(--status-danger-border); background-color: var(--status-danger-bg); color: var(--status-danger-text);" 
                 role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <div class="p-2 mb-3 bg-light rounded text-center small text-muted" style="border: 1px solid var(--color-border);">
            Đang đặt lại mật khẩu cho: <strong class="text-dark">@Model.Email</strong>
        </div>

        <form asp-action="ResetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 6px 0 0 6px; border-color: var(--color-border-strong);">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                    <input asp-for="NewPassword" class="form-control border-start-0" placeholder="Tối thiểu 6 ký tự..." style="border-radius: 0 6px 6px 0;" autofocus />
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 6px 0 0 6px; border-color: var(--color-border-strong);">
                        <i class="bi bi-check-circle"></i>
                    </span>
                    <input asp-for="ConfirmPassword" class="form-control border-start-0" placeholder="Nhập lại mật khẩu mới..." style="border-radius: 0 6px 6px 0;" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 mt-2" style="font-size: 14.5px; font-weight: 600;">
                <i class="bi bi-check2-circle me-1"></i> Lưu Mật Khẩu Mới
            </button>

            <div class="mt-4 pt-3 text-center border-top" style="border-color: var(--color-border);">
                <a asp-action="Login" class="text-muted text-decoration-none" style="font-size: 13px;">
                    <i class="bi bi-arrow-left me-1"></i> Hủy bỏ và quay lại đăng nhập
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
