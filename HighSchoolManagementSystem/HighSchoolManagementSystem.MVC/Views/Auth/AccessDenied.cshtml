@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="edu-card text-center py-5 px-4">
                <div class="mb-3">
                    <span class="d-inline-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background-color: var(--status-danger-bg); color: var(--status-danger-text); font-size: 30px;">
                        <i class="bi bi-shield-x"></i>
                    </span>
                </div>
                <h2 class="h4 fw-bold text-danger mb-2">Từ chối truy cập</h2>
                <p class="text-muted mb-4" style="font-size: 14px;">
                    Tài khoản của bạn không có đủ thẩm quyền để truy cập vào phân hệ hoặc tài nguyên này.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="bi bi-house me-1"></i> Trang chủ
                    </a>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Đổi tài khoản khác
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>