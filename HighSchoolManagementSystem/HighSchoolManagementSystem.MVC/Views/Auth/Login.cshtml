@model HighSchoolManagementSystem.MVC.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    ViewData["HideNav"] = true;
}

<div class="portal-landing-wrapper">
    <div class="portal-card" style="max-width: 460px; text-align: left;">
        <div class="portal-logo-container text-center mb-3">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="Logo Hệ thống Quản lý Trường THPT" class="portal-logo" style="width: 68px; height: 68px;" />
            </a>
        </div>
        
        <div class="text-center mb-4">
            <span class="portal-kicker">HỆ THỐNG QUẢN LÝ TRƯỜNG THPT</span>
            <h1 class="portal-title" style="font-size: 24px; margin-bottom: 6px;">Đăng Nhập</h1>
            <p class="portal-description" style="margin-bottom: 0; font-size: 13.5px;">
                Nhập thông tin tài khoản để truy cập hệ thống quản lý.
            </p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 px-3 mb-3 d-flex align-items-center gap-2" style="font-size: 13.5px; border-radius: 6px; border: 1px solid var(--status-success-border); background-color: var(--status-success-bg); color: var(--status-success-text);" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                <div>@TempData["SuccessMessage"]</div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2" style="font-size: 13.5px; border-radius: 6px; border: 1px solid var(--status-danger-border); background-color: var(--status-danger-bg); color: var(--status-danger-text);" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>@TempData["ErrorMessage"]</div>
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 d-flex align-items-center gap-2" style="font-size: 13.5px; border-radius: 6px; border: 1px solid var(--status-danger-border); background-color: var(--status-danger-bg); color: var(--status-danger-text);" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-controller="Auth" asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="UsernameOrEmail" class="form-label">Tên đăng nhập hoặc Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 6px 0 0 6px; border-color: var(--color-border-strong);">
                        <i class="bi bi-person"></i>
                    </span>
                    <input asp-for="UsernameOrEmail" class="form-control border-start-0" placeholder="Ví dụ: principal, teacher, student..." style="border-radius: 0 6px 6px 0;" autofocus />
                </div>
                <span asp-validation-for="UsernameOrEmail" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0" style="border-radius: 6px 0 0 6px; border-color: var(--color-border-strong);">
                        <i class="bi bi-shield-lock"></i>
                    </span>
                    <input asp-for="Password" class="form-control border-start-0" placeholder="Nhập mật khẩu của bạn..." style="border-radius: 0 6px 6px 0;" />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4" style="font-size: 13.5px;">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" style="border-radius: 4px;" />
                    <label asp-for="RememberMe" class="form-check-label text-muted">Ghi nhớ đăng nhập</label>
                </div>
                <a asp-action="ForgotPassword" class="text-decoration-none fw-semibold" style="color: var(--tufts-blue-800); font-size: 13px;">
                    Quên mật khẩu?
                </a>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2" style="font-size: 14.5px; font-weight: 600;">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
            </button>

            <div class="mt-4 pt-3 text-center border-top" style="border-color: var(--color-border);">
                <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none" style="font-size: 13px;">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
