@model HighSchoolManagementSystem.Services.DTOs.CreateBroadcastNotificationDto
@{
    ViewData["Title"] = "Soạn & Phát Thông Báo";
    var classes = ViewBag.Classes as List<HighSchoolManagementSystem.Models.Entities.Class> ?? new();
}

<div style="max-width: 980px;">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-megaphone-fill text-primary me-2"></i>Soạn & Phát Thông Báo
            </h1>
            <p class="text-muted mb-0 small">
                Gửi thông báo học vụ, lịch sinh hoạt, cảnh báo nề nếp tới các nhóm đối tượng trong nhà trường.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i>Danh sách thông báo
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Any() == true)
    {
        <div class="alert alert-danger shadow-sm alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewData.ModelState[""]?.Errors.First().ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Target Audience -->
                <div class="mb-3">
                    <label asp-for="TargetAudience" class="form-label fw-semibold text-dark">
                        Nhóm đối tượng nhận thông báo <span class="text-danger">*</span>
                    </label>
                    <select asp-for="TargetAudience" class="form-select">
                        <optgroup label="Toàn trường & Phân hệ">
                            <option value="All">Toàn trường (Tất cả Giáo viên, Học sinh, Phụ huynh, Giáo vụ)</option>
                            <option value="Teacher">Tất cả Giáo viên bộ môn & Chủ nhiệm</option>
                            <option value="Student">Tất cả Học sinh toàn trường</option>
                            <option value="Parent">Tất cả Phụ huynh học sinh</option>
                            <option value="Staff">Bộ phận Cán bộ Giáo vụ / Nhân viên</option>
                        </optgroup>
                        @if (classes.Any())
                        {
                            <optgroup label="Theo Lớp học cụ thể (Bao gồm Học sinh & Phụ huynh)">
                                @foreach (var c in classes)
                                {
                                    <option value="Class_@c.Id">Lớp @c.ClassName (Học sinh & Phụ huynh)</option>
                                }
                            </optgroup>
                        }
                    </select>
                    <span asp-validation-for="TargetAudience" class="text-danger small"></span>
                </div>

                <!-- Title -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold text-dark">
                        Tiêu đề thông báo <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Title" class="form-control" placeholder="Ví dụ: Lịch sinh hoạt đầu tuần / Thông báo kiểm tra định kỳ..." maxlength="100" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                    <div class="form-text small">Tối đa 100 ký tự.</div>
                </div>

                <!-- Content -->
                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-semibold text-dark">
                        Nội dung thông báo <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Content" class="form-control" rows="5" placeholder="Nhập chi tiết nội dung cần thông báo tới người nhận..." maxlength="1000"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                    <div class="form-text small">Tối đa 1000 ký tự. Hỗ trợ xuống dòng để định dạng văn bản rõ ràng.</div>
                </div>

                <!-- Send Email Option -->
                <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                    <div class="form-check form-switch mb-0">
                        <input asp-for="SendEmail" class="form-check-input" type="checkbox" id="checkSendEmail" />
                        <label class="form-check-label fw-semibold text-dark ms-1" for="checkSendEmail">
                            <i class="bi bi-envelope-paper-fill text-primary me-1"></i> Đồng thời gửi Email thông báo tới hòm thư người nhận
                        </label>
                        <p class="text-muted small mb-0 mt-1 ms-4">
                            Hệ thống sẽ gửi email HTML thông báo trực tiếp đến các tài khoản có địa chỉ email hợp lệ.
                        </p>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-send-fill me-1"></i>Phát thông báo ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
