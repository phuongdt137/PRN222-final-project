@model HighSchoolManagementSystem.MVC.Models.ViewModels.Conduct.ConductBulkEntryViewModel
@{
    ViewData["Title"] = "Đánh Giá Hạnh Kiểm Cả Lớp";
}

<!-- Greeting Banner EIMS Standard -->
<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-pencil-square me-1"></i> ĐÁNH GIÁ HÀNG LOẠT • LỚP CHỦ NHIỆM
        </span>
        <h1 class="greeting-title">Đánh Giá Hạnh Kiểm - Lớp @Model.ClassName</h1>
        <p class="greeting-subtitle">
            Học kỳ: <strong>@Model.SemesterName</strong> • Năm học: <strong>@Model.AcademicYearCode</strong> • GVCN: <strong>@Model.HomeroomTeacherName</strong>
        </p>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" asp-action="SaveBulk" id="bulkForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ClassId" />
    <input type="hidden" asp-for="SemesterId" />
    <input type="hidden" asp-for="ClassName" />
    <input type="hidden" asp-for="SemesterName" />
    <input type="hidden" asp-for="AcademicYearCode" />
    <input type="hidden" asp-for="HomeroomTeacherName" />

    <!-- Thanh công cụ tiện ích nhanh -->
    <div class="edu-card p-3 mb-3 bg-light bg-opacity-75 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="small fw-bold text-secondary me-1"><i class="bi bi-lightning-charge-fill text-warning"></i> Thao tác nhanh:</span>
            <button type="button" class="btn btn-sm btn-outline-success" onclick="applyAllGrades('Tốt')">
                <i class="bi bi-check-all"></i> Chọn tất cả là "Tốt"
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="applyAllGrades('Khá')">
                <i class="bi bi-check-all"></i> Chọn tất cả là "Khá"
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="applyDefaultComments()">
                <i class="bi bi-chat-left-text"></i> Gán nhận xét mẫu tự động
            </button>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" asp-route-classId="@Model.ClassId" asp-route-semesterId="@Model.SemesterId" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <button type="submit" class="btn btn-sm btn-primary px-3 shadow-sm" id="btnSubmitBulk">
                <i class="bi bi-save me-1"></i> Lưu Bảng Đánh Giá Lớp
            </button>
        </div>
    </div>

    <!-- Bảng nhập liệu hàng loạt -->
    <div class="edu-card p-0 mb-4 overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 45px;">STT</th>
                        <th style="width: 110px;">Mã HS</th>
                        <th style="width: 190px;">Họ và tên</th>
                        <th class="text-center" style="width: 80px;">ĐTB HK</th>
                        <th class="text-center" style="width: 130px;">Chuyên cần</th>
                        <th style="width: 160px;">Xếp loại hạnh kiểm <span class="text-danger">*</span></th>
                        <th>Nhận xét của Giáo viên chủ nhiệm</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Students.Count; i++)
                    {
                        var st = Model.Students[i];
                        <tr>
                            <td class="text-center text-muted small">
                                @(i + 1)
                                <input type="hidden" asp-for="Students[i].StudentId" />
                                <input type="hidden" asp-for="Students[i].StudentCode" />
                                <input type="hidden" asp-for="Students[i].FullName" />
                            </td>
                            <td><span class="badge bg-light text-dark border">@st.StudentCode</span></td>
                            <td>
                                <div class="fw-semibold text-dark">@st.FullName</div>
                                <div class="text-muted" style="font-size: 11px;">
                                    @(st.DateOfBirth.HasValue ? st.DateOfBirth.Value.ToString("dd/MM/yyyy") : "") • @st.Gender
                                </div>
                            </td>
                            <td class="text-center">
                                @if (st.Gpa.HasValue)
                                {
                                    <span class="badge bg-light text-dark fw-bold border">@st.Gpa.Value.ToString("0.0")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">--</span>
                                }
                            </td>
                            <td class="text-center small">
                                @if (st.AbsentsCount > 0 || st.ExcusedCount > 0 || st.LateCount > 0)
                                {
                                    <span class="text-danger fw-semibold" title="Vắng không phép">V:@st.AbsentsCount</span>
                                    <span class="text-muted mx-1">|</span>
                                    <span class="text-warning fw-semibold" title="Vắng có phép">P:@st.ExcusedCount</span>
                                    <span class="text-muted mx-1">|</span>
                                    <span class="text-secondary fw-semibold" title="Đi muộn">M:@st.LateCount</span>
                                }
                                else
                                {
                                    <span class="text-success"><i class="bi bi-check2"></i> Đủ</span>
                                }
                            </td>
                            <td>
                                <select asp-for="Students[i].ConductGrade" class="form-select form-select-sm conduct-select" onchange="onGradeSelectChanged(this, @i)">
                                    <option value="">-- Chọn xếp loại --</option>
                                    <option value="Tốt">Tốt</option>
                                    <option value="Khá">Khá</option>
                                    <option value="Đạt">Đạt</option>
                                    <option value="Chưa đạt">Chưa đạt</option>
                                </select>
                            </td>
                            <td>
                                <div class="input-group input-group-sm">
                                    <input type="text" asp-for="Students[i].TeacherComment" class="form-control comment-input" id="comment-@i" maxlength="500" placeholder="Nhập nhận xét..." />
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Chọn mẫu nhanh">
                                        <i class="bi bi-magic"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow">
                                        <li><a class="dropdown-item small" href="javascript:void(0)" onclick="setComment(@i, 'Chăm ngoan, lễ phép, gương mẫu trong học tập và tích cực tham gia các phong trào thi đua của lớp.')">Chăm ngoan, lễ phép, gương mẫu...</a></li>
                                        <li><a class="dropdown-item small" href="javascript:void(0)" onclick="setComment(@i, 'Chấp hành rất tốt nội quy nhà trường, hòa đồng và có tinh thần trách nhiệm cao.')">Chấp hành rất tốt nội quy...</a></li>
                                        <li><a class="dropdown-item small" href="javascript:void(0)" onclick="setComment(@i, 'Ngoan ngoãn, chấp hành tốt nội quy trường lớp. Cần phát huy hơn tính năng nổ.')">Ngoan ngoãn, cần năng nổ hơn...</a></li>
                                        <li><a class="dropdown-item small" href="javascript:void(0)" onclick="setComment(@i, 'Cơ bản thực hiện nội quy, còn đi học muộn, cần rèn luyện thêm tính tự giác.')">Cơ bản thực hiện nội quy, còn đi muộn...</a></li>
                                        <li><a class="dropdown-item small" href="javascript:void(0)" onclick="setComment(@i, 'Ý thức kỷ luật chưa cao, vi phạm nội quy nhiều lần. Gia đình cần phối hợp đôn đốc.')">Ý thức kỷ luật chưa cao...</a></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="p-3 border-top bg-light d-flex justify-content-between align-items-center">
            <span class="small text-muted">Tổng số: <strong>@Model.Students.Count</strong> học sinh.</span>
            <div class="d-flex gap-2">
                <a asp-action="Index" asp-route-classId="@Model.ClassId" asp-route-semesterId="@Model.SemesterId" class="btn btn-sm btn-outline-secondary">
                    Hủy bỏ
                </a>
                <button type="submit" class="btn btn-sm btn-primary px-4 shadow-sm">
                    <i class="bi bi-save me-1"></i> Lưu Toàn Bộ Đánh Giá
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function applyAllGrades(grade) {
            document.querySelectorAll('.conduct-select').forEach((sel, idx) => {
                sel.value = grade;
                highlightGradeColor(sel);
            });
        }

        function applyDefaultComments() {
            document.querySelectorAll('.conduct-select').forEach((sel, idx) => {
                const commentInput = document.getElementById(`comment-${idx}`);
                if (commentInput && !commentInput.value.trim()) {
                    const grade = sel.value;
                    if (grade === 'Tốt') commentInput.value = 'Chăm ngoan, lễ phép, gương mẫu trong học tập và tích cực tham gia các phong trào thi đua của lớp.';
                    else if (grade === 'Khá') commentInput.value = 'Ngoan ngoãn, chấp hành tốt nội quy trường lớp, có ý thức kỷ luật tốt.';
                    else if (grade === 'Đạt') commentInput.value = 'Cơ bản chấp hành nội quy, đôi lúc còn mất trật tự, cần rèn luyện thêm tính tự giác.';
                    else if (grade === 'Chưa đạt') commentInput.value = 'Ý thức kỷ luật chưa cao, vi phạm nội quy nhiều lần. Gia đình cần phối hợp đôn đốc chặt chẽ.';
                }
            });
        }

        function onGradeSelectChanged(sel, idx) {
            highlightGradeColor(sel);
            const commentInput = document.getElementById(`comment-${idx}`);
            if (commentInput && !commentInput.value.trim()) {
                const grade = sel.value;
                if (grade === 'Tốt') commentInput.value = 'Chăm ngoan, lễ phép, gương mẫu trong học tập và tích cực tham gia các phong trào thi đua của lớp.';
                else if (grade === 'Khá') commentInput.value = 'Ngoan ngoãn, chấp hành tốt nội quy trường lớp, có ý thức kỷ luật tốt.';
                else if (grade === 'Đạt') commentInput.value = 'Cơ bản chấp hành nội quy, đôi lúc còn mất trật tự, cần rèn luyện thêm tính tự giác.';
                else if (grade === 'Chưa đạt') commentInput.value = 'Ý thức kỷ luật chưa cao, vi phạm nội quy nhiều lần. Gia đình cần phối hợp đôn đốc chặt chẽ.';
            }
        }

        function setComment(idx, text) {
            const commentInput = document.getElementById(`comment-${idx}`);
            if (commentInput) {
                commentInput.value = text;
            }
        }

        function highlightGradeColor(sel) {
            sel.classList.remove('border-success', 'border-primary', 'border-warning', 'border-danger');
            if (sel.value === 'Tốt') sel.classList.add('border-success');
            else if (sel.value === 'Khá') sel.classList.add('border-primary');
            else if (sel.value === 'Đạt') sel.classList.add('border-warning');
            else if (sel.value === 'Chưa đạt') sel.classList.add('border-danger');
        }

        // Khởi tạo màu ban đầu
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.conduct-select').forEach(sel => highlightGradeColor(sel));
        });
    </script>
}
