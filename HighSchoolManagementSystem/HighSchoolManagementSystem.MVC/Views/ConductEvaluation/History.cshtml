@model HighSchoolManagementSystem.MVC.Models.ViewModels.Conduct.ConductHistoryViewModel
@{
    ViewData["Title"] = "Lịch Sử Đánh Giá Hạnh Kiểm";
}

<!-- Greeting Banner EIMS Standard -->
<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-clock-history me-1"></i> TIẾN TRÌNH RÈN LUYỆN • LỊCH SỬ HẠNH KIỂM
        </span>
        <h1 class="greeting-title">Lịch Sử Hạnh Kiểm - @Model.FullName</h1>
        <p class="greeting-subtitle">
            Mã học sinh: <strong>@Model.StudentCode</strong> • Lớp hiện tại: <strong>@Model.ClassName</strong>
        </p>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="history.back()">
        <i class="bi bi-arrow-left"></i> Quay lại
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
        <i class="bi bi-printer"></i> In lịch sử hạnh kiểm
    </button>
</div>

@if (!Model.History.Any())
{
    <div class="edu-card text-center py-5">
        <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold text-dark">Chưa Có Bản Ghi Hạnh Kiểm</h5>
        <p class="text-muted small mb-0">Học sinh chưa có đánh giá hạnh kiểm nào được ghi nhận trong hệ thống.</p>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-8 mx-auto">
            <!-- Timeline Container -->
            <div class="timeline-container position-relative ps-4 border-start border-2 border-primary border-opacity-25 ms-3">
                @foreach (var h in Model.History)
                {
                    <div class="position-relative mb-4">
                        <!-- Timeline Dot -->
                        <span class="position-absolute top-0 start-0 translate-middle p-2 bg-primary border border-light rounded-circle shadow-sm" style="left: -17px;"></span>

                        <div class="edu-card p-4 shadow-sm border-0">
                            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
                                <div>
                                    <h5 class="fw-bold text-dark mb-1">
                                        <i class="bi bi-calendar-event text-primary me-1"></i> @h.SemesterName
                                    </h5>
                                    <div class="small text-muted">
                                        Năm học: <strong>@h.AcademicYearCode</strong> • Lớp: <strong>@h.ClassName</strong>
                                    </div>
                                </div>
                                <div>
                                    @if (string.Equals(h.ConductGrade, "Tốt", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success text-white fs-6 px-3 py-2 shadow-sm">
                                            <i class="bi bi-star-fill me-1"></i> Hạnh kiểm Tốt
                                        </span>
                                    }
                                    else if (string.Equals(h.ConductGrade, "Khá", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-primary text-white fs-6 px-3 py-2 shadow-sm">
                                            <i class="bi bi-hand-thumbs-up-fill me-1"></i> Hạnh kiểm Khá
                                        </span>
                                    }
                                    else if (string.Equals(h.ConductGrade, "Đạt", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark fs-6 px-3 py-2 shadow-sm">
                                            <i class="bi bi-check-circle-fill me-1"></i> Hạnh kiểm Đạt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger text-white fs-6 px-3 py-2 shadow-sm">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Chưa đạt
                                        </span>
                                    }
                                </div>
                            </div>

                            <!-- Nhận xét chi tiết -->
                            <div class="p-3 bg-light rounded-3 mb-3 border">
                                <div class="small fw-bold text-secondary mb-1">
                                    <i class="bi bi-chat-quote me-1"></i> Lời nhận xét của Giáo viên chủ nhiệm:
                                </div>
                                <div class="text-dark fst-italic">
                                    "@(string.IsNullOrWhiteSpace(h.TeacherComment) ? "Chưa có nhận xét chi tiết." : h.TeacherComment)"
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center text-muted small pt-2 border-top">
                                <span><i class="bi bi-person-badge"></i> GVCN đánh giá: <strong>@h.HomeroomTeacherName</strong></span>
                                <span><i class="bi bi-clock"></i> Ngày đánh giá: <strong>@h.EvaluatedAt.ToString("dd/MM/yyyy HH:mm")</strong></span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}
