@model HighSchoolManagementSystem.MVC.Models.ViewModels.Conduct.ConductEvaluationListViewModel
@{
    ViewData["Title"] = "Đánh Giá & Xếp Loại Hạnh Kiểm";
}

<!-- Greeting Banner EIMS Standard -->
<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            @if (User.IsInRole("Principal"))
            {
                <span><i class="bi bi-shield-check me-1"></i> BAN GIÁM HIỆU • GIÁM SÁT HẠNH KIỂM & KỶ LUẬT</span>
            }
            else if (User.IsInRole("Staff"))
            {
                <span><i class="bi bi-folder-check me-1"></i> GIÁO VỤ ĐÀO TẠO • QUẢN LÝ HẠNH KIỂM</span>
            }
            else
            {
                <span><i class="bi bi-person-badge-fill me-1"></i> GIÁO VIÊN CHỦ NHIỆM • ĐÁNH GIÁ NỀ NẾP & HẠNH KIỂM</span>
            }
        </span>
        <h1 class="greeting-title">Đánh Giá & Xếp Loại Hạnh Kiểm</h1>
        <p class="greeting-subtitle">
            Quản lý, đánh giá và ghi nhận xét kết quả rèn luyện đạo đức, tác phong chuyên cần của học sinh theo từng học kỳ.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewBag.Notice != null)
{
    <div class="edu-card text-center py-5">
        <i class="bi bi-person-x fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold text-dark">Chưa Phân Công Lớp Chủ Nhiệm</h5>
        <p class="text-muted small mb-0">@ViewBag.Notice</p>
    </div>
}
else if (!Model.AvailableClasses.Any())
{
    <div class="edu-card text-center py-5">
        <i class="bi bi-collection fs-1 text-muted d-block mb-3"></i>
        <h5 class="fw-bold text-dark">Chưa Có Dữ Liệu Lớp Học</h5>
        <p class="text-muted small mb-0">Không tìm thấy lớp học nào khả dụng trong hệ thống.</p>
    </div>
}
else
{
    <!-- Filter Card -->
    <div class="edu-card p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="classSelect" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-collection me-1"></i> Lớp học
                </label>
                <select id="classSelect" name="classId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var c in Model.AvailableClasses)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.SelectedClassId)">
                            @c.ClassName (@c.AcademicYearCode)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label for="semesterSelect" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-calendar3 me-1"></i> Học kỳ
                </label>
                <select id="semesterSelect" name="semesterId" class="form-select form-select-sm" onchange="this.form.submit()">
                    @foreach (var sem in Model.AvailableSemesters)
                    {
                        <option value="@sem.Id" selected="@(sem.Id == Model.SelectedSemesterId)">
                            @sem.SemesterName - @sem.AcademicYearCode @(sem.IsActive ? "(Hiện tại)" : "")
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <label for="statusSelect" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-check2-circle me-1"></i> Trạng thái
                </label>
                <select id="statusSelect" name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="All" selected="@(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "All")">Tất cả trạng thái</option>
                    <option value="Evaluated" selected="@(Model.StatusFilter == "Evaluated")">Đã đánh giá</option>
                    <option value="NotEvaluated" selected="@(Model.StatusFilter == "NotEvaluated")">Chưa đánh giá</option>
                </select>
            </div>

            <div class="col-md-2">
                <label for="gradeSelect" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-award me-1"></i> Xếp loại
                </label>
                <select id="gradeSelect" name="grade" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="All" selected="@(string.IsNullOrEmpty(Model.GradeFilter) || Model.GradeFilter == "All")">Tất cả xếp loại</option>
                    <option value="Tốt" selected="@(Model.GradeFilter == "Tốt")">Tốt</option>
                    <option value="Khá" selected="@(Model.GradeFilter == "Khá")">Khá</option>
                    <option value="Đạt" selected="@(Model.GradeFilter == "Đạt")">Đạt</option>
                    <option value="Chưa đạt" selected="@(Model.GradeFilter == "Chưa đạt")">Chưa đạt</option>
                </select>
            </div>

            <div class="col-md-2">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Tìm tên, mã HS..." />
                    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Summary != null)
    {
        <!-- KPI Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-2">
                <div class="edu-card p-3 text-center border-start border-4 border-primary">
                    <div class="text-muted small fw-semibold">Sĩ số lớp</div>
                    <div class="fs-4 fw-bold text-dark mt-1">@Model.Summary.TotalStudents</div>
                    <div class="small text-muted">Học sinh</div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="edu-card p-3 text-center border-start border-4 border-info">
                    <div class="text-muted small fw-semibold">Đã đánh giá</div>
                    <div class="fs-4 fw-bold text-info mt-1">@Model.Summary.EvaluatedCount / @Model.Summary.TotalStudents</div>
                    <div class="small text-muted">
                        @(Model.Summary.TotalStudents > 0 ? Math.Round((double)Model.Summary.EvaluatedCount / Model.Summary.TotalStudents * 100, 1) : 0)%
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="edu-card p-3 text-center border-start border-4 border-success">
                    <div class="text-muted small fw-semibold">Hạnh kiểm Tốt</div>
                    <div class="fs-4 fw-bold text-success mt-1">@Model.Summary.TotCount</div>
                    <div class="small text-muted">
                        @(Model.Summary.TotalStudents > 0 ? Math.Round((double)Model.Summary.TotCount / Model.Summary.TotalStudents * 100, 1) : 0)%
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="edu-card p-3 text-center border-start border-4 border-primary">
                    <div class="text-muted small fw-semibold">Hạnh kiểm Khá</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@Model.Summary.KhaCount</div>
                    <div class="small text-muted">
                        @(Model.Summary.TotalStudents > 0 ? Math.Round((double)Model.Summary.KhaCount / Model.Summary.TotalStudents * 100, 1) : 0)%
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="edu-card p-3 text-center border-start border-4 border-warning">
                    <div class="text-muted small fw-semibold">Hạnh kiểm Đạt</div>
                    <div class="fs-4 fw-bold text-warning mt-1">@Model.Summary.DatCount</div>
                    <div class="small text-muted">
                        @(Model.Summary.TotalStudents > 0 ? Math.Round((double)Model.Summary.DatCount / Model.Summary.TotalStudents * 100, 1) : 0)%
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-2">
                <div class="edu-card p-3 text-center border-start border-4 border-danger">
                    <div class="text-muted small fw-semibold">Chưa đạt</div>
                    <div class="fs-4 fw-bold text-danger mt-1">@Model.Summary.ChuaDatCount</div>
                    <div class="small text-muted">
                        @(Model.Summary.TotalStudents > 0 ? Math.Round((double)Model.Summary.ChuaDatCount / Model.Summary.TotalStudents * 100, 1) : 0)%
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Bar & Table -->
        <div class="edu-card p-0 mb-4 overflow-hidden shadow-sm">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 bg-light bg-opacity-50">
                <div>
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-list-check me-1 text-primary"></i> Danh Sách Học Sinh Lớp @Model.Summary.ClassName
                    </h6>
                    <small class="text-muted">GVCN: <strong>@Model.Summary.HomeroomTeacherName</strong> • Học kỳ: <strong>@Model.Summary.SemesterName</strong></small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (Model.CanEdit)
                    {
                        <a asp-action="BulkEntry" asp-route-classId="@Model.SelectedClassId" asp-route-semesterId="@Model.SelectedSemesterId"
                           class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1">
                            <i class="bi bi-pencil-square"></i> Đánh giá nhanh cả lớp
                        </a>
                    }
                    <a asp-controller="Score" asp-action="HomeroomScores" asp-route-classId="@Model.SelectedClassId" asp-route-semesterId="@Model.SelectedSemesterId"
                       class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1">
                        <i class="bi bi-award"></i> Bảng điểm tổng hợp
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print()">
                        <i class="bi bi-printer"></i> In
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="conductTable">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center" style="width: 45px;">STT</th>
                            <th style="width: 105px;">Mã HS</th>
                            <th>Họ và tên</th>
                            <th class="text-center" style="width: 80px;">ĐTB HK</th>
                            <th class="text-center" style="width: 140px;">Chuyên cần</th>
                            <th class="text-center" style="width: 130px;">Hạnh kiểm</th>
                            <th>Nhận xét của GVCN</th>
                            <th class="text-center" style="width: 110px;">Cập nhật</th>
                            <th class="text-center" style="width: 140px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Summary.Students.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-search d-block fs-3 mb-2"></i>
                                    Không có học sinh nào phù hợp với điều kiện tìm kiếm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int idx = 1;
                            foreach (var s in Model.Summary.Students)
                            {
                                <tr id="row-@s.StudentId">
                                    <td class="text-center text-muted small">@idx</td>
                                    <td><span class="badge bg-light text-dark border">@s.StudentCode</span></td>
                                    <td>
                                        <div class="fw-semibold text-dark">@s.FullName</div>
                                        <div class="text-muted" style="font-size: 11px;">
                                            @(s.DateOfBirth.HasValue ? s.DateOfBirth.Value.ToString("dd/MM/yyyy") : "") • @s.Gender
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (s.Gpa.HasValue)
                                        {
                                            <span class="badge bg-light text-dark fw-bold border">@s.Gpa.Value.ToString("0.0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">--</span>
                                        }
                                    </td>
                                    <td class="text-center small">
                                        @if (s.AbsentsCount > 0 || s.ExcusedCount > 0 || s.LateCount > 0)
                                        {
                                            <span class="text-danger fw-semibold" title="Vắng không phép">V:@s.AbsentsCount</span>
                                            <span class="text-muted mx-1">|</span>
                                            <span class="text-warning fw-semibold" title="Vắng có phép">P:@s.ExcusedCount</span>
                                            <span class="text-muted mx-1">|</span>
                                            <span class="text-secondary fw-semibold" title="Đi muộn">M:@s.LateCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-success"><i class="bi bi-check2"></i> Đủ</span>
                                        }
                                    </td>
                                    <td class="text-center" id="grade-cell-@s.StudentId">
                                        @if (string.Equals(s.ConductGrade, "Tốt", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Tốt</span>
                                        }
                                        else if (string.Equals(s.ConductGrade, "Khá", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Khá</span>
                                        }
                                        else if (string.Equals(s.ConductGrade, "Đạt", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Đạt</span>
                                        }
                                        else if (string.Equals(s.ConductGrade, "Chưa đạt", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Chưa đạt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Chưa đánh giá</span>
                                        }
                                    </td>
                                    <td id="comment-cell-@s.StudentId">
                                        <div class="small text-truncate" style="max-width: 250px;" title="@s.TeacherComment">
                                            @(string.IsNullOrWhiteSpace(s.TeacherComment) ? Html.Raw("<span class='text-muted fst-italic'>Chưa có nhận xét</span>") : s.TeacherComment)
                                        </div>
                                    </td>
                                    <td class="text-center small text-muted" id="time-cell-@s.StudentId">
                                        @(s.EvaluatedAt.HasValue ? s.EvaluatedAt.Value.ToString("dd/MM/yyyy") : "--")
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            @if (Model.CanEdit)
                                            {
                                                <button type="button" class="btn btn-outline-primary"
                                                        data-student-id="@s.StudentId"
                                                        data-student-code="@s.StudentCode"
                                                        data-student-name="@s.FullName"
                                                        data-grade="@(s.ConductGrade ?? "")"
                                                        data-comment="@(s.TeacherComment ?? "")"
                                                        data-gpa="@(s.Gpa?.ToString("0.0") ?? "--")"
                                                        data-absent="@s.AbsentsCount"
                                                        data-excused="@s.ExcusedCount"
                                                        onclick="openEvaluateModalFromBtn(this)"
                                                        title="Đánh giá & Nhận xét">
                                                    <i class="bi bi-pencil-square"></i> Đánh giá
                                                </button>
                                            }
                                            <a asp-action="History" asp-route-studentId="@s.StudentId"
                                               class="btn btn-outline-secondary" title="Xem lịch sử hạnh kiểm các kỳ">
                                                <i class="bi bi-clock-history"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                idx++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<!-- Modal Đánh Giá Hạnh Kiểm & Nhận Xét Đơn Lẻ (AJAX) -->
<div class="modal fade" id="evaluateModal" tabindex="-1" aria-labelledby="evaluateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="evaluateModalLabel">
                    <i class="bi bi-award-fill text-primary me-2"></i> Đánh Giá Hạnh Kiểm Học Sinh
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-light border d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <div class="fw-bold text-dark fs-6" id="modalStudentName">Học sinh</div>
                        <div class="small text-muted">Mã HS: <strong id="modalStudentCode">--</strong></div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Điểm TBHK (GPA): <strong class="text-primary" id="modalStudentGpa">--</strong></div>
                        <div class="small text-muted">Chuyên cần: <strong id="modalStudentAttendance">--</strong></div>
                    </div>
                </div>

                <form id="singleEvaluateForm">
                    <input type="hidden" id="modalStudentId" />
                    <input type="hidden" id="modalSemesterId" value="@Model.SelectedSemesterId" />

                    <!-- Chọn mức xếp loại -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary">
                            1. Mức xếp loại hạnh kiểm <span class="text-danger">*</span>
                        </label>
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="conductGradeRadio" id="gradeTot" value="Tốt" autocomplete="off" onchange="onGradeRadioChanged('Tốt')">
                                <label class="btn btn-outline-success w-100 py-2 d-flex flex-column align-items-center gap-1" for="gradeTot">
                                    <i class="bi bi-star-fill fs-5"></i>
                                    <span class="fw-bold">Tốt</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="conductGradeRadio" id="gradeKha" value="Khá" autocomplete="off" onchange="onGradeRadioChanged('Khá')">
                                <label class="btn btn-outline-primary w-100 py-2 d-flex flex-column align-items-center gap-1" for="gradeKha">
                                    <i class="bi bi-hand-thumbs-up-fill fs-5"></i>
                                    <span class="fw-bold">Khá</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="conductGradeRadio" id="gradeDat" value="Đạt" autocomplete="off" onchange="onGradeRadioChanged('Đạt')">
                                <label class="btn btn-outline-warning w-100 py-2 d-flex flex-column align-items-center gap-1" for="gradeDat">
                                    <i class="bi bi-check-circle-fill fs-5"></i>
                                    <span class="fw-bold">Đạt</span>
                                </label>
                            </div>
                            <div class="col-6 col-md-3">
                                <input type="radio" class="btn-check" name="conductGradeRadio" id="gradeChuaDat" value="Chưa đạt" autocomplete="off" onchange="onGradeRadioChanged('Chưa đạt')">
                                <label class="btn btn-outline-danger w-100 py-2 d-flex flex-column align-items-center gap-1" for="gradeChuaDat">
                                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                                    <span class="fw-bold">Chưa đạt</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Gợi ý nhận xét mẫu nhanh -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label for="modalComment" class="form-label fw-bold small text-secondary mb-0">
                                2. Nhận xét của Giáo viên chủ nhiệm
                            </label>
                            <div class="dropdown">
                                <button class="btn btn-link btn-sm text-decoration-none p-0 dropdown-toggle text-primary small" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-magic me-1"></i> Chèn câu nhận xét mẫu
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow" id="quickCommentMenu" style="max-width: 380px;">
                                    <li><h6 class="dropdown-header">Mẫu cho Hạnh kiểm Tốt</h6></li>
                                    <li><a class="dropdown-item small text-wrap" href="javascript:void(0)" onclick="applyTemplate('Chăm ngoan, lễ phép, gương mẫu trong học tập và tích cực tham gia các phong trào thi đua của lớp.')">Chăm ngoan, lễ phép, gương mẫu trong học tập...</a></li>
                                    <li><a class="dropdown-item small text-wrap" href="javascript:void(0)" onclick="applyTemplate('Chấp hành rất tốt nội quy nhà trường, hòa đồng, có tinh thần trách nhiệm và tương trợ bạn bè.')">Chấp hành rất tốt nội quy, hòa đồng, có trách nhiệm...</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Mẫu cho Hạnh kiểm Khá</h6></li>
                                    <li><a class="dropdown-item small text-wrap" href="javascript:void(0)" onclick="applyTemplate('Ngoan ngoãn, chấp hành tốt nội quy trường lớp. Cần phát huy hơn nữa tính năng nổ trong sinh hoạt tập thể.')">Ngoan ngoãn, chấp hành tốt nội quy, cần năng nổ hơn...</a></li>
                                    <li><a class="dropdown-item small text-wrap" href="javascript:void(0)" onclick="applyTemplate('Ý thức nề nếp tốt, kính thầy yêu bạn, đôi lúc còn thiếu tập trung trong giờ học.')">Ý thức nề nếp tốt, đôi lúc còn thiếu tập trung...</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><h6 class="dropdown-header">Mẫu cho Hạnh kiểm Đạt / Chưa đạt</h6></li>
                                    <li><a class="dropdown-item small text-wrap" href="javascript:void(0)" onclick="applyTemplate('Cơ bản thực hiện nội quy, còn vi phạm đi học muộn, cần rèn luyện thêm tính tự giác và tập trung.')">Cơ bản thực hiện nội quy, còn đi học muộn...</a></li>
                                    <li><a class="dropdown-item small text-wrap" href="javascript:void(0)" onclick="applyTemplate('Ý thức kỷ luật chưa cao, vi phạm nội quy nhiều lần. Gia đình cần phối hợp đôn đốc nhắc nhở chặt chẽ.')">Ý thức kỷ luật chưa cao, gia đình cần phối hợp đôn đốc...</a></li>
                                </ul>
                            </div>
                        </div>
                        <textarea class="form-control" id="modalComment" rows="3" maxlength="500" placeholder="Nhập nhận xét cụ thể về ý thức, đạo đức, chấp hành nội quy và nề nếp của học sinh..."></textarea>
                        <div class="form-text small text-end"><span id="charCount">0</span>/500 ký tự</div>
                    </div>

                    <div id="modalAlert" class="alert d-none mb-3 py-2 small" role="alert"></div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm px-4" id="btnSaveSingle" onclick="saveSingleConduct()">
                    <i class="bi bi-save me-1"></i> Lưu Đánh Giá
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const evalModal = new bootstrap.Modal(document.getElementById('evaluateModal'));

        function openEvaluateModalFromBtn(btn) {
            const studentId = btn.getAttribute('data-student-id');
            const studentCode = btn.getAttribute('data-student-code');
            const fullName = btn.getAttribute('data-student-name');
            const conductGrade = btn.getAttribute('data-grade');
            const comment = btn.getAttribute('data-comment');
            const gpa = btn.getAttribute('data-gpa');
            const absent = btn.getAttribute('data-absent');
            const excused = btn.getAttribute('data-excused');

            document.getElementById('modalStudentId').value = studentId;
            document.getElementById('modalStudentCode').innerText = studentCode;
            document.getElementById('modalStudentName').innerText = fullName;
            document.getElementById('modalStudentGpa').innerText = gpa;
            document.getElementById('modalStudentAttendance').innerText = `Vắng: ${absent} | Phép: ${excused}`;
            document.getElementById('modalComment').value = comment || '';
            document.getElementById('charCount').innerText = (comment || '').length;

            // Reset radio
            document.querySelectorAll('input[name="conductGradeRadio"]').forEach(r => r.checked = false);
            if (conductGrade === 'Tốt') document.getElementById('gradeTot').checked = true;
            else if (conductGrade === 'Khá') document.getElementById('gradeKha').checked = true;
            else if (conductGrade === 'Đạt') document.getElementById('gradeDat').checked = true;
            else if (conductGrade === 'Chưa đạt') document.getElementById('gradeChuaDat').checked = true;

            const alertBox = document.getElementById('modalAlert');
            alertBox.className = 'alert d-none mb-3 py-2 small';
            alertBox.innerText = '';

            evalModal.show();
        }

        function onGradeRadioChanged(grade) {
            const currentComment = document.getElementById('modalComment').value.trim();
            if (!currentComment) {
                if (grade === 'Tốt') applyTemplate('Chăm ngoan, lễ phép, gương mẫu trong học tập và tích cực tham gia các phong trào thi đua của lớp.');
                else if (grade === 'Khá') applyTemplate('Ngoan ngoãn, chấp hành tốt nội quy trường lớp, có ý thức kỷ luật tốt.');
                else if (grade === 'Đạt') applyTemplate('Cơ bản chấp hành nội quy, đôi lúc còn mất trật tự, cần rèn luyện thêm tính tự giác.');
                else if (grade === 'Chưa đạt') applyTemplate('Ý thức kỷ luật chưa cao, vi phạm nội quy nhiều lần. Gia đình cần phối hợp đôn đốc chặt chẽ.');
            }
        }

        function applyTemplate(text) {
            document.getElementById('modalComment').value = text;
            document.getElementById('charCount').innerText = text.length;
        }

        document.getElementById('modalComment').addEventListener('input', function() {
            document.getElementById('charCount').innerText = this.value.length;
        });

        async function saveSingleConduct() {
            const studentId = parseInt(document.getElementById('modalStudentId').value);
            const semesterId = parseInt(document.getElementById('modalSemesterId').value);
            const checkedRadio = document.querySelector('input[name="conductGradeRadio"]:checked');
            const alertBox = document.getElementById('modalAlert');
            const btnSave = document.getElementById('btnSaveSingle');

            if (!checkedRadio) {
                alertBox.className = 'alert alert-warning mb-3 py-2 small';
                alertBox.innerText = 'Vui lòng chọn mức xếp loại hạnh kiểm.';
                return;
            }

            const conductGrade = checkedRadio.value;
            const comment = document.getElementById('modalComment').value.trim();

            btnSave.disabled = true;
            btnSave.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Đang lưu...';

            try {
                const response = await fetch('@Url.Action("SaveSingle", "ConductEvaluation")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        studentId: studentId,
                        semesterId: semesterId,
                        conductGrade: conductGrade,
                        teacherComment: comment
                    })
                });

                const result = await response.json();
                if (result.success) {
                    alertBox.className = 'alert alert-success mb-3 py-2 small';
                    alertBox.innerText = result.message || 'Đã lưu thành công!';

                    // Cập nhật DOM trực tiếp
                    updateTableRow(studentId, conductGrade, comment);

                    setTimeout(() => {
                        evalModal.hide();
                    }, 800);
                } else {
                    alertBox.className = 'alert alert-danger mb-3 py-2 small';
                    alertBox.innerText = result.message || 'Lưu thất bại.';
                }
            } catch (err) {
                alertBox.className = 'alert alert-danger mb-3 py-2 small';
                alertBox.innerText = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
            } finally {
                btnSave.disabled = false;
                btnSave.innerHTML = '<i class="bi bi-save me-1"></i> Lưu Đánh Giá';
            }
        }

        function updateTableRow(studentId, grade, comment) {
            const gradeCell = document.getElementById(`grade-cell-${studentId}`);
            if (gradeCell) {
                let badgeHtml = '';
                if (grade === 'Tốt') badgeHtml = '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Tốt</span>';
                else if (grade === 'Khá') badgeHtml = '<span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Khá</span>';
                else if (grade === 'Đạt') badgeHtml = '<span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">Đạt</span>';
                else if (grade === 'Chưa đạt') badgeHtml = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Chưa đạt</span>';
                gradeCell.innerHTML = badgeHtml;
            }

            const commentCell = document.getElementById(`comment-cell-${studentId}`);
            if (commentCell) {
                const text = comment ? comment : '<span class="text-muted fst-italic">Chưa có nhận xét</span>';
                commentCell.innerHTML = `<div class="small text-truncate" style="max-width: 250px;" title="${comment}">${text}</div>`;
            }

            const timeCell = document.getElementById(`time-cell-${studentId}`);
            if (timeCell) {
                const today = new Date();
                const dd = String(today.getDate()).padStart(2, '0');
                const mm = String(today.getMonth() + 1).padStart(2, '0');
                const yyyy = today.getFullYear();
                timeCell.innerText = `${dd}/${mm}/${yyyy}`;
            }
        }
    </script>
}
