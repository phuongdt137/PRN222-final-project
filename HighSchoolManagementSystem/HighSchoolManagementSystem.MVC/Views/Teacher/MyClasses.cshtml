@model IReadOnlyList<HighSchoolManagementSystem.MVC.Models.ViewModels.Class.TeacherAccessibleClassItemViewModel>
@{
    ViewData["Title"] = "Lớp của tôi";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> LỚP CHỦ NHIỆM / GIẢNG DẠY
        </span>
        <h1 class="greeting-title">Lớp được phân công</h1>
        <p class="greeting-subtitle">
            Các lớp bạn chủ nhiệm hoặc được phân công giảng dạy. Chỉ các lớp này mới xem được danh sách học sinh.
        </p>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Danh sách lớp</h2>
            <p class="table-card-subtitle">Chọn lớp để xem học sinh thuộc lớp đó.</p>
        </div>
        <span class="table-counter-badge">Tổng: @Model.Count lớp</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-collection" style="font-size: 2rem;"></i>
            <p class="mt-2 mb-0">Bạn chưa được phân công lớp nào.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-edu mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Tên lớp</th>
                        <th>Khối</th>
                        <th>Năm học</th>
                        <th>Vai trò</th>
                        <th class="text-center">Sĩ số</th>
                        <th class="text-center" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td><strong>@item.ClassName</strong></td>
                            <td>@item.GradeLevelName</td>
                            <td>@item.AcademicYearCode</td>
                            <td>
                                <span class="badge-status @(item.IsHomeroom ? "badge-status-success" : "badge-status-info")">
                                    @item.AccessRoleLabel
                                </span>
                            </td>
                            <td class="text-center">@item.StudentCount</td>
                            <td class="text-center">
                                <a asp-action="ClassStudents" asp-route-id="@item.Id"
                                   class="btn btn-primary btn-sm px-2 py-1" style="font-size: 12px;">
                                    <i class="bi bi-people me-1"></i>Xem học sinh
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
