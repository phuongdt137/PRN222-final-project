@model HighSchoolManagementSystem.MVC.Models.ViewModels.EditRoomViewModel
@{
    ViewData["Title"] = "Cập nhật phòng học";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN LÝ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Cập nhật phòng học</h1>
        <p class="greeting-subtitle">
            Chỉnh sửa thông tin phòng #@Model.Id. Mã phòng không được trùng với phòng khác.
        </p>
    </div>
</div>

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Thông tin phòng học</h2>
            <p class="table-card-subtitle">Có thể đổi mã, tên, loại phòng, sức chứa hoặc trạng thái.</p>
        </div>
        <a asp-action="Rooms" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <div class="p-4">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-action="EditRoom" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="RoomCode" class="form-label"></label>
                    <input asp-for="RoomCode" class="form-control" autofocus />
                    <span asp-validation-for="RoomCode" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="RoomName" class="form-label"></label>
                    <input asp-for="RoomName" class="form-control" />
                    <span asp-validation-for="RoomName" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Building" class="form-label"></label>
                    <input asp-for="Building" class="form-control" />
                    <span asp-validation-for="Building" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="RoomType" class="form-label"></label>
                    <select asp-for="RoomType" class="form-select" asp-items="Model.RoomTypes"></select>
                    <span asp-validation-for="RoomType" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Capacity" class="form-label"></label>
                    <input asp-for="Capacity" id="Capacity" class="form-control" type="number" min="1" max="5000" />
                    <span asp-validation-for="Capacity" class="text-danger small mt-1 d-block"></span>
                    <span class="form-text text-muted small">Nhà đa năng tối đa 5000; các loại khác tối đa 500.</span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status" class="form-select" asp-items="Model.Statuses"></select>
                    <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                </button>
                <a asp-action="Rooms" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const roomType = document.getElementById('RoomType');
            const capacity = document.getElementById('Capacity');
            if (!roomType || !capacity) return;

            function syncMax() {
                capacity.max = roomType.value === 'Gym' ? '5000' : '500';
            }

            roomType.addEventListener('change', syncMax);
            syncMax();
        })();
    </script>
}
