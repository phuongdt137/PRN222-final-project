@model HighSchoolManagementSystem.MVC.Models.ViewModels.Class.EditClassViewModel
@{
    ViewData["Title"] = "Cập nhật lớp học";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN LÝ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Cập nhật lớp học</h1>
        <p class="greeting-subtitle">
            Chỉnh sửa thông tin lớp #@Model.Id. Tên lớp không được trùng trong cùng năm học.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Thông tin lớp học</h2>
            <p class="table-card-subtitle">Có thể đổi năm học, khối hoặc giáo viên chủ nhiệm.</p>
        </div>
        <a asp-action="ClassDetails" asp-route-id="@Model.Id" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại chi tiết
        </a>
    </div>

    <div class="p-4">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-action="EditClass" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="ClassName" class="form-label"></label>
                    <input asp-for="ClassName" class="form-control" placeholder="Ví dụ: 10A3" autofocus />
                    <span asp-validation-for="ClassName" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="AcademicYearId" class="form-label"></label>
                    <select asp-for="AcademicYearId" class="form-select" asp-items="Model.AcademicYears">
                        <option value="">-- Chọn năm học --</option>
                    </select>
                    <span asp-validation-for="AcademicYearId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="GradeLevelId" class="form-label"></label>
                    <select asp-for="GradeLevelId" class="form-select" asp-items="Model.GradeLevels">
                        <option value="">-- Chọn khối --</option>
                    </select>
                    <span asp-validation-for="GradeLevelId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-6">
                    <label asp-for="HomeroomTeacherId" class="form-label"></label>
                    <select asp-for="HomeroomTeacherId" class="form-select" asp-items="Model.Teachers">
                        <option value="">-- Chưa phân công --</option>
                    </select>
                    <span asp-validation-for="HomeroomTeacherId" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                </button>
                <a asp-action="ClassDetails" asp-route-id="@Model.Id" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
