@model HighSchoolManagementSystem.MVC.Models.ViewModels.StaffDashboardViewModel
@{
    ViewData["Title"] = "Bảng Điều Hành - Giáo Vụ";
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Cán bộ Giáo Vụ";
    var occupiedRooms = Math.Max(0, Model.TotalRoomCount - Model.AvailableRoomCount);
}

<!-- Greeting Banner kiểu EIMS -->
<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> TRANG CHỦ GIÁO VỤ
        </span>
        <h1 class="greeting-title">Xin chào, @displayName</h1>
        <p class="greeting-subtitle">
            Không gian tiếp nhận hồ sơ học sinh, điều phối lịch học, duyệt đơn từ và hỗ trợ công tác đào tạo nhà trường.
        </p>
    </div>
    <div class="live-clock-card">
        <div class="clock-info text-end">
            <div class="clock-date" id="liveClockDate">Đang đồng bộ...</div>
            <div class="clock-time" id="liveClockTime">--:--:--</div>
        </div>
        <div class="clock-icon-box">
            <i class="bi bi-clock"></i>
        </div>
    </div>
</div>

<!-- Section 1: KPI & Chỉ số công việc -->
<div class="dashboard-section-header">
    <div class="section-title-wrap">
        <h2>Chỉ số tiếp nhận & Tiến độ công việc giáo vụ</h2>
        <p>Thống kê số lượng đơn từ, tình trạng phòng học và công tác quản lý hồ sơ đào tạo.</p>
    </div>
    <div class="section-right-meta">
        <i class="bi bi-arrow-repeat me-1"></i>Cập nhật tự động theo thời gian thực
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Card 1: Đơn xin nghỉ phép cần duyệt -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-orange">
                <i class="bi bi-file-earmark-check-fill"></i>
            </span>
            <div class="stat-kicker">HÀNH CHÍNH & ĐƠN TỪ</div>
            <div class="stat-title">Đơn xin nghỉ phép cần duyệt</div>
            <div class="stat-main">
                <div class="stat-number">@Model.PendingLeaveCount</div>
                <div class="stat-label">Đơn đang chờ Staff / GVCN xét duyệt</div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-yellow">Chờ duyệt: @Model.PendingLeaveCount</div>
                <div class="breakdown-pill pill-green">Đã duyệt: @Model.ApprovedLeaveCount</div>
                <div class="breakdown-pill pill-red">Từ chối: @Model.RejectedLeaveCount</div>
            </div>
        </div>
    </div>

    <!-- Card 2: Hồ sơ học sinh -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-blue">
                <i class="bi bi-folder2-open"></i>
            </span>
            <div class="stat-kicker">QUẢN LÝ ĐÀO TẠO</div>
            <div class="stat-title">Hồ sơ học sinh quản lý</div>
            <div class="stat-main">
                <div class="stat-number">1,450</div>
                <div class="stat-label">Hồ sơ điện tử đang được lưu trữ</div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-blue">Đầy đủ: 1,438</div>
                <div class="breakdown-pill pill-yellow">Bổ sung: 12</div>
            </div>
        </div>
    </div>

    <!-- Card 3: Cơ sở vật chất -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-green">
                <i class="bi bi-door-open-fill"></i>
            </span>
            <div class="stat-kicker">CƠ SỞ VẬT CHẤT</div>
            <div class="stat-title">Tình trạng phòng học</div>
            <div class="stat-main">
                <div class="stat-number">@occupiedRooms / @Model.TotalRoomCount</div>
                <div class="stat-label">Phòng đang sử dụng / tổng số phòng</div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-green">Đang dùng: @occupiedRooms</div>
                <div class="breakdown-pill pill-blue">Sẵn sàng: @Model.AvailableRoomCount</div>
            </div>
        </div>
    </div>

    <!-- Card 4: Tiếp nhận giấy tờ -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-purple">
                <i class="bi bi-inbox-fill"></i>
            </span>
            <div class="stat-kicker">TIẾP NHẬN YÊU CẦU</div>
            <div class="stat-title">Yêu cầu cấp giấy tờ & bảng điểm</div>
            <div class="stat-main">
                <div class="stat-number">8</div>
                <div class="stat-label">Đơn xin xác nhận và trích lục học bạ</div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-yellow">Đang xử lý: 5</div>
                <div class="breakdown-pill pill-green">Hoàn thành: 3</div>
            </div>
        </div>
    </div>
</div>

<!-- Section 2: Bảng dữ liệu tác vụ -->
<!-- Table 1: Đơn xin nghỉ phép cần duyệt -->
<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Đơn xin nghỉ phép đang chờ xét duyệt</h2>
            <p class="table-card-subtitle">Dữ liệu thật từ hệ thống. Bấm Duyệt/Từ chối hoặc mở chi tiết để xử lý.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="table-counter-badge">Chờ duyệt: @Model.PendingLeaveCount đơn</span>
            <a asp-controller="LeaveRequest" asp-action="Index" asp-route-status="Pending" class="btn btn-secondary btn-sm">
                Xem tất cả
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center m-3 mb-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <div>@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger d-flex align-items-center m-3 mb-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>@TempData["ErrorMessage"]</div>
        </div>
    }

    @if (Model.PendingLeaves.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
            <p class="mt-2 mb-0">Hiện không có đơn nào đang chờ duyệt.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-edu mb-0">
                <thead>
                    <tr>
                        <th style="width: 90px;">Mã Đơn</th>
                        <th>Học Sinh</th>
                        <th>Lớp</th>
                        <th>Người gửi</th>
                        <th>Thời gian nghỉ</th>
                        <th>Lý do</th>
                        <th class="text-center" style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PendingLeaves)
                    {
                        var periodText = item.StartDate.Date == item.EndDate.Date
                            ? item.StartDate.ToString("dd/MM/yyyy")
                            : $"{item.StartDate:dd/MM/yyyy} - {item.EndDate:dd/MM/yyyy}";
                        <tr>
                            <td><strong>#NP-@item.Id</strong></td>
                            <td>
                                <strong>@item.StudentName</strong>
                                <div class="text-muted small">@item.StudentCode</div>
                            </td>
                            <td>@(item.ClassName ?? "—")</td>
                            <td>@item.RequestedByName</td>
                            <td>@periodText</td>
                            <td>@(item.Reason.Length > 60 ? item.Reason[..60] + "…" : item.Reason)</td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-center">
                                    <form asp-controller="LeaveRequest" asp-action="Review" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@item.Id" />
                                        <input type="hidden" name="Approve" value="true" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Staff")" />
                                        <button type="submit" class="btn btn-primary btn-sm px-2 py-1" style="font-size: 12px;">
                                            <i class="bi bi-check-lg me-1"></i>Duyệt
                                        </button>
                                    </form>
                                    <form asp-controller="LeaveRequest" asp-action="Review" method="post" class="d-inline"
                                          onsubmit="return confirm('Từ chối đơn #NP-@item.Id?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@item.Id" />
                                        <input type="hidden" name="Approve" value="false" />
                                        <input type="hidden" name="returnUrl" value="@Url.Action("Dashboard", "Staff")" />
                                        <button type="submit" class="btn btn-secondary btn-sm px-2 py-1" style="font-size: 12px;">
                                            <i class="bi bi-x-lg me-1"></i>Từ chối
                                        </button>
                                    </form>
                                    <a asp-controller="LeaveRequest" asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-secondary btn-sm px-2 py-1" style="font-size: 12px;">
                                        Chi tiết
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Table 2: Tình trạng phòng học & Sĩ số -->
<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Tình trạng điều phối phòng học & Sĩ số các lớp</h2>
            <p class="table-card-subtitle">Theo dõi phân bổ tiết học, sức chứa phòng và tình trạng hoạt động thực tế.</p>
        </div>
        <span class="table-counter-badge">Theo dõi: 4 phòng mẫu</span>
    </div>
    <div class="table-responsive">
        <table class="table-edu mb-0">
            <thead>
                <tr>
                    <th style="width: 100px;">Phòng</th>
                    <th>Lớp Đang Học</th>
                    <th>Khối Lớp</th>
                    <th>Giáo Viên Giảng Dạy</th>
                    <th>Môn Học</th>
                    <th class="text-center">Sĩ Số / Sức Chứa</th>
                    <th class="text-center">Tình Trạng</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>P.201</strong></td>
                    <td><strong>10A1</strong></td>
                    <td>Khối 10</td>
                    <td>Thầy Nguyễn Văn Nam</td>
                    <td>Toán học</td>
                    <td class="text-center">45 / 50</td>
                    <td class="text-center">
                        <span class="badge-status badge-status-success">Đang học (Tiết 2)</span>
                    </td>
                </tr>
                <tr>
                    <td><strong>P.202</strong></td>
                    <td><strong>10A2</strong></td>
                    <td>Khối 10</td>
                    <td>Cô Lê Thị Hồng</td>
                    <td>Ngữ văn</td>
                    <td class="text-center">44 / 50</td>
                    <td class="text-center">
                        <span class="badge-status badge-status-success">Đang học (Tiết 2)</span>
                    </td>
                </tr>
                <tr>
                    <td><strong>P.301</strong></td>
                    <td><strong>11A3</strong></td>
                    <td>Khối 11</td>
                    <td>Thầy Phạm Quốc Hưng</td>
                    <td>Vật lý</td>
                    <td class="text-center">42 / 50</td>
                    <td class="text-center">
                        <span class="badge-status badge-status-success">Đang học (Tiết 2)</span>
                    </td>
                </tr>
                <tr>
                    <td><strong>P.Lab-1</strong></td>
                    <td><em>(Phòng Tin học 1)</em></td>
                    <td>Phòng Chức năng</td>
                    <td>-- Trống --</td>
                    <td>--</td>
                    <td class="text-center">0 / 45</td>
                    <td class="text-center">
                        <span class="badge-status badge-status-info">Sẵn sàng sử dụng</span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
