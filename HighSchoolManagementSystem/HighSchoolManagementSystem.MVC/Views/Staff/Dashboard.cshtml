                            <i class="bi bi-check-lg me-1"></i>Duyệt
                        </button>
                        <button type="button" class="btn btn-secondary btn-sm px-2 py-1" style="font-size: 12px;">
                            <i class="bi bi-x-lg me-1"></i>Từ chối
