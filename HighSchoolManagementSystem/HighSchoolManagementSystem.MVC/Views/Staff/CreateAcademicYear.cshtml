@model HighSchoolManagementSystem.MVC.Models.ViewModels.AcademicYear.CreateAcademicYearViewModel
@{
    ViewData["Title"] = "Tạo năm học mới";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN LÝ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Tạo năm học mới</h1>
        <p class="greeting-subtitle">
            Nhập mã năm học và khoảng thời gian áp dụng. Mã năm học phải là duy nhất trong hệ thống.
        </p>
    </div>
</div>

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Thông tin năm học</h2>
            <p class="table-card-subtitle">Ví dụ mã năm học: 2026-2027 · Ngày bắt đầu thường vào đầu tháng 9.</p>
        </div>
        <a asp-action="AcademicYears" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <div class="p-4">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-action="CreateAcademicYear" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="YearCode" class="form-label"></label>
                    <input asp-for="YearCode" class="form-control" placeholder="Ví dụ: 2026-2027" autofocus />
                    <span asp-validation-for="YearCode" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                    <span asp-validation-for="StartDate" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-3">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                    <span asp-validation-for="EndDate" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Lưu năm học
                </button>
                <a asp-action="AcademicYears" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
