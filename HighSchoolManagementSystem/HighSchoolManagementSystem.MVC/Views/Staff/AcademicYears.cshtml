@model IReadOnlyList<HighSchoolManagementSystem.MVC.Models.ViewModels.AcademicYear.AcademicYearListItemViewModel>
@{
    ViewData["Title"] = "Danh sách năm học";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN LÝ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Danh sách năm học</h1>
        <p class="greeting-subtitle">
            Tra cứu toàn bộ năm học đã cấu hình trong hệ thống, kèm số học kỳ và số lớp thuộc từng năm.
        </p>
    </div>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Tất cả năm học</h2>
            <p class="table-card-subtitle">Năm hiện hành được ưu tiên hiển thị trước. Chỉ có một năm học hiện hành tại một thời điểm.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @{
                var currentYear = Model.FirstOrDefault(x => x.IsCurrent);
            }
            @if (currentYear != null)
            {
                <span class="table-counter-badge" style="background: var(--status-success-bg); color: var(--status-success-text); border-color: var(--status-success-border);">
                    Hiện hành: @currentYear.YearCode
                </span>
            }
            else
            {
                <span class="table-counter-badge" style="background: var(--status-warning-bg); color: var(--status-warning-text); border-color: var(--status-warning-border);">
                    Chưa chọn năm hiện hành
                </span>
            }
            <span class="table-counter-badge">Tổng: @Model.Count năm học</span>
            <a asp-action="CreateAcademicYear" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Tạo năm học
            </a>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
            <p class="mt-2 mb-3">Chưa có năm học nào trong hệ thống.</p>
            <a asp-action="CreateAcademicYear" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Tạo năm học đầu tiên
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-edu mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Mã năm học</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th class="text-center">Số học kỳ</th>
                        <th class="text-center">Số lớp</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 280px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@index</td>
                            <td>
                                <strong>@item.YearCode</strong>
                                @if (item.IsCurrent)
                                {
                                    <span class="badge-status badge-status-success ms-1">Hiện hành</span>
                                }
                            </td>
                            <td>@item.StartDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.EndDate.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Semesters" asp-route-academicYearId="@item.Id" class="text-decoration-none">
                                    @item.SemesterCount
                                </a>
                            </td>
                            <td class="text-center">@item.ClassCount</td>
                            <td class="text-center">
                                <span class="badge-status @item.StatusCssClass">@item.Status</span>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-center">
                                    <a asp-action="Semesters" asp-route-academicYearId="@item.Id"
                                       class="btn btn-secondary btn-sm px-2 py-1" style="font-size: 12px;"
                                       title="Quản lý học kỳ">
                                        <i class="bi bi-journal-text me-1"></i>Học kỳ
                                    </a>
                                    <a asp-action="EditAcademicYear" asp-route-id="@item.Id"
                                       class="btn btn-secondary btn-sm px-2 py-1" style="font-size: 12px;"
                                       title="Cập nhật">
                                        <i class="bi bi-pencil-square me-1"></i>Sửa
                                    </a>
                                    @if (!item.IsCurrent)
                                    {
                                        <form asp-action="SetCurrentAcademicYear" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-primary btn-sm px-2 py-1" style="font-size: 12px;"
                                                    title="Đặt làm năm học hiện hành"
                                                    onclick="return confirm('Đặt năm học @item.YearCode làm năm hiện hành?');">
                                                <i class="bi bi-check2-circle me-1"></i>Chọn
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
