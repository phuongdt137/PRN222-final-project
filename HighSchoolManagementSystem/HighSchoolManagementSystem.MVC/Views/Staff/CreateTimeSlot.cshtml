@model HighSchoolManagementSystem.MVC.Models.ViewModels.CreateTimeSlotViewModel
@{
    ViewData["Title"] = "Tạo tiết học mới";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN LÝ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Tạo tiết học mới</h1>
        <p class="greeting-subtitle">
            Thêm khung giờ tiết học. Mã tiết và số tiết trong cùng buổi không được trùng.
        </p>
    </div>
</div>

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Thông tin tiết học</h2>
            <p class="table-card-subtitle">Giờ kết thúc phải sau giờ bắt đầu.</p>
        </div>
        <a asp-action="TimeSlots" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <div class="p-4">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-action="CreateTimeSlot" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="SlotCode" class="form-label"></label>
                    <input asp-for="SlotCode" class="form-control" placeholder="Ví dụ: T11" autofocus />
                    <span asp-validation-for="SlotCode" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="PeriodNo" class="form-label"></label>
                    <input asp-for="PeriodNo" class="form-control" type="number" min="1" max="20" />
                    <span asp-validation-for="PeriodNo" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Session" class="form-label"></label>
                    <select asp-for="Session" class="form-select" asp-items="Model.Sessions"></select>
                    <span asp-validation-for="Session" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="StartTime" class="form-label"></label>
                    <input asp-for="StartTime" class="form-control" type="time" />
                    <span asp-validation-for="StartTime" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="EndTime" class="form-label"></label>
                    <input asp-for="EndTime" class="form-control" type="time" />
                    <span asp-validation-for="EndTime" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Lưu tiết học
                </button>
                <a asp-action="TimeSlots" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
