@model HighSchoolManagementSystem.MVC.Models.ViewModels.RoomListPageViewModel
@{
    ViewData["Title"] = "Phòng học";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN LÝ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Danh sách phòng học</h1>
        <p class="greeting-subtitle">
            Tra cứu phòng học theo trạng thái và loại phòng. Mặc định hiển thị phòng đang sẵn sàng sử dụng.
        </p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

<div class="card-table-wrap mb-3">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Bộ lọc</h2>
            <p class="table-card-subtitle">Lọc theo trạng thái và loại phòng học.</p>
        </div>
    </div>
    <div class="p-4">
        <form asp-action="Rooms" method="get" class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label" for="status">Trạng thái</label>
                <select name="status" id="status" class="form-select" asp-items="Model.Statuses">
                    <option value="">-- Tất cả trạng thái --</option>
                </select>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label" for="roomType">Loại phòng</label>
                <select name="roomType" id="roomType" class="form-select" asp-items="Model.RoomTypes">
                    <option value="">-- Tất cả loại phòng --</option>
                </select>
            </div>
            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel me-1"></i>Lọc
                </button>
                <a asp-action="Rooms" class="btn btn-secondary">Mặc định</a>
            </div>
        </form>
    </div>
</div>

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Kết quả</h2>
            <p class="table-card-subtitle">Sắp xếp theo tòa nhà rồi theo mã phòng.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="table-counter-badge">Tổng: @Model.Rooms.Count phòng</span>
            <a asp-action="CreateRoom" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Tạo phòng học
            </a>
        </div>
    </div>

    @if (Model.Rooms.Count == 0)
    {
        <div class="p-4 text-center text-muted">
            <i class="bi bi-door-open" style="font-size: 2rem;"></i>
            <p class="mt-2 mb-3">Không có phòng học nào khớp với bộ lọc hiện tại.</p>
            <a asp-action="CreateRoom" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Tạo phòng học
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-edu mb-0">
                <thead>
                    <tr>
                        <th style="width: 70px;">#</th>
                        <th>Mã phòng</th>
                        <th>Tên phòng</th>
                        <th>Tòa nhà</th>
                        <th>Loại phòng</th>
                        <th class="text-center">Sức chứa</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var index = 1;
                    }
                    @foreach (var item in Model.Rooms)
                    {
                        var statusClass = item.Status switch
                        {
                            "Available" => "badge-status-success",
                            "Occupied" => "badge-status-info",
                            "Maintenance" => "badge-status-warning",
                            _ => "badge-status-warning"
                        };
                        var statusLabel = item.Status switch
                        {
                            "Available" => "Sẵn sàng",
                            "Occupied" => "Đang sử dụng",
                            "Maintenance" => "Bảo trì",
                            _ => item.Status
                        };
                        var typeLabel = item.RoomType switch
                        {
                            "Classroom" => "Phòng học",
                            "Lab" => "Phòng thí nghiệm",
                            "ComputerLab" => "Phòng máy",
                            "Library" => "Thư viện",
                            "Meeting" => "Phòng họp",
                            "Gym" => "Nhà đa năng",
                            _ => item.RoomType
                        };
                        <tr>
                            <td>@index</td>
                            <td><strong>@item.RoomCode</strong></td>
                            <td>@item.RoomName</td>
                            <td>@(string.IsNullOrWhiteSpace(item.Building) ? "—" : item.Building)</td>
                            <td>@typeLabel</td>
                            <td class="text-center">@item.Capacity</td>
                            <td class="text-center">
                                <span class="badge-status @statusClass">@statusLabel</span>
                            </td>
                            <td class="text-center">
                                <a asp-action="EditRoom" asp-route-id="@item.Id"
                                   class="btn btn-secondary btn-sm px-2 py-1" style="font-size: 12px;"
                                   title="Cập nhật">
                                    <i class="bi bi-pencil-square me-1"></i>Sửa
                                </a>
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
