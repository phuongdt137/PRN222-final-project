@model HighSchoolManagementSystem.MVC.Models.ViewModels.Semester.CreateSemesterViewModel
@{
    ViewData["Title"] = "Tạo học kỳ mới";
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> QUẢN LÝ ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Tạo học kỳ mới</h1>
        <p class="greeting-subtitle">
            Gắn vào năm học <strong>@Model.AcademicYearCode</strong>
            (@Model.AcademicYearStartDate.ToString("dd/MM/yyyy") – @Model.AcademicYearEndDate.ToString("dd/MM/yyyy")).
        </p>
    </div>
</div>

<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Thông tin học kỳ</h2>
            <p class="table-card-subtitle">Thời gian học kỳ phải nằm trong khoảng năm học.</p>
        </div>
        <a asp-action="Semesters" asp-route-academicYearId="@Model.AcademicYearId" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
    </div>

    <div class="p-4">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <form asp-action="CreateSemester" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="AcademicYearId" />

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label asp-for="SemesterCode" class="form-label"></label>
                    <input asp-for="SemesterCode" class="form-control" placeholder="Ví dụ: HK1-2627" autofocus />
                    <span asp-validation-for="SemesterCode" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="SemesterName" class="form-label"></label>
                    <input asp-for="SemesterName" class="form-control" placeholder="Ví dụ: Học kỳ 1" />
                    <span asp-validation-for="SemesterName" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-2">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                    <span asp-validation-for="StartDate" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="col-12 col-md-2">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                    <span asp-validation-for="EndDate" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Lưu học kỳ
                </button>
                <a asp-action="Semesters" asp-route-academicYearId="@Model.AcademicYearId" class="btn btn-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
