@model HighSchoolManagementSystem.MVC.Models.ViewModels.Timetable.TimetableListViewModel
@{ ViewData["Title"] = "Thời khóa biểu"; }
<div class="greeting-banner mb-4"><div class="greeting-text-wrap"><span class="greeting-kicker">LỊCH HỌC CỦA TÔI</span><h1 class="greeting-title">Thời khóa biểu</h1></div></div>
<div class="edu-card timetable-filter-card mb-4"><form asp-action="MySchedule" method="get" class="row g-3 align-items-end"><div class="col-md-5"><label for="semesterId" class="form-label">Học kỳ</label><select id="semesterId" name="semesterId" class="form-select"><option value="">-- Chọn học kỳ --</option>@foreach(var semester in Model.SemesterOptions){<option value="@semester.Value" selected="@(semester.Selected ? "selected" : null)">@semester.Text</option>}</select></div><div class="col-md-4"><label for="weekStart" class="form-label">Chọn tuần bất kỳ</label><input id="weekStart" name="weekStart" type="date" class="form-control" value="@Model.WeekStart.ToString("yyyy-MM-dd")" /></div><div class="col-md-3"><button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Xem lịch</button></div></form></div>
@await Html.PartialAsync("_WeeklyGrid", Model)
