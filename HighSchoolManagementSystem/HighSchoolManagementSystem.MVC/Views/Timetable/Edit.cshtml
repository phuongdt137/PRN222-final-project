@model HighSchoolManagementSystem.MVC.Models.ViewModels.Timetable.TimetableEditViewModel
@{ ViewData["Title"] = Model.Id.HasValue ? "Cập nhật thời khóa biểu" : "Thêm thời khóa biểu"; }
<div class="greeting-banner mb-4"><div class="greeting-text-wrap"><span class="greeting-kicker">QUẢN LÝ ĐÀO TẠO</span><h1 class="greeting-title">@ViewData["Title"]</h1></div></div>
<div class="edu-card p-4"><form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="SelectedTeacherId" type="hidden" />
    <input asp-for="SelectedSemesterId" type="hidden" />
    <input asp-for="WeekStart" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Giáo viên</label><input class="form-control" value="@Model.TeacherDisplayName" readonly /></div>
        <div class="col-md-6"><label asp-for="TeachingAssignmentId" class="form-label">Lớp - môn học</label><select asp-for="TeachingAssignmentId" asp-items="Model.AssignmentOptions" class="form-select"><option value="0">-- Chọn lớp, môn học --</option></select><span asp-validation-for="TeachingAssignmentId" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="DayOfWeek" class="form-label">Ngày trong tuần</label><select asp-for="DayOfWeek" class="form-select"><option value="2">Thứ 2</option><option value="3">Thứ 3</option><option value="4">Thứ 4</option><option value="5">Thứ 5</option><option value="6">Thứ 6</option><option value="7">Thứ 7</option></select><span asp-validation-for="DayOfWeek" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="TimeSlotId" class="form-label">Tiết học</label><select asp-for="TimeSlotId" asp-items="Model.TimeSlotOptions" class="form-select"><option value="0">-- Chọn tiết và giờ học --</option></select><span asp-validation-for="TimeSlotId" class="text-danger"></span></div>
        <div class="col-md-6"><label asp-for="RoomId" class="form-label">Phòng học</label><select asp-for="RoomId" asp-items="Model.RoomOptions" class="form-select"><option value="0">-- Chọn phòng --</option></select><span asp-validation-for="RoomId" class="text-danger"></span></div>
    </div>
    <div class="mt-4 d-flex gap-3"><button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu</button><a asp-action="Index" class="btn btn-secondary">Quay lại</a></div>
</form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
