@model HighSchoolManagementSystem.MVC.Models.ViewModels.Timetable.TimetableListViewModel
@{
    var previousWeek = Model.WeekStart.AddDays(-7);
    var nextWeek = Model.WeekStart.AddDays(7);
    var filterQuery = Model.SelectedSemesterId.HasValue ? $"&semesterId={Model.SelectedSemesterId.Value}" : "";
    if (Model.SelectedTeacherId.HasValue) { filterQuery += $"&teacherId={Model.SelectedTeacherId.Value}"; }
    if (Model.EditMode) { filterQuery += "&editMode=true"; }
}
<div class="card-table-wrap">
    <div class="card-table-header timetable-week-header">
        <div><h2 class="table-card-title">Tuần @Model.WeekStart.ToString("dd/MM/yyyy") - @Model.WeekStart.AddDays(5).ToString("dd/MM/yyyy")</h2></div>
        <div class="d-flex gap-2"><a class="btn btn-secondary btn-sm" href="?weekStart=@previousWeek.ToString("yyyy-MM-dd")@filterQuery"><i class="bi bi-chevron-left"></i> Tuần trước</a><a class="btn btn-secondary btn-sm" href="?weekStart=@nextWeek.ToString("yyyy-MM-dd")@filterQuery">Tuần sau <i class="bi bi-chevron-right"></i></a></div>
    </div>
    <div class="table-responsive"><table class="timetable-grid mb-0"><thead><tr><th class="timetable-period-col">Tiết / Giờ</th>@for (var day = 2; day <= 7; day++){var date=Model.WeekStart.AddDays(day-2);<th>Thứ @day<br /><small>@date.ToString("dd/MM/yyyy")</small></th>}</tr></thead><tbody>
    @for (var period=1; period<=10; period++){<tr><th class="timetable-period-cell">Tiết @period<br /><small>@(Model.PeriodTimes.TryGetValue(period, out var range) ? range : "")</small></th>@for (var day=2;day<=7;day++){var cells=Model.Entries.Where(x=>x.DayOfWeek==day&&x.PeriodNo==period).ToList();<td>@if(cells.Count==0){if(Model.EditMode && Model.PeriodSlotIds.TryGetValue(period, out var slotId)){<a class="timetable-empty-add" asp-controller="Timetable" asp-action="Create" asp-route-dayOfWeek="@day" asp-route-timeSlotId="@slotId" asp-route-teacherId="@Model.SelectedTeacherId" asp-route-semesterId="@Model.SelectedSemesterId" asp-route-weekStart="@Model.WeekStart.ToString("yyyy-MM-dd")"><i class="bi bi-plus-lg"></i></a>}else{<span class="text-muted">—</span>}}else{foreach(var cell in cells){<div class="timetable-cell"><strong>@cell.SubjectName</strong><span>@cell.ClassName</span><span><i class="bi bi-person me-1"></i>@cell.TeacherName</span><span><i class="bi bi-door-open me-1"></i>@cell.RoomName</span>@if(Model.EditMode){<div class="timetable-cell-actions"><a asp-controller="Timetable" asp-action="Edit" asp-route-id="@cell.Id" asp-route-teacherId="@Model.SelectedTeacherId" asp-route-semesterId="@Model.SelectedSemesterId" asp-route-weekStart="@Model.WeekStart.ToString("yyyy-MM-dd")" title="Sửa"><i class="bi bi-pencil-square"></i></a><form asp-controller="Timetable" asp-action="Delete" asp-route-id="@cell.Id" asp-route-teacherId="@Model.SelectedTeacherId" asp-route-semesterId="@Model.SelectedSemesterId" asp-route-weekStart="@Model.WeekStart.ToString("yyyy-MM-dd")" method="post" onsubmit="return confirm('Xóa tiết học này?');"><button type="submit" title="Xóa"><i class="bi bi-trash"></i></button></form></div>}</div>}}</td>}</tr>}
    </tbody></table></div>
</div>
