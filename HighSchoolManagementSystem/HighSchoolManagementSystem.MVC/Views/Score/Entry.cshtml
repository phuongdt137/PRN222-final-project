@model HighSchoolManagementSystem.MVC.Models.ViewModels.Score.ScoreEntryViewModel
@{
    ViewData["Title"] = "Nhập Điểm: " + Model.AssessmentName;
}

<!-- Greeting Banner EIMS Standard -->
<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-pencil-square me-1"></i> SỔ ĐIỂM • NHẬP ĐIỂM BÀI KIỂM TRA
        </span>
        <h1 class="greeting-title">Nhập Điểm: @Model.AssessmentName</h1>
        <p class="greeting-subtitle">
            Lớp: <span class="fw-bold text-white">@Model.ClassName</span> • 
            Môn học: <span class="fw-bold text-white">@Model.SubjectName</span> • 
            @Model.SemesterName • 
            Loại: <span class="badge bg-light text-dark">@Model.AssessmentTypeName (x@(Model.Weight))</span> •
            Ngày làm bài: <span class="fw-bold text-white">@(Model.ConductedAt?.ToString("dd/MM/yyyy") ?? "Chưa đặt")</span>
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.IsPrincipal)
        {
            <a asp-controller="Principal" asp-action="AcademicReview" class="btn btn-light px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Rà Soát Học Kỳ
            </a>
            <a asp-action="SubjectMatrix" asp-route-assignmentId="@Model.AssignmentId" class="btn btn-outline-light px-3 py-2">
                <i class="bi bi-grid-3x3 me-1"></i> Sổ Điểm Lưới
            </a>
        }
        else if (Model.IsStaff)
        {
            <a asp-action="HomeroomScores" class="btn btn-light px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> Quay Lại Sổ Điểm
            </a>
            <a asp-action="SubjectMatrix" asp-route-assignmentId="@Model.AssignmentId" class="btn btn-outline-light px-3 py-2">
                <i class="bi bi-grid-3x3 me-1"></i> Sổ Điểm Lưới
            </a>
        }
        else
        {
            <a asp-action="SubjectMatrix" asp-route-assignmentId="@Model.AssignmentId" class="btn btn-outline-light px-3 py-2">
                <i class="bi bi-grid-3x3 me-1"></i> Sổ Điểm Lưới
            </a>
            <a asp-controller="Assessment" asp-action="Index" asp-route-assignmentId="@Model.AssignmentId" class="btn btn-light px-3 py-2">
                <i class="bi bi-arrow-left me-1"></i> DS Bài Kiểm Tra
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Banner thông báo quy chế nhập điểm & trạng thái khóa -->
@if (Model.IsSemesterFinalized)
{
    @if (Model.IsPrincipal)
    {
        <div class="alert alert-dark border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
            <i class="bi bi-shield-lock-fill fs-2 text-danger flex-shrink-0"></i>
            <div>
                <h6 class="fw-bold mb-1 text-danger">Học kỳ này đã được chốt sổ chính thức</h6>
                <p class="mb-0 small text-secondary">
                    Bạn đang đăng nhập với tư cách <strong>Hiệu trưởng</strong>. Bạn có toàn quyền điều chỉnh điểm số. Khi lưu, hệ thống sẽ tự động cập nhật lại ĐTB môn và học bạ của học sinh.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
            <i class="bi bi-lock-fill fs-2 text-danger flex-shrink-0"></i>
            <div>
                <h6 class="fw-bold mb-1 text-danger">Bảng điểm đã bị khóa cứng (Học kỳ đã chốt sổ)</h6>
                <p class="mb-0 small text-secondary">
                    Học kỳ này đã được Hiệu trưởng chốt sổ chính thức. Giáo viên và Giáo vụ <strong>không thể điều chỉnh điểm</strong>. Chỉ có Hiệu trưởng mới có thẩm quyền điều chỉnh hoặc mở khóa học kỳ.
                </p>
            </div>
        </div>
    }
}
else if (Model.IsAssessmentLocked)
{
    @if (Model.IsPrincipal)
    {
        <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
            <i class="bi bi-shield-check fs-2 text-primary flex-shrink-0"></i>
            <div>
                <h6 class="fw-bold mb-1 text-primary">Chế độ quản trị của Hiệu trưởng</h6>
                <p class="mb-0 small text-secondary">
                    Bài kiểm tra đã qua hạn 7 ngày và được khóa tự động. Hiệu trưởng có toàn quyền điều chỉnh và giám sát dữ liệu.
                </p>
            </div>
        </div>
    }
    else if (Model.IsStaff)
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
            <i class="bi bi-shield-exclamation fs-2 text-warning flex-shrink-0"></i>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Chế độ điều chỉnh điểm sau khóa dành cho Giáo vụ (Staff Override)</h6>
                <p class="mb-0 small text-secondary">
                    Bài kiểm tra đã quá hạn nhập điểm và được hệ thống tự động khóa. Bạn đang sử dụng quyền Giáo vụ để điều chỉnh điểm (phúc khảo, sửa sai sót). Mọi thay đổi bắt buộc phải nhập <strong>Lý do điều chỉnh</strong> và sẽ được <strong>gửi thông báo trực tiếp đến Hiệu trưởng</strong>.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
            <i class="bi bi-lock-fill fs-2 text-warning flex-shrink-0"></i>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Bảng điểm đã được hệ thống tự động khóa theo quy chế</h6>
                <p class="mb-0 small text-secondary">
                    Đã hết hạn nhập điểm (7 ngày kể từ ngày làm bài: @(Model.ConductedAt?.ToString("dd/MM/yyyy") ?? "N/A")). Những học sinh chưa có điểm đã được tự động ghi nhận điểm 0. Giáo viên chỉ có quyền xem dữ liệu. Nếu cần điều chỉnh điểm phúc khảo hoặc kiểm tra bù, vui lòng liên hệ phòng <strong>Giáo vụ (Staff)</strong> để được xử lý.
                </p>
            </div>
        </div>
    }
}
else
{
    <div class="alert alert-light border shadow-sm d-flex align-items-center gap-3 mb-4" role="alert">
        <i class="bi bi-info-circle-fill fs-2 text-primary flex-shrink-0"></i>
        <div class="small">
            <span class="fw-bold text-dark">Quy chế tự động khóa:</span> 
            Hạn chót nhập/sửa điểm: <strong class="text-primary">@(Model.LockDeadline?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</strong> 
            @(Model.LockDeadline.HasValue ? $"(Còn {Math.Max(0, (int)(Model.LockDeadline.Value - DateTime.UtcNow).TotalDays)} ngày)" : ""). 
            Giáo viên có thể nhập điểm dần và bấm <strong>"Lưu Bảng Điểm"</strong> bất cứ lúc nào. 
            Khi chạm hạn chót, hệ thống sẽ <strong>tự động khóa</strong> và <strong>tự động ghi nhận điểm 0</strong> cho tất cả học sinh chưa có điểm.
        </div>
    </div>
}

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted small fw-medium">Sĩ số lớp</span>
                <h4 class="fw-bold mb-0 mt-1" id="kpiTotalStudents">@Model.TotalStudents</h4>
            </div>
            <div class="rounded-circle bg-primary bg-opacity-10 p-2 text-primary">
                <i class="bi bi-people fs-4"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted small fw-medium">Đã có điểm</span>
                <h4 class="fw-bold text-success mb-0 mt-1" id="kpiGradedCount">@Model.GradedCount / @Model.TotalStudents</h4>
            </div>
            <div class="rounded-circle bg-success bg-opacity-10 p-2 text-success">
                <i class="bi bi-check2-circle fs-4"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted small fw-medium">ĐTB Bài thi</span>
                <h4 class="fw-bold text-primary mb-0 mt-1">@(Model.AverageScore?.ToString("0.0") ?? "--")</h4>
            </div>
            <div class="rounded-circle bg-info bg-opacity-10 p-2 text-info">
                <i class="bi bi-bar-chart-line fs-4"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted small fw-medium">Hạn nhập điểm</span>
                <div class="mt-1">
                    @if (Model.IsSemesterFinalized)
                    {
                        <span class="badge bg-dark"><i class="bi bi-lock-fill me-1"></i>Học kỳ đã chốt</span>
                    }
                    else if (Model.IsAssessmentLocked)
                    {
                        <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Đã tự động khóa</span>
                    }
                    else
                    {
                        <span class="badge bg-success" title="Hạn chót: @(Model.LockDeadline?.ToString("dd/MM/yyyy HH:mm"))">
                            <i class="bi bi-unlock-fill me-1"></i>Đang mở (Hạn: @(Model.LockDeadline?.ToString("dd/MM") ?? "--"))
                        </span>
                    }
                </div>
            </div>
            <div class="rounded-circle bg-secondary bg-opacity-10 p-2 text-secondary">
                <i class="bi bi-clock-history fs-4"></i>
            </div>
        </div>
    </div>
</div>

<form asp-action="SaveBulk" method="post" id="scoreEntryForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="AssessmentId" value="@Model.AssessmentId" />

    <div class="edu-card p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pb-3 border-bottom">
            <div>
                <h5 class="fw-bold mb-1"><i class="bi bi-table text-primary me-2"></i>Bảng Điểm Chi Tiết</h5>
                <span class="text-muted small">Thang điểm @Model.MinScore.ToString("0.##") - @Model.MaxScore.ToString("0.##"). Dùng phím Tab hoặc Enter để chuyển nhanh giữa các ô.</span>
            </div>

            <!-- Các nút hành động chính -->
            <div class="d-flex align-items-center gap-2">
                @if (Model.CanEdit)
                {
                    @if (!Model.IsStaff && !Model.IsPrincipal)
                    {
                        <button type="submit" class="btn btn-primary px-4 py-2 shadow-sm" id="btnSaveScores">
                            <i class="bi bi-floppy me-1"></i> Lưu Bảng Điểm
                        </button>
                    }
                    else if (Model.IsStaff)
                    {
                        <button type="submit" class="btn btn-warning px-4 py-2 shadow-sm" id="btnStaffSave">
                            <i class="bi bi-shield-check me-1"></i> Lưu Điều Chỉnh Điểm (Giáo vụ)
                        </button>
                    }
                    else if (Model.IsPrincipal)
                    {
                        <button type="submit" class="btn btn-danger px-4 py-2 shadow-sm" id="btnPrincipalSave">
                            <i class="bi bi-shield-lock-fill me-1"></i> Lưu Thay Đổi Điểm (Hiệu trưởng)
                        </button>
                    }
                }
            </div>
        </div>

        @if ((Model.IsStaff || Model.IsPrincipal) && Model.CanEdit)
        {
            <div class="mb-4 bg-light p-3 rounded-3 border" id="staffReasonBox">
                <label for="modifyReason" class="form-label fw-bold text-danger mb-1">
                    <i class="bi bi-exclamation-circle-fill me-1"></i> Lý do điều chỉnh điểm (Bắt buộc ghi nhận kiểm toán & báo cáo BGH):
                </label>
                <div class="input-group">
                    <input type="text" class="form-control" id="modifyReason" name="Reason" maxlength="255" list="reasonOptions"
                           placeholder="Chọn hoặc nhập lý do điều chỉnh: Phúc khảo bài kiểm tra, sửa nhầm điểm..." required />
                    <datalist id="reasonOptions">
                        <option value="Phúc khảo bài kiểm tra"></option>
                        <option value="Giáo viên báo sai sót nhập liệu / cộng nhầm điểm"></option>
                        <option value="Học sinh kiểm tra bù có phép"></option>
                        <option value="Chỉ đạo điều chỉnh từ Ban Giám Hiệu"></option>
                        <option value="Hiệu trưởng điều chỉnh điểm học kỳ đã chốt"></option>
                    </datalist>
                </div>
                <span class="text-muted small">Lý do này sẽ được ghi vào ScoreAuditLog phục vụ thanh tra và tự động gửi thông báo trực tiếp đến Hiệu trưởng.</span>
            </div>
        }

        @if (!Model.Students.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people text-muted fs-1 mb-2 d-block"></i>
                <p class="text-muted mb-0">Chưa có học sinh nào được ghi danh trong lớp học này.</p>
            </div>
        }
        else
        {
            <!-- Thanh gợi ý nhận xét mẫu nhanh -->
            @if (Model.CanEdit)
            {
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3 p-2 bg-light rounded-3 border small">
                    <span class="text-secondary fw-semibold me-1"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Gợi ý nhận xét nhanh:</span>
                    <button type="button" class="btn btn-sm btn-white border quick-comment-btn" data-text="Làm bài tốt, nắm chắc kiến thức">Làm bài tốt</button>
                    <button type="button" class="btn btn-sm btn-white border quick-comment-btn" data-text="Đạt yêu cầu">Đạt yêu cầu</button>
                    <button type="button" class="btn btn-sm btn-white border quick-comment-btn" data-text="Cần cố gắng rèn luyện thêm">Cần cố gắng</button>
                    <button type="button" class="btn btn-sm btn-white border border-danger-subtle text-danger quick-comment-btn" data-text="Vắng kiểm tra (Điểm 0)" data-score="0">Vắng thi (Điểm 0)</button>
                    <span class="text-muted ms-auto fst-italic">(Nhận xét là tùy chọn, không bắt buộc)</span>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tableScores">
                    <thead class="table-light text-secondary small text-uppercase fw-semibold">
                        <tr>
                            <th class="text-center" style="width: 50px;">STT</th>
                            <th style="width: 130px;">Mã Học Sinh</th>
                            <th style="min-width: 190px;">Họ Và Tên</th>
                            <th class="text-center" style="width: 140px;">Điểm (@Model.MinScore.ToString("0.##") - @Model.MaxScore.ToString("0.##"))</th>
                            <th>Nhận Xét (Tùy chọn)</th>
                            <th class="text-center" style="width: 120px;">Trạng Thái</th>
                            <th class="text-center" style="width: 80px;">Lịch Sử</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Students.Count; i++)
                        {
                            var s = Model.Students[i];
                            bool isRowReadOnly = !Model.CanEdit;
                            string scoreVal = s.Score.HasValue ? s.Score.Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) : "";

                            <tr data-row-index="@i">
                                <td class="text-center text-muted fw-medium">@(i + 1)</td>
                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@s.StudentCode</span>
                                    <input type="hidden" name="Scores[@i].StudentId" value="@s.StudentId" />
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark student-name">@s.FullName</span>
                                </td>
                                <td>
                                    <input type="number" 
                                           min="@Model.MinScore.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                           max="@Model.MaxScore.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                                           step="0.1"
                                           class="form-control text-center fw-bold score-input @(s.Score.HasValue && s.Score < 5 ? "text-danger" : (s.Score >= 8 ? "text-primary" : "text-dark"))" 
                                           name="Scores[@i].Score" 
                                           value="@scoreVal"
                                           data-original="@scoreVal"
                                           data-student-index="@i"
                                           placeholder="--"
                                           @(isRowReadOnly ? "readonly disabled" : "") />
                                </td>
                                <td>
                                    <div class="input-group input-group-sm">
                                        <input type="text" 
                                               class="form-control comment-input" 
                                               maxlength="255"
                                               name="Scores[@i].Comment" 
                                               value="@s.Comment" 
                                               data-student-index="@i"
                                               placeholder="Ghi chú kết quả..."
                                               @(isRowReadOnly ? "readonly disabled" : "") />
                                        @if (Model.CanEdit)
                                        {
                                            <button class="btn btn-outline-secondary dropdown-toggle btn-quick-dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Chọn nhanh nhận xét">
                                                <i class="bi bi-chat-quote"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li><h6 class="dropdown-header">Mẫu nhận xét nhanh</h6></li>
                                                <li><a class="dropdown-item item-comment-pick" href="javascript:void(0)" data-text="Làm bài tốt, nắm chắc kiến thức">Làm bài tốt, nắm chắc kiến thức</a></li>
                                                <li><a class="dropdown-item item-comment-pick" href="javascript:void(0)" data-text="Đạt yêu cầu">Đạt yêu cầu</a></li>
                                                <li><a class="dropdown-item item-comment-pick" href="javascript:void(0)" data-text="Cần rèn luyện thêm kỹ năng làm bài">Cần rèn luyện thêm</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item text-danger item-comment-pick" href="javascript:void(0)" data-text="Vắng thi có phép (điểm 0)" data-score="0">Vắng thi có phép (Điểm 0)</a></li>
                                                <li><a class="dropdown-item text-danger item-comment-pick" href="javascript:void(0)" data-text="Vắng thi không phép (điểm 0)" data-score="0">Vắng thi không phép (Điểm 0)</a></li>
                                            </ul>
                                        }
                                    </div>
                                </td>
                                <td class="text-center status-col">
                                    @if (Model.IsSemesterFinalized)
                                    {
                                        <span class="badge bg-dark"><i class="bi bi-lock-fill me-1"></i>Đã chốt sổ</span>
                                    }
                                    else if (s.IsLocked || Model.IsAssessmentLocked)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-lock-fill me-1"></i>Đã khóa</span>
                                    }
                                    else if (s.Score.HasValue)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check me-1"></i>Đã nhập</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Chưa có</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (s.ScoreId.HasValue)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary btn-audit-log" 
                                                data-scoreid="@s.ScoreId.Value" 
                                                data-studentname="@s.FullName"
                                                title="Xem lịch sử điều chỉnh điểm">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">--</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Footer Toolbar -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 mt-3 border-top">
                <span class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i> Sau khi lưu, điểm số sẽ tự động được đồng bộ vào ĐTB môn học kỳ của học sinh.
                </span>
            </div>
        }
    </div>
</form>

<!-- Modal xem lịch sử điều chỉnh điểm (Audit Log) -->
<div class="modal fade" id="auditLogModal" tabindex="-1" aria-labelledby="auditLogModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="auditLogModalLabel">
                    <i class="bi bi-clock-history text-primary me-2"></i>Lịch Sử Điều Chỉnh Điểm: <span id="auditStudentName" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="auditLoading" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="text-muted mt-2 small">Đang tải nhật ký kiểm toán...</p>
                </div>
                <div id="auditEmpty" class="text-center py-4" style="display: none;">
                    <i class="bi bi-file-earmark-check fs-1 text-muted d-block mb-2"></i>
                    <p class="text-muted mb-0">Chưa có lượt điều chỉnh nào được ghi nhận cho cột điểm này.</p>
                </div>
                <div class="table-responsive" id="auditTableWrap" style="display: none;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase">
                            <tr>
                                <th>Thời Gian</th>
                                <th>Người Thực Hiện</th>
                                <th class="text-center">Điểm Cũ</th>
                                <th class="text-center">Điểm Mới</th>
                                <th>Lý Do Điều Chỉnh</th>
                            </tr>
                        </thead>
                        <tbody id="auditTableBody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("scoreEntryForm");
        const scoreInputs = document.querySelectorAll(".score-input");
        const commentInputs = document.querySelectorAll(".comment-input");
        const totalStudents = @Model.TotalStudents;

        // Xử lý nút gợi ý nhận xét mẫu nhanh
        document.querySelectorAll(".quick-comment-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                const text = this.getAttribute("data-text");
                const setScore = this.getAttribute("data-score");
                const activeInput = document.activeElement;
                let tr = activeInput ? activeInput.closest("tr") : null;
                if (!tr) tr = document.querySelector("#tableScores tbody tr");
                if (!tr) return;

                const commentInput = tr.querySelector(".comment-input");
                const scoreInput = tr.querySelector(".score-input");

                if (commentInput) {
                    commentInput.value = text;
                }
                if (setScore !== null && setScore !== undefined && scoreInput) {
                    scoreInput.value = setScore;
                    scoreInput.dispatchEvent(new Event("input"));
                }
                updateKpis();
            });
        });

        // Xử lý nút dropdown nhận xét riêng lẻ từng dòng
        document.querySelectorAll(".item-comment-pick").forEach(item => {
            item.addEventListener("click", function (e) {
                e.preventDefault();
                const text = this.getAttribute("data-text");
                const setScore = this.getAttribute("data-score");
                const tr = this.closest("tr");
                if (!tr) return;

                const commentInput = tr.querySelector(".comment-input");
                const scoreInput = tr.querySelector(".score-input");

                if (commentInput) {
                    commentInput.value = text;
                }
                if (setScore !== null && setScore !== undefined && scoreInput) {
                    scoreInput.value = setScore;
                    scoreInput.dispatchEvent(new Event("input"));
                }
                updateKpis();
            });
        });


                let filledCount = 0;
                document.querySelectorAll("#tableScores tbody tr").forEach(tr => {
                    const sInput = tr.querySelector(".score-input");
                    const cInput = tr.querySelector(".comment-input");
                    if (sInput && (sInput.value.trim() === "" || isNaN(parseFloat(sInput.value)))) {
                        sInput.value = "0";
                        sInput.dispatchEvent(new Event("input"));
                        if (cInput && cInput.value.trim() === "") {
                            cInput.value = "Vắng kiểm tra (Điểm 0)";
                        }
                        filledCount++;
                    }
                });

                updateKpis();
                alert(`Đã điền điểm 0 cho ${filledCount} học sinh chưa có điểm. Vui lòng bấm 'Lưu Bảng Điểm' để hoàn tất.`);
            });
        }

        // Cập nhật KPI số lượng học sinh có điểm
        function updateKpis() {
            let gradedCount = 0;
            scoreInputs.forEach(input => {
                const val = input.value.trim();
                if (val !== "" && !isNaN(parseFloat(val))) {
                    gradedCount++;
                }
            });

            const kpiGraded = document.getElementById("kpiGradedCount");
            if (kpiGraded) kpiGraded.innerText = `${gradedCount} / ${totalStudents}`;
        }

        // Định dạng màu sắc điểm và giới hạn theo cấu hình loại đánh giá
        scoreInputs.forEach((input, index) => {
            input.addEventListener("input", function () {
                const val = parseFloat(this.value);
                if (!isNaN(val)) {
                    if (val < 0) this.value = 0;
                    if (val < @Model.MinScore.ToString(System.Globalization.CultureInfo.InvariantCulture)) this.value = @Model.MinScore.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    if (val > @Model.MaxScore.ToString(System.Globalization.CultureInfo.InvariantCulture)) this.value = @Model.MaxScore.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    
                    this.classList.remove("text-danger", "text-primary", "text-dark");
                    if (val < 5) {
                        this.classList.add("text-danger");
                    } else if (val >= 8) {
                        this.classList.add("text-primary");
                    } else {
                        this.classList.add("text-dark");
                    }
                }
                updateKpis();
            });

            // Enter nhảy xuống ô tiếp theo
            input.addEventListener("keydown", function (e) {
                if (e.key === "Enter") {
                    e.preventDefault();
                    if (index + 1 < scoreInputs.length) {
                        scoreInputs[index + 1].focus();
                        scoreInputs[index + 1].select();
                    }
                }
            });
        });

        // Chuẩn hóa dấu phân cách thập phân trước khi submit
        function normalizeScoreInputs() {
            scoreInputs.forEach(input => {
                if (input.value) {
                    input.value = input.value.trim().replace(",", ".");
                }
            });
        }

        if (form) {
            form.addEventListener("submit", function (e) {
                normalizeScoreInputs();
                const reasonBox = document.getElementById("modifyReason");
                if (reasonBox && reasonBox.required && !reasonBox.value.trim()) {
                    e.preventDefault();
                    alert("Vui lòng nhập lý do điều chỉnh điểm trước khi lưu!");
                    reasonBox.focus();
                    return false;
                }
            });
        }

        // Modal Audit Log
        const auditModalEl = document.getElementById("auditLogModal");
        let auditModal = auditModalEl ? new bootstrap.Modal(auditModalEl) : null;

        document.querySelectorAll(".btn-audit-log").forEach(btn => {
            btn.addEventListener("click", function () {
                const scoreId = this.getAttribute("data-scoreid");
                const studentName = this.getAttribute("data-studentname");

                document.getElementById("auditStudentName").innerText = studentName;
                document.getElementById("auditLoading").style.display = "block";
                document.getElementById("auditEmpty").style.display = "none";
                document.getElementById("auditTableWrap").style.display = "none";
                document.getElementById("auditTableBody").innerHTML = "";

                if (auditModal) auditModal.show();

                fetch(`/Score/AuditLogs?scoreId=${scoreId}`)
                    .then(res => res.json())
                    .then(data => {
                        document.getElementById("auditLoading").style.display = "none";
                        if (data.success && data.data && data.data.length > 0) {
                            const tbody = document.getElementById("auditTableBody");
                            data.data.forEach(item => {
                                const tr = document.createElement("tr");
                                const modifiedDate = new Date(item.modifiedAt).toLocaleString("vi-VN");
                                const oldScore = item.oldScore !== null && item.oldScore !== undefined ? item.oldScore.toFixed(1) : "--";
                                const newScore = item.newScore !== null && item.newScore !== undefined ? item.newScore.toFixed(1) : "--";

                                const values = [modifiedDate, item.modifiedByName || "Hệ thống", oldScore, newScore, item.reason || "Không ghi rõ"];
                                values.forEach(value => {
                                    const cell = document.createElement("td");
                                    cell.className = "small";
                                    cell.textContent = value;
                                    tr.appendChild(cell);
                                });
                                tbody.appendChild(tr);
                            });
                            document.getElementById("auditTableWrap").style.display = "block";
                        } else {
                            document.getElementById("auditEmpty").style.display = "block";
                        }
                    })
                    .catch(err => {
                        document.getElementById("auditLoading").style.display = "none";
                        document.getElementById("auditEmpty").style.display = "block";
                        document.getElementById("auditEmpty").innerHTML = `<p class="text-danger">Lỗi khi tải lịch sử kiểm toán.</p>`;
                    });
            });
        });
    });
</script>
}
