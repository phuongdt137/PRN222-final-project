@{
    ViewData["Title"] = "Bảng Học Tập - Học Sinh";
    var displayName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? "Em Học Sinh";
}

<!-- Greeting Banner kiểu EIMS -->
<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> TRANG CHỦ HỌC SINH
        </span>
        <h1 class="greeting-title">Xin chào, @displayName</h1>
        <p class="greeting-subtitle">
            Học sinh Lớp 10A1 • Mã học sinh: HS-10024 • Năm học 2026 - 2027. Chúc em có một ngày học tập hiệu quả!
        </p>
    </div>
    <div class="live-clock-card">
        <div class="clock-info text-end">
            <div class="clock-date" id="liveClockDate">Đang đồng bộ...</div>
            <div class="clock-time" id="liveClockTime">--:--:--</div>
        </div>
        <div class="clock-icon-box">
            <i class="bi bi-clock"></i>
        </div>
    </div>
</div>

<!-- Section 1: KPI & Chỉ số học tập -->
<div class="dashboard-section-header">
    <div class="section-title-wrap">
        <h2>Chỉ số học tập & Tình hình rèn luyện cá nhân</h2>
        <p>Theo dõi nhanh tiến độ môn học, chuyên cần và kết quả kiểm tra định kỳ của em.</p>
    </div>
    <div class="section-right-meta">
        <i class="bi bi-arrow-repeat me-1"></i>Cập nhật tự động theo thời gian thực
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Card 1: Điểm TB -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-blue">
                <i class="bi bi-mortarboard-fill"></i>
            </span>
            <div class="stat-kicker">KẾT QUẢ HỌC TẬP</div>
            <div class="stat-title">Điểm trung bình (GPA)</div>
            <div class="stat-main">
                <div class="stat-number">8.4</div>
                <div class="stat-label">Xếp loại học lực: <strong>Giỏi</strong></div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-blue">Toán: 8.8</div>
                <div class="breakdown-pill pill-blue">Văn: 8.0</div>
                <div class="breakdown-pill pill-blue">Anh: 8.5</div>
            </div>
        </div>
    </div>

    <!-- Card 2: Lịch học hôm nay -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-green">
                <i class="bi bi-book-half"></i>
            </span>
            <div class="stat-kicker">LỊCH HỌC HÔM NAY</div>
            <div class="stat-title">Tiết học trong ngày</div>
            <div class="stat-main">
                <div class="stat-number">5 tiết</div>
                <div class="stat-label">Lớp 10A1 (Buổi sáng)</div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-green">Xong: 1 tiết</div>
                <div class="breakdown-pill pill-blue">Đang học: 1</div>
                <div class="breakdown-pill pill-yellow">Còn lại: 3</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        @await Component.InvokeAsync("AttendanceDashboard", new { mode = "card" })
    </div>
    <!-- Card 4: Rèn luyện & Hạnh kiểm -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card-eims">
            <span class="stat-icon-badge badge-purple">
                <i class="bi bi-award-fill"></i>
            </span>
            <div class="stat-kicker">RÈN LUYỆN & NỀ NẾP</div>
            <div class="stat-title">Xếp loại hạnh kiểm</div>
            <div class="stat-main">
                <div class="stat-number">Tốt</div>
                <div class="stat-label">Điểm rèn luyện dự kiến: 92/100</div>
            </div>
            <div class="stat-breakdown-bar">
                <div class="breakdown-pill pill-green">Nề nếp: Xuất sắc</div>
                <div class="breakdown-pill pill-blue">Ngoại khóa: Tích cực</div>
            </div>
        </div>
    </div>
</div>

<!-- Section 2: Bảng dữ liệu tác vụ -->
@await Component.InvokeAsync("AttendanceDashboard", new { mode = "table" })

<!-- Table 2: Điểm số gần đây -->
<div class="card-table-wrap">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Kết quả điểm số các bài kiểm tra vừa cập nhật</h2>
            <p class="table-card-subtitle">Điểm số chính thức đã được giáo viên bộ môn ghi nhận vào sổ điểm điện tử.</p>
        </div>
        <span class="table-counter-badge">Gần nhất: 4 bài kiểm tra</span>
    </div>
    <div class="table-responsive">
        <table class="table-edu mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;" class="text-center">STT</th>
                    <th>Môn Học</th>
                    <th>Loại Bài Kiểm Tra</th>
                    <th class="text-center">Hệ Số</th>
                    <th class="text-center">Điểm Số</th>
                    <th>Ngày Công Bố</th>
                    <th>Nhận Xét Của Giáo Viên</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-center">1</td>
                    <td><strong>Toán Đại Số</strong></td>
                    <td>Kiểm tra 15 phút (Đợt 1)</td>
                    <td class="text-center">1</td>
                    <td class="text-center fw-bold text-success" style="font-size: 15px;">9.0</td>
                    <td>16/09/2026</td>
                    <td>Làm bài cẩn thận, trình bày mạch lạc và tư duy tốt.</td>
                </tr>
                <tr>
                    <td class="text-center">2</td>
                    <td><strong>Ngữ Văn</strong></td>
                    <td>Kiểm tra miệng</td>
                    <td class="text-center">1</td>
                    <td class="text-center fw-bold text-success" style="font-size: 15px;">8.5</td>
                    <td>14/09/2026</td>
                    <td>Nắm chắc tác phẩm, trả lời lưu loát tự tin.</td>
                </tr>
                <tr>
                    <td class="text-center">3</td>
                    <td><strong>Tiếng Anh</strong></td>
                    <td>Từ vựng & Ngữ pháp (15 phút)</td>
                    <td class="text-center">1</td>
                    <td class="text-center fw-bold text-success" style="font-size: 15px;">8.0</td>
                    <td>12/09/2026</td>
                    <td>Cần chú ý thêm phần phát âm đuôi ed và s/es.</td>
                </tr>
                <tr>
                    <td class="text-center">4</td>
                    <td><strong>Vật Lý</strong></td>
                    <td>Kiểm tra 15 phút</td>
                    <td class="text-center">1</td>
                    <td class="text-center fw-bold" style="font-size: 15px;">7.5</td>
                    <td>10/09/2026</td>
                    <td>Áp dụng đúng công thức, chú ý đổi đơn vị cẩn thận hơn.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
