@model HighSchoolManagementSystem.MVC.Models.ViewModels.LeaveRequest.LeaveRequestDetailsViewModel
@{
    ViewData["Title"] = $"Đơn nghỉ #{Model.Id}";
    string StatusLabel(string status) => status switch
    {
        "Pending" => "Chờ duyệt",
        "Approved" => "Đã duyệt",
        "Rejected" => "Từ chối",
        "Cancelled" => "Đã hủy",
        _ => status
    };
    string StatusClass(string status) => status switch
    {
        "Pending" => "badge-status-warning",
        "Approved" => "badge-status-success",
        "Rejected" => "badge-status-danger",
        "Cancelled" => "badge-status-info",
        _ => "badge-status-warning"
    };
}

<div class="greeting-banner">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-circle-fill" style="font-size: 7px;"></i> ĐƠN XIN NGHỈ
        </span>
        <h1 class="greeting-title">Chi tiết đơn #@Model.Id</h1>
        <p class="greeting-subtitle">
            @Model.StudentName (@Model.StudentCode)
            @if (!string.IsNullOrWhiteSpace(Model.ClassName))
            {
                <span>· Lớp @Model.ClassName</span>
            }
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="badge-status @StatusClass(Model.Status)">@StatusLabel(Model.Status)</span>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Danh sách
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger d-flex align-items-center mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>@TempData["ErrorMessage"]</div>
    </div>
}

<div class="card-table-wrap mb-3">
    <div class="card-table-header">
        <div>
            <h2 class="table-card-title">Thông tin đơn</h2>
            <p class="table-card-subtitle">Chi tiết khoảng thời gian nghỉ và lý do.</p>
        </div>
    </div>
    <div class="p-4">
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <div class="form-label text-muted mb-1">Học sinh</div>
                <div><strong>@Model.StudentCode</strong> — @Model.StudentName</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="form-label text-muted mb-1">Lớp</div>
                <div>@(Model.ClassName ?? "—")</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="form-label text-muted mb-1">Người gửi</div>
                <div>@Model.RequestedByName</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="form-label text-muted mb-1">Từ ngày</div>
                <div>@Model.StartDate.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="form-label text-muted mb-1">Đến ngày</div>
                <div>@Model.EndDate.ToString("dd/MM/yyyy")</div>
            </div>
            <div class="col-12 col-md-4">
                <div class="form-label text-muted mb-1">Thời gian gửi</div>
                <div>@Model.RequestedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
            </div>
            <div class="col-12">
                <div class="form-label text-muted mb-1">Lý do</div>
                <div>@Model.Reason</div>
            </div>
            <div class="col-12">
                <div class="form-label text-muted mb-1">Minh chứng</div>
                @if (!string.IsNullOrWhiteSpace(Model.Attachment))
                {
                    <a href="@Model.Attachment" target="_blank" rel="noopener">Xem tệp đính kèm</a>
                }
                else
                {
                    <span class="text-muted">Không có</span>
                }
            </div>
        </div>
    </div>
</div>

@if (Model.Status != "Pending")
{
    <div class="card-table-wrap mb-3">
        <div class="card-table-header">
            <div>
                <h2 class="table-card-title">Kết quả duyệt</h2>
                <p class="table-card-subtitle">Thông tin người duyệt và ghi chú.</p>
            </div>
        </div>
        <div class="p-4">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <div class="form-label text-muted mb-1">Người duyệt</div>
                    <div>@(Model.ReviewedByName ?? "—")</div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="form-label text-muted mb-1">Thời điểm</div>
                    <div>@(Model.ReviewAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                </div>
                <div class="col-12">
                    <div class="form-label text-muted mb-1">Ghi chú</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.ReviewNote) ? "—" : Model.ReviewNote)</div>
                </div>
            </div>
        </div>
    </div>
}

@if (Model.CanReview)
{
    <div class="card-table-wrap mb-3">
        <div class="card-table-header">
            <div>
                <h2 class="table-card-title">Duyệt đơn</h2>
                <p class="table-card-subtitle">Staff hoặc GVCN có thể duyệt / từ chối đơn đang chờ.</p>
            </div>
        </div>
        <div class="p-4">
            <form asp-action="Review" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />
                <div class="col-12">
                    <label class="form-label" for="ReviewNote">Ghi chú duyệt (tuỳ chọn)</label>
                    <textarea name="ReviewNote" id="ReviewNote" class="form-control" rows="3"
                              maxlength="500" placeholder="Nhập ghi chú nếu cần..."></textarea>
                </div>
                <div class="col-12 d-flex gap-2 flex-wrap">
                    <button type="submit" name="Approve" value="true" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i>Duyệt đơn
                    </button>
                    <button type="submit" name="Approve" value="false" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-1"></i>Từ chối
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.CanCancel)
{
    <div class="mb-3">
        <form asp-action="Cancel" method="post" onsubmit="return confirm('Bạn chắc chắn muốn hủy đơn này?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-secondary btn-sm">
                <i class="bi bi-trash me-1"></i>Hủy đơn
            </button>
        </form>
    </div>
}
