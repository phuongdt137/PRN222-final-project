@model HighSchoolManagementSystem.Services.DTOs.AttendanceAuditDto
@using System.Text.Json
@using HighSchoolManagementSystem.Models.Entities
@{
    JsonDocument? document = null;
    try { document = JsonDocument.Parse(Model.Details); } catch (JsonException) { }
    var names = ViewData["AttendanceStudentNames"] as Dictionary<int, string>;
    string Value(JsonElement row, string key) => row.TryGetProperty(key, out var value) && value.ValueKind != JsonValueKind.Null ? value.ToString() : "—";
}
@if(document != null)
{
    using(document)
    {
        var root = document.RootElement;
        if(root.TryGetProperty("Before", out var before) && before.ValueKind == JsonValueKind.Array &&
           root.TryGetProperty("After", out var after) && after.ValueKind == JsonValueKind.Array)
        {
            <div class="table-responsive"><table class="table table-sm mt-2">
                <thead><tr><th>Học sinh</th><th>Trước</th><th>Sau</th><th>Ghi chú trước → sau</th><th>Đơn nghỉ trước → sau</th></tr></thead>
                <tbody>
                @foreach(var row in after.EnumerateArray())
                {
                    if(!row.TryGetProperty("StudentId", out var studentId) || !studentId.TryGetInt32(out var id)){ continue; }
                    var old = before.EnumerateArray().FirstOrDefault(r => r.TryGetProperty("StudentId", out var key) && key.TryGetInt32(out var oldId) && oldId == id);
                    if(old.ValueKind == JsonValueKind.Undefined){ continue; }
                    if(Value(old, "Status") == Value(row, "Status") && Value(old, "Comment") == Value(row, "Comment") && Value(old, "LeaveRequestId") == Value(row, "LeaveRequestId")){ continue; }
                    <tr><td>@(names?.GetValueOrDefault(id) ?? $"Học sinh #{id}")</td><td>@AttendanceStatuses.Label(Value(old, "Status"))</td><td>@AttendanceStatuses.Label(Value(row, "Status"))</td><td>@Value(old, "Comment") → @Value(row, "Comment")</td><td>@Value(old, "LeaveRequestId") → @Value(row, "LeaveRequestId")</td></tr>
                }
                </tbody>
            </table></div>
        }
        else if(root.TryGetProperty("Before", out var oldSnapshot) && oldSnapshot.ValueKind == JsonValueKind.Object &&
                root.TryGetProperty("After", out var newSnapshot) && newSnapshot.ValueKind == JsonValueKind.Object)
        {
            var labels = new Dictionary<string, string> { ["Status"] = "Trạng thái", ["ClassId"] = "Mã lớp", ["SubjectId"] = "Mã môn", ["AssignedTeacherId"] = "Mã giáo viên", ["RoomId"] = "Mã phòng", ["TimeSlotId"] = "Mã khung giờ", ["SlotCode"] = "Tiết", ["PeriodNo"] = "Số tiết", ["SchoolSession"] = "Buổi", ["StartTime"] = "Bắt đầu", ["EndTime"] = "Kết thúc", ["Students"] = "Danh sách mã học sinh" };
            <ul>
            @foreach(var field in labels)
            {
                var oldValue = Value(oldSnapshot, field.Key);
                var newValue = Value(newSnapshot, field.Key);
                if(oldValue != newValue){<li>@field.Value: @oldValue → @newValue</li>}
            }
            </ul>
        }
    }
}
