@model HighSchoolManagementSystem.MVC.Models.ViewModels.Subject.CreateSubjectViewModel
@{
    ViewData["Title"] = "Thêm Mới Môn Học";
}

<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-plus-circle-fill me-1"></i> KHỞI TẠO MÔN HỌC • CHƯƠNG TRÌNH ĐÀO TẠO
        </span>
        <h1 class="greeting-title">Thêm Môn Học Mới</h1>
        <p class="greeting-subtitle">
            Nhập các thông tin cấu hình môn học mới, thiết lập hình thức đánh giá (tính điểm hoặc đạt/chưa đạt).
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Index" class="btn btn-secondary px-3 py-2 shadow-sm">
            <i class="bi bi-arrow-left"></i>
            <span>Quay Lại Danh Sách</span>
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="edu-card shadow-sm">
            <div class="edu-card-header">
                <h2 class="edu-card-title">
                    <i class="bi bi-pencil-fill text-primary me-2"></i>Biểu Mẫu Thông Tin Môn Học
                </h2>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="SubjectCode" class="form-label required">Mã môn học <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">
                                <i class="bi bi-tag-fill"></i>
                            </span>
                            <input asp-for="SubjectCode" class="form-control text-uppercase font-monospace fw-bold" 
                                   placeholder="VD: MATH10, LIT11, ENG12..." autofocus />
                        </div>
                        <span asp-validation-for="SubjectCode" class="text-danger small"></span>
                        <div class="form-text small text-muted">
                            Mã định danh duy nhất (không dấu, không khoảng trắng, tự động viết hoa).
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="SubjectName" class="form-label required">Tên môn học <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">
                                <i class="bi bi-book-half"></i>
                            </span>
                            <input asp-for="SubjectName" class="form-control" 
                                   placeholder="VD: Toán Học 10, Ngữ Văn 11..." />
                        </div>
                        <span asp-validation-for="SubjectName" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Hình thức đánh giá môn học <span class="text-danger">*</span></label>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <div class="border rounded-3 p-3 h-100 bg-white shadow-sm position-relative">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="EvaluationType" value="Score" id="evalScore" checked />
                                        <label class="form-check-label fw-bold text-primary" for="evalScore">
                                            <i class="bi bi-calculator me-1"></i> Đánh giá bằng điểm số (0 - 10)
                                        </label>
                                    </div>
                                    <p class="text-muted small mb-0 ps-4 pt-1">
                                        Chấm điểm từ 0 đến 10, tính điểm trung bình môn học kỳ và cả năm học, dùng để tính điểm GPA và xếp loại học sinh (Toán, Văn, Ngoại ngữ, Lý, Hóa, Sinh, Tin...).
                                    </p>
                                </div>
                            </div>

                            <div class="col-12 col-md-6">
                                <div class="border rounded-3 p-3 h-100 bg-white shadow-sm position-relative">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" asp-for="EvaluationType" value="PassFail" id="evalPassFail" />
                                        <label class="form-check-label fw-bold text-success" for="evalPassFail">
                                            <i class="bi bi-check2-circle me-1"></i> Đánh giá bằng nhận xét (Đạt / Chưa đạt)
                                        </label>
                                    </div>
                                    <p class="text-muted small mb-0 ps-4 pt-1">
                                        Đánh giá nhận xét theo 2 mức Đạt (Đ) hoặc Chưa đạt (CĐ), không tính GPA chung (Giáo dục thể chất, Giáo dục Quốc phòng - An ninh, Hoạt động trải nghiệm).
                                    </p>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="EvaluationType" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Mô tả chương trình & định hướng (Tùy chọn)</label>
                        <textarea asp-for="Description" class="form-control" rows="3" 
                                  placeholder="Nhập ghi chú hoặc tóm tắt nội dung chương trình giảng dạy..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch pt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" id="switchIsActive" checked />
                            <label class="form-check-label fw-semibold" for="switchIsActive">
                                Kích hoạt và áp dụng môn học này ngay sau khi tạo
                            </label>
                        </div>
                        <div class="text-muted small ms-4">
                            Khi bật, môn học sẽ ngay lập tức sẵn sàng để phân công giáo viên và lập thời khóa biểu.
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="bi bi-x-circle me-1"></i> Hủy Bỏ
                    </a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Lưu Môn Học
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const nameInput = document.getElementById('SubjectName') || document.querySelector('input[name="SubjectName"]');
            if (nameInput) {
                nameInput.addEventListener('input', function () {
                    const text = this.value.toLowerCase().trim();
                    const passFailKeywords = ['thể chất', 'thể dục', 'quốc phòng', 'trải nghiệm', 'hướng nghiệp', 'gdtc', 'gdqp', 'hdtn'];
                    const isPassFail = passFailKeywords.some(k => text.includes(k));
                    if (isPassFail) {
                        const pfRadio = document.getElementById('evalPassFail');
                        if (pfRadio) pfRadio.checked = true;
                    } else {
                        const scoreKeywords = ['toán', 'văn', 'ngoại ngữ', 'tiếng anh', 'vật lý', 'hóa', 'sinh', 'lịch sử', 'địa lý', 'tin học', 'công nghệ', 'kinh tế', 'pháp luật'];
                        const isScore = scoreKeywords.some(k => text.includes(k));
                        if (isScore) {
                            const scRadio = document.getElementById('evalScore');
                            if (scRadio) scRadio.checked = true;
                        }
                    }
                });
            }
        });
    </script>
}
