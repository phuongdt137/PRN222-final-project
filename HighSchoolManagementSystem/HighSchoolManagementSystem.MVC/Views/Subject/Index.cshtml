@model HighSchoolManagementSystem.MVC.Models.ViewModels.Subject.SubjectListViewModel
@{
    ViewData["Title"] = "Quản Lý Môn Học";
}

<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker">
            <i class="bi bi-journal-bookmark-fill me-1"></i> QUẢN LÝ ĐÀO TẠO • DANH MỤC MÔN HỌC
        </span>
        <h1 class="greeting-title">Danh Sách Môn Học</h1>
        <p class="greeting-subtitle">
            Hệ thống danh mục môn học THPT, thiết lập hình thức đánh giá (tính điểm / đạt-chưa đạt) và quản lý trạng thái áp dụng.
        </p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-primary px-3 py-2 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Thêm Môn Học Mới</span>
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div>@TempData["ErrorMessage"]</div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-semibold">TỔNG SỐ MÔN HỌC</span>
                <span class="fs-4 fw-bold text-dark">@Model.TotalCount</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-primary fs-3">
                <i class="bi bi-journals"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-semibold">ĐANG ÁP DỤNG</span>
                <span class="fs-4 fw-bold text-success">@Model.ActiveCount</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-success fs-3">
                <i class="bi bi-check2-circle"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-semibold">VÔ HIỆU HÓA</span>
                <span class="fs-4 fw-bold text-secondary">@Model.InactiveCount</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-secondary fs-3">
                <i class="bi bi-slash-circle"></i>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="edu-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <span class="text-muted d-block small fw-semibold">TÍNH ĐIỂM SỐ</span>
                <span class="fs-4 fw-bold text-primary">@Model.ScoreCount</span>
                <span class="text-muted small ms-1">(@Model.PassFailCount Đạt/KĐạt)</span>
            </div>
            <div class="p-2 rounded-3 bg-light text-info fs-3">
                <i class="bi bi-calculator"></i>
            </div>
        </div>
    </div>
</div>

<div class="edu-card mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label">Tìm kiếm môn học</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" 
                       placeholder="Nhập mã môn hoặc tên môn học..." />
            </div>
        </div>

        <div class="col-6 col-md-3">
            <label class="form-label">Hình thức đánh giá</label>
            <select name="evaluationType" class="form-select">
                <option value="">-- Tất cả hình thức --</option>
                <option value="Score" selected="@(Model.EvaluationTypeFilter == "Score")">Đánh giá bằng điểm số (0 - 10)</option>
                <option value="PassFail" selected="@(Model.EvaluationTypeFilter == "PassFail")">Đánh giá nhận xét (Đạt / Chưa đạt)</option>
            </select>
        </div>

        <div class="col-6 col-md-2">
            <label class="form-label">Trạng thái</label>
            <select name="status" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Active" selected="@(Model.StatusFilter == "Active")">Đang áp dụng</option>
                <option value="Inactive" selected="@(Model.StatusFilter == "Inactive")">Vô hiệu hóa</option>
            </select>
        </div>

        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">
                <i class="bi bi-funnel-fill"></i> Lọc
            </button>
            <a asp-action="Index" class="btn btn-secondary" title="Đặt lại bộ lọc">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<div class="edu-card p-0 overflow-hidden">
    <div class="edu-card-header px-4 pt-3 pb-2 border-bottom d-flex align-items-center justify-content-between mb-0">
        <h2 class="edu-card-title">
            <i class="bi bi-table me-2 text-primary"></i>Danh Sách Môn Học (@Model.Subjects.Count kết quả)
        </h2>
    </div>

    @if (Model.Subjects.Count == 0)
    {
        <div class="p-5 text-center">
            <div class="text-muted mb-3" style="font-size: 3rem;">
                <i class="bi bi-inbox"></i>
            </div>
            <h5 class="fw-bold text-secondary">Không tìm thấy môn học nào</h5>
            <p class="text-muted small">Hãy thử thay đổi từ khóa tìm kiếm hoặc điều kiện lọc của bạn.</p>
            <a asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Xem tất cả môn học</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-edu m-0">
                <thead>
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th style="width: 140px;">Mã môn</th>
                        <th>Tên môn học</th>
                        <th style="width: 200px;">Hình thức đánh giá</th>
                        <th style="width: 140px;" class="text-center">Phân công</th>
                        <th style="width: 160px;" class="text-center">Trạng thái</th>
                        <th style="width: 180px;" class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int stt = 1; }
                    @foreach (var item in Model.Subjects)
                    {
                        <tr>
                            <td class="text-center text-muted small">@stt</td>
                            <td>
                                <span class="badge bg-light text-primary border px-2 py-1 font-monospace fw-bold">
                                    @item.SubjectCode
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.SubjectName</div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div class="text-muted small text-truncate" style="max-width: 320px;" title="@item.Description">
                                        @item.Description
                                    </div>
                                }
                            </td>
                            <td>
                                @if (item.EvaluationType == "Score")
                                {
                                    <span class="badge-status badge-status-info">
                                        <i class="bi bi-calculator"></i> Điểm số (0 - 10)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status-success">
                                        <i class="bi bi-check2-circle"></i> Đạt / Chưa đạt
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.TotalAssignments > 0)
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1">
                                        <i class="bi bi-people-fill me-1"></i>@item.TotalAssignments lớp
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa gán</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.IsActive)
                                {
                                    <span class="badge-status badge-status-success">
                                        <i class="bi bi-check-circle-fill"></i> Đang áp dụng
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-status-danger">
                                        <i class="bi bi-dash-circle-fill"></i> Vô hiệu hóa
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Details" asp-route-id="@item.Id" 
                                       class="btn btn-secondary px-2" title="Xem chi tiết">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id" 
                                       class="btn btn-secondary px-2" title="Chỉnh sửa môn học">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <button type="button" 
                                            class="btn @(item.IsActive ? "btn-outline-danger" : "btn-outline-success") px-2"
                                            title="@(item.IsActive ? "Vô hiệu hóa môn học" : "Kích hoạt môn học")"
                                            data-bs-toggle="modal" 
                                            data-bs-target="#toggleStatusModal"
                                            data-subject-id="@item.Id"
                                            data-subject-name="@item.SubjectName"
                                            data-subject-code="@item.SubjectCode"
                                            data-is-active="@item.IsActive.ToString().ToLower()">
                                        <i class="bi @(item.IsActive ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        stt++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="modal fade" id="toggleStatusModal" tabindex="-1" aria-labelledby="toggleStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="toggleStatusModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Xác nhận thay đổi trạng thái
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="mb-3" id="toggleModalPrompt">
                    Bạn có chắc chắn muốn thay đổi trạng thái của môn học này không?
                </p>
                <div class="p-3 bg-light rounded-3 border">
                    <div class="fw-bold text-dark" id="modalSubjectName">Môn học</div>
                    <div class="text-muted small font-monospace" id="modalSubjectCode">MATH10</div>
                </div>
                <div class="alert alert-warning mt-3 mb-0 small" id="toggleModalNote">
                    <i class="bi bi-info-circle-fill me-1"></i> Khi vô hiệu hóa, môn học sẽ không hiển thị khi lập lịch và phân công giảng dạy mới.
                </div>
            </div>
            <div class="modal-footer border-top bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                <form id="toggleStatusForm" method="post" asp-action="ToggleStatus">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalSubjectIdInput" value="" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-primary" id="modalSubmitBtn">
                        Xác nhận
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const toggleModal = document.getElementById('toggleStatusModal');
            if (toggleModal) {
                toggleModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-subject-id');
                    const name = button.getAttribute('data-subject-name');
                    const code = button.getAttribute('data-subject-code');
                    const isActive = button.getAttribute('data-is-active') === 'true';

                    document.getElementById('modalSubjectIdInput').value = id;
                    document.getElementById('modalSubjectName').textContent = name;
                    document.getElementById('modalSubjectCode').textContent = 'Mã môn: ' + code;

                    const promptEl = document.getElementById('toggleModalPrompt');
                    const noteEl = document.getElementById('toggleModalNote');
                    const submitBtn = document.getElementById('modalSubmitBtn');

                    if (isActive) {
                        promptEl.innerHTML = `Bạn có chắc chắn muốn <strong>VÔ HIỆU HÓA</strong> môn học này?`;
                        noteEl.innerHTML = `<i class="bi bi-info-circle-fill me-1"></i> Môn học bị vô hiệu hóa sẽ tạm dừng phân công và hiển thị thời khóa biểu mới.`;
                        submitBtn.className = 'btn btn-danger';
                        submitBtn.textContent = 'Vô Hiệu Hóa Môn Học';
                    } else {
                        promptEl.innerHTML = `Bạn có chắc chắn muốn <strong>KÍCH HOẠT</strong> môn học này trở lại?`;
                        noteEl.innerHTML = `<i class="bi bi-info-circle-fill me-1"></i> Môn học sẽ được kích hoạt lại và sẵn sàng cho các công tác đào tạo.`;
                        submitBtn.className = 'btn btn-success';
                        submitBtn.textContent = 'Kích Hoạt Môn Học';
                    }
                });
            }
        });
    </script>
}
