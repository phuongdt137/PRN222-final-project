@model HighSchoolManagementSystem.MVC.Models.ViewModels.UserManagement.UserDetailsViewModel
@{
    ViewData["Title"] = "Chi Tiết Tài Khoản";
}

<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap">
        <span class="greeting-kicker"><i class="bi bi-person-vcard-fill me-1"></i> QUẢN TRỊ HỆ THỐNG • TÀI KHOẢN</span>
        <h1 class="greeting-title">Chi Tiết Tài Khoản</h1>
        <p class="greeting-subtitle">Thông tin hồ sơ và trạng thái truy cập của người dùng.</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary px-3 py-2 shadow-sm"><i class="bi bi-arrow-left"></i><span>Quay Lại Danh Sách</span></a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert"><i class="bi bi-check-circle-fill fs-5"></i><div>@TempData["SuccessMessage"]</div><button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert"><i class="bi bi-exclamation-triangle-fill fs-5"></i><div>@TempData["ErrorMessage"]</div><button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button></div>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="edu-card shadow-sm">
            <div class="edu-card-header d-flex justify-content-between align-items-center">
                <h2 class="edu-card-title"><i class="bi bi-person-badge-fill text-primary me-2"></i>@Model.FullName</h2>
                @if (Model.IsActive) { <span class="badge-status badge-status-success"><i class="bi bi-check-circle-fill"></i> Hoạt động</span> }
                else { <span class="badge-status badge-status-danger"><i class="bi bi-dash-circle-fill"></i> Vô hiệu hóa</span> }
            </div>
            <div class="p-4">
                <div class="row g-4">
                    <div class="col-md-6"><div class="text-muted small mb-1">Tên đăng nhập</div><div class="fw-semibold font-monospace">@@@Model.Username</div></div>
                    <div class="col-md-6"><div class="text-muted small mb-1">Vai trò</div><span class="badge bg-light text-dark border px-2 py-1">@Model.RoleName</span></div>
                    <div class="col-md-6"><div class="text-muted small mb-1">Email</div><div><i class="bi bi-envelope me-1 text-muted"></i>@Model.Email</div></div>
                    <div class="col-md-6"><div class="text-muted small mb-1">Số điện thoại</div><div>@(Model.PhoneNumber ?? "Chưa cập nhật")</div></div>
                    <div class="col-md-6"><div class="text-muted small mb-1">Giới tính</div><div>@(Model.Gender ?? "Chưa cập nhật")</div></div>
                    <div class="col-md-6"><div class="text-muted small mb-1">Ngày sinh</div><div>@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</div></div>
                    <div class="col-md-6"><div class="text-muted small mb-1">Ngày tạo tài khoản</div><div>@Model.CreateAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileDetails))
                    {
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="text-primary fw-semibold small mb-1"><i class="bi bi-info-circle-fill me-1"></i>Thông tin hồ sơ liên kết</div>
                                <div class="fw-medium">@Model.ProfileDetails</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                    <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-secondary px-3"><i class="bi bi-key-fill me-1"></i>Đặt Lại Mật Khẩu</a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info px-3"><i class="bi bi-pencil-square me-1"></i>Chỉnh Sửa</a>
                </div>
            </div>
        </div>
    </div>
</div>
