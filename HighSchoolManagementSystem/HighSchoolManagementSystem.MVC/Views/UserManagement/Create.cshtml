@model HighSchoolManagementSystem.MVC.Models.ViewModels.UserManagement.CreateUserViewModel
@{
    ViewData["Title"] = "Thêm Mới Tài Khoản";
    var roles = ViewBag.Roles as List<HighSchoolManagementSystem.MVC.Models.ViewModels.UserManagement.RoleOptionViewModel> ?? new();
}

<div class="greeting-banner mb-4">
    <div class="greeting-text-wrap"><span class="greeting-kicker"><i class="bi bi-plus-circle-fill me-1"></i> KHỞI TẠO TÀI KHOẢN • QUẢN TRỊ HỆ THỐNG</span><h1 class="greeting-title">Thêm Tài Khoản Mới</h1><p class="greeting-subtitle">Tạo tài khoản người dùng và thiết lập vai trò truy cập ban đầu.</p></div>
    <a asp-action="Index" class="btn btn-secondary px-3 py-2 shadow-sm"><i class="bi bi-arrow-left"></i><span>Quay Lại Danh Sách</span></a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="edu-card shadow-sm">
            <div class="edu-card-header"><h2 class="edu-card-title"><i class="bi bi-person-plus-fill text-primary me-2"></i>Biểu Mẫu Thông Tin Tài Khoản</h2></div>
            <form asp-action="Create" method="post" class="p-4">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
                <div class="row g-3">
                    <div class="col-12 col-md-6"><label asp-for="Username" class="form-label required">Tên đăng nhập <span class="text-danger">*</span></label><div class="input-group"><span class="input-group-text bg-light text-muted"><i class="bi bi-person-fill"></i></span><input asp-for="Username" class="form-control font-monospace" placeholder="VD: nguyen.van.a" autofocus /></div><span asp-validation-for="Username" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="Email" class="form-label required">Email <span class="text-danger">*</span></label><div class="input-group"><span class="input-group-text bg-light text-muted"><i class="bi bi-envelope-fill"></i></span><input asp-for="Email" class="form-control" placeholder="VD: user@highschool.edu.vn" /></div><span asp-validation-for="Email" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="FullName" class="form-label required">Họ và tên <span class="text-danger">*</span></label><input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên người dùng" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="Password" class="form-label required">Mật khẩu <span class="text-danger">*</span></label><input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" /><span asp-validation-for="Password" class="text-danger small"></span></div>
                    <div class="col-12 col-md-6"><label asp-for="PhoneNumber" class="form-label">Số điện thoại</label><input asp-for="PhoneNumber" class="form-control" placeholder="VD: 0901234567" /><span asp-validation-for="PhoneNumber" class="text-danger small"></span></div>
                    <div class="col-6 col-md-3"><label asp-for="Gender" class="form-label">Giới tính</label><select asp-for="Gender" class="form-select"><option value="">-- Chọn --</option><option>Nam</option><option>Nữ</option><option>Khác</option></select></div>
                    <div class="col-6 col-md-3"><label asp-for="DateOfBirth" class="form-label">Ngày sinh</label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                    <div class="col-12 col-md-6"><label asp-for="RoleId" class="form-label required">Vai trò <span class="text-danger">*</span></label><select asp-for="RoleId" class="form-select" id="roleSelect"><option value="">-- Chọn vai trò --</option>@foreach (var role in roles) { <option value="@role.Id" data-role-name="@role.Name">@role.Name</option> }</select><span asp-validation-for="RoleId" class="text-danger small"></span></div>
                    <div class="col-12"><div class="form-check form-switch pt-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label fw-semibold">Kích hoạt tài khoản ngay sau khi tạo</label></div><div class="text-muted small ms-4">Tài khoản bị vô hiệu hóa sẽ không thể đăng nhập hệ thống.</div></div>

                    <!-- THÔNG TIN HỒ SƠ HỌC SINH -->
                    <div id="studentProfileSection" class="col-12 mt-4 pt-3 border-top" style="display: none;">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-mortarboard-fill me-2"></i>Hồ Sơ Học Sinh (Tự động liên kết)</h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="bi bi-magic me-1"></i>Mã HS tự động sinh</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label text-muted">Mã học sinh</label>
                                <input type="text" class="form-control font-monospace bg-light" value="(Hệ thống tự động sinh: VD: HS021)" readonly disabled />
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="AdmissionDate" class="form-label">Ngày nhập học</label>
                                <input asp-for="AdmissionDate" type="date" class="form-control" value="@(Model.AdmissionDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                                <span asp-validation-for="AdmissionDate" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="Address" class="form-label">Địa chỉ</label>
                                <input asp-for="Address" class="form-control" placeholder="VD: Số 123 Đường ABC, Hà Nội" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- THÔNG TIN HỒ SƠ GIÁO VIÊN -->
                    <div id="teacherProfileSection" class="col-12 mt-4 pt-3 border-top" style="display: none;">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-person-workspace me-2"></i>Hồ Sơ Giáo Viên (Tự động liên kết)</h5>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><i class="bi bi-magic me-1"></i>Mã GV tự động sinh</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-3">
                                <label class="form-label text-muted">Mã giáo viên</label>
                                <input type="text" class="form-control font-monospace bg-light" value="(Hệ thống tự động sinh: VD: GV002)" readonly disabled />
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="Specialization" class="form-label">Tổ bộ môn / Chuyên môn</label>
                                <input asp-for="Specialization" class="form-control" placeholder="VD: Tổ Toán, Tổ Tin..." />
                                <span asp-validation-for="Specialization" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="Qualification" class="form-label">Trình độ chuyên môn</label>
                                <input asp-for="Qualification" class="form-control" placeholder="VD: Cử nhân, Thạc sĩ..." />
                                <span asp-validation-for="Qualification" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-3">
                                <label asp-for="MaxPeriodsPerWeek" class="form-label">Số tiết tối đa/tuần</label>
                                <input asp-for="MaxPeriodsPerWeek" type="number" class="form-control" min="1" max="40" value="@(Model.MaxPeriodsPerWeek ?? 20)" />
                                <span asp-validation-for="MaxPeriodsPerWeek" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-4">
                                <label asp-for="HireDate" class="form-label">Ngày tuyển dụng</label>
                                <input asp-for="HireDate" type="date" class="form-control" />
                                <span asp-validation-for="HireDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- THÔNG TIN HỒ SƠ PHỤ HUYNH -->
                    <div id="parentProfileSection" class="col-12 mt-4 pt-3 border-top" style="display: none;">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="fw-bold text-primary mb-0"><i class="bi bi-people-fill me-2"></i>Hồ Sơ Phụ Huynh (Tự động liên kết)</h5>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label asp-for="Occupation" class="form-label">Nghề nghiệp</label>
                                <input asp-for="Occupation" class="form-control" placeholder="VD: Kỹ sư, Bác sĩ, Kinh doanh..." />
                                <span asp-validation-for="Occupation" class="text-danger small"></span>
                            </div>
                            <div class="col-12 col-md-6">
                                <label asp-for="EmergencyContact" class="form-label">Số liên hệ khẩn cấp</label>
                                <input asp-for="EmergencyContact" class="form-control" placeholder="VD: 0987654321" />
                                <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-secondary px-4"><i class="bi bi-x-circle me-1"></i>Hủy Bỏ</a><button type="submit" class="btn btn-primary px-4 shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Lưu Tài Khoản</button></div>
            </form>
        </div>
    </div>
</div>
@section Scripts { 
    <partial name="_ValidationScriptsPartial" /> 
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const roleSelect = document.getElementById('roleSelect');
            const studentSection = document.getElementById('studentProfileSection');
            const teacherSection = document.getElementById('teacherProfileSection');
            const parentSection = document.getElementById('parentProfileSection');

            function toggleProfileSections() {
                if (!roleSelect) return;
                const selectedOption = roleSelect.options[roleSelect.selectedIndex];
                const roleName = selectedOption ? (selectedOption.getAttribute('data-role-name') || '').trim() : '';

                studentSection.style.display = (roleName === 'Student') ? 'block' : 'none';
                teacherSection.style.display = (roleName === 'Teacher') ? 'block' : 'none';
                parentSection.style.display = (roleName === 'Parent') ? 'block' : 'none';
            }

            roleSelect.addEventListener('change', toggleProfileSections);
            toggleProfileSections();
        });
    </script>
}
